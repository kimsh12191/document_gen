{# 기존 hf 생성값과 정답 태깅. 원본 인쇄층은 각 HTML 템플릿에 있다. #}
{{ f.set_corr_name(None) }}
{% for it in d["items"] if it.page == pno and it.t in parent_types %}
{% set valid = namespace(check=true) %}
{% if it.t == "check" %}{% for o in it.options %}
{% if o.box[2] - o.box[0] > 28 or o.box[3] - o.box[1] > 28 %}{% set valid.check = false %}{% endif %}
{% endfor %}{% endif %}
{% if valid.check %}
{% set x0, y0, x1, y1 = it.get("rect") or (0, 0, 0, 0) %}
{% if it.t == "text" %}
<div class="ov {{ it.align }}" style="left:{{ x0 + (it.pad if it.align == 'left' else 0) }}px;top:{{ y0 }}px;width:{{ x1 - x0 - (it.pad if it.align == 'left' else 0) - (3 if it.align == 'right' else 0) }}px;height:{{ y1 - y0 }}px;font-size:{{ it.size }}px">
{%- if it.key %}<span style="{{ it.css|safe }}">{{ f(it.key, value=it.value, label=it.label) }}</span>
{%- else %}<span class="tx" style="{{ it.css|safe }}">{{ it.value or "" }}</span>{% endif %}</div>
{% elif it.t == "hidden" %}
<div class="ov hid" style="left:{{ x0 }}px;top:{{ y0 }}px;width:{{ x1 - x0 }}px;height:{{ y1 - y0 }}px">{{ f(it.key, value=it.value, label=it.label) }}</div>
{% elif it.t == "check" %}
{% for o in it.options %}
{% set b = o.box %}{% set q = o.rect %}
<div class="box" data-box="{{ it.key }}#{{ loop.index0 }}" style="left:{{ b[0] }}px;top:{{ b[1] }}px;width:{{ b[2] - b[0] }}px;height:{{ b[3] - b[1] }}px">
{%- if o.on %}{% set s = (b[3] - b[1]) %}
{%- if d.style.mark == "■" %}<span class="mk fill"></span>
{%- elif d.style.mark == "O" %}<span class="mk ring"></span>
{%- elif d.style.mark == "img" %}<img class="ckimg" src="{{ d.style.mark_img }}" alt="">
{%- else %}{{ checkmark(s, d.style.ink, f.rng) }}{% endif %}
{%- endif %}</div>
<div class="opt" data-opt="{{ it.key }}#{{ loop.index0 }}" style="left:{{ q[0] }}px;top:{{ q[1] }}px;width:{{ q[2] - q[0] }}px;height:{{ q[3] - q[1] }}px">
{%- if o.on %}{{ f(it.key, value=o.text, label=it.label) }}{% endif %}</div>
{% endfor %}
{% if it.selected is none %}{% set u = it.union %}{# 아무것도 체크 안 됨: 보기 묶음 전체가 위치 #}
<div class="ov hid" style="left:{{ u[0] }}px;top:{{ u[1] }}px;width:{{ u[2] - u[0] }}px;height:{{ u[3] - u[1] }}px">{{ f(it.key, value=None, label=it.label) }}</div>
{% endif %}
{{ f.opts(it.key, it.options|map(attribute="text")|list, it.selected, it.label) }}
{% elif it.t == "mark" %}
{% set ks = f.mark(it.key, "seal", it.seal, it.name if it.seal else None, label=it.label, kind="행원인" if it.get("staff") else "인감", render=it.get("render", {}).get("seal")) %}
{% set kg = f.mark(it.key, "signature", it.sign, it.name if it.sign else None, label=it.label, kind="행원인" if it.get("staff") else None, render=it.get("render", {}).get("sign")) %}
{% set tpl = it.get("seal_tpl") %}
{# 찍힌 도장·서명은 그 모양 자체가 위치, 없는 쪽은 자리(div)가 위치 #}
<div class="mark"{% if not it.seal %} data-mark="{{ ks }}"{% endif %}{% if not it.sign %} data-mark2="{{ kg }}"{% endif %} style="left:{{ x0 }}px;top:{{ y0 }}px;width:{{ x1 - x0 }}px;height:{{ y1 - y0 }}px">
{%- if it.seal %}<span class="seal{{ ' sq' if it.get("square") }}" data-mark="{{ ks }}" style="transform:rotate({{ it.rot }}deg)
{%- if it.get("size") %};width:{{ it.size }}px;height:{{ it.size }}px;font-size:{{ (it.size * 0.26)|round(1) }}px{% endif %}
{%- if tpl %};{{ seal_style(tpl) }}{% endif %}">{{ seal_lines(it.name)|join(BR) }}</span>
{%- elif it.sign and it.get("sign_img") %}<span class="scribble fit" data-mark="{{ kg }}"><img src="{{ it.sign_img }}" alt=""></span>
{%- elif it.sign %}<span class="scribble fit" data-mark="{{ kg }}">{{ scribble(it.name, f.rng) }}</span>{% endif %}</div>
{% endif %}
{% endif %}
{% endfor %}
