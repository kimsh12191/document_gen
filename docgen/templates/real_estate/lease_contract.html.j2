{% extends "_base.html.j2" %}
{% import "_macros.html.j2" as m with context %}
{% block page_class %} dense{% endblock %}
{% block style %}
.page.a4.dense { padding: 20px 34px 10px; font-size: 11.5px; line-height: 1.33; }
.lc-title { text-align: center; font-size: 22px; font-weight: 700; letter-spacing: .12em; margin: 0; }
.lc-kind { text-align: center; margin-bottom: 4px; }
.lc-h { font-weight: 700; margin: 5px 0 2px; }
table.lc { margin: 2px 0; border: 1.5px solid var(--border); }
table.lc th { padding: 2px 4px; font-size: 10.2px; }
table.lc td { padding: 1px 5px; }
table.lc th { padding-top: 1px; padding-bottom: 1px; }
.cl { font-size: 9.4px; line-height: 1.28; margin: 2px 0; text-align: justify; }
.cl p { margin: 1px 0; }
.sp { border: 1.5px solid var(--border); padding: 3px 8px; font-size: 10.2px; }
.sp .h { font-weight: 700; }
.fx-box { display: flex; align-items: center; gap: 8px; }
.fx-stamp { border: 2px solid #2a4fa8; color: #2a4fa8; padding: 2px 6px; transform: rotate(-4deg); font-size: 10.5px; line-height: 1.25; text-align: center; opacity: .85; }
.in { color: #333; }
.hand { font-family: 'NanumSquareRound', 'Nanum Gothic', sans-serif; color: #1c2c86; font-weight: 700; display: inline-block; transform: rotate(-0.6deg); font-size: 11px; }
table.lc.bk td { font-size: 9.8px; line-height: 1.2; }
{% endblock %}
{% block content %}
{{ f.set_corr_name(val("tenant.name")) }}
<div class="lc-title">주택임대차표준계약서</div>
<div class="lc-kind">□ 보증금 있는 월세 &nbsp;■ 전세 &nbsp;□ 월세</div>
<div>임대인({{ f("landlord_name", label="임대인") }})과 임차인({{ f("tenant_name", label="임차인") }})은 아래와 같이 임대차 계약을 체결한다</div>
<div class="lc-h">[임차주택의 표시]</div>
<table class="lc">
  <colgroup><col style="width:70px"><col style="width:78px"><col><col style="width:46px"><col style="width:110px"></colgroup>
  <tr><th>소재지</th><td colspan="4">(도로명주소) {{ f("house.location", label="소재지") }}</td></tr>
  <tr><th>토 지</th><th>지목</th><td>{{ f("house.land_category", label="지목") }}</td><th>면적</th><td class="num">{{ f("house.land_area", label="토지면적") }}</td></tr>
  <tr><th>건 물</th><th>구조·용도</th><td>{{ f("house.structure_usage", label="구조·용도") }}</td><th>면적</th><td class="num">{{ f("house.building_area", label="건물면적") }}</td></tr>
  <tr><th>임차할부분</th><td colspan="4">상세주소가 있는 경우 동·층·호 정확히 기재 &nbsp; {{ f("house.lease_part", label="임차할부분") }}</td></tr>
</table>
<table class="lc">
  <colgroup><col style="width:70px"><col></colgroup>
  <tr><th>계약의종류</th><td class="small">{{ m.choice("contract_type", ["신규 계약", "합의에 의한 재계약", "「주택임대차보호법」 제6조의3의 계약갱신요구권 행사에 의한 갱신계약"], label="계약의종류") }}</td></tr>
</table>
<table class="lc">
  <colgroup><col style="width:190px"><col style="width:190px"><col></colgroup>
  <tr><th>미납 국세·지방세</th><th>선순위 확정일자 현황</th><th>확정일자 부여란</th></tr>
  <tr><td class="small">■ {{ f("tax_arrears", label="미납국세·지방세") }} <span class="tiny">(임대인 서명 또는 날인 ㊞)</span><br>□ 있음<span class="tiny">(중개대상물 확인·설명서 제2쪽 Ⅱ.⑨에 기재)</span></td>
      <td class="small">■ {{ f("prior_fixed_date", label="선순위확정일자현황") }} <span class="tiny">(임대인 서명 또는 날인 ㊞)</span><br>□ 있음<span class="tiny">(중개대상물 확인·설명서 제2쪽 Ⅱ.⑨에 기재)</span></td>
      <td><div class="fx-box"><span class="tiny" style="flex:1;line-height:1.2">※ 주택임대차계약서를 제출하고 임대차 신고의 접수를 완료한 경우에는 별도로 확정일자 부여를 신청할 필요가 없습니다.</span>
        <div class="fx-stamp">확정일자 {{ f("fixed_date.date", label="확정일자") }}<br>제 {{ f("fixed_date.no", label="확정일자번호") }} 호<br>{{ f("fixed_date.office", label="확정일자부여기관") }}</div></div></td></tr>
</table>
<div class="lc-h">[계약내용]</div>
<div class="cl" style="font-size:10.2px">제1조(보증금과 차임) 위 부동산의 임대차에 관하여 임대인과 임차인은 합의에 의하여 보증금 및 차임을 아래와 같이 지불하기로 한다.</div>
<table class="lc">
  <colgroup><col style="width:80px"><col></colgroup>
  <tr><th>보증금</th><td><b>{{ f("deposit", label="보증금", fix=0.05) }}</b></td></tr>
  <tr><th>계약금</th><td>{{ f("down_payment", label="계약금", fix=0.05) }} 은 계약시에 지불하고 영수함. <span style="float:right">영수자 (인)</span></td></tr>
  <tr><th>중도금</th><td class="in">금 &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; 원정(₩ &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;)은 &nbsp;&nbsp;&nbsp;&nbsp; 년 &nbsp;&nbsp; 월 &nbsp;&nbsp; 일에 지불하며</td></tr>
  <tr><th>잔 금</th><td>{{ f("balance", label="잔금", fix=0.05) }} 은 {{ f("balance_date", label="잔금지급일", fix=0.05) }}에 지불한다</td></tr>
  <tr><th>차임(월세)</th><td class="in">금 &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; 원정은 매월 &nbsp;&nbsp; 일에 지불한다(입금계좌: &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;)</td></tr>
  <tr><th>관리비</th><td class="small"><span class="in">(정액인 경우) 총액 금 &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; 원정</span><br>(정액이 아닌 경우) 관리비의 항목 및 산정방식: {{ f("management_fee", label="관리비") }}</td></tr>
</table>
<div class="cl">
<p style="font-size:10.2px">제2조(임대차기간) 임대인은 임차주택을 임대차 목적대로 사용·수익할 수 있는 상태로 <b>{{ f("handover_date", label="인도일", fix=0.05) }}</b>까지 임차인에게 인도하고, 임대차기간은 인도일로부터 <b>{{ f("end_date", label="임대차종료일", fix=0.05) }}</b>까지로 한다.</p>
<p>제3조(입주 전 수리) 임대인과 임차인은 임차주택의 수리가 필요한 시설물 및 비용부담에 관하여 다음과 같이 합의한다. (수리 필요 시설: ■ 없음)</p>
<p>제4조(임차주택의 사용·관리·수선) ① 임차인은 임대인의 동의 없이 임차주택의 구조변경 및 전대나 임차권 양도를 할 수 없으며, 주거 이외의 용도로 사용할 수 없다. ② 임대인은 계약 존속 중 임차주택을 사용·수익에 필요한 상태로 유지하여야 한다.</p>
<p>제5조(계약의 해제) 임차인이 임대인에게 중도금(중도금이 없을 때는 잔금)을 지급하기 전까지, 임대인은 계약금의 배액을 상환하고, 임차인은 계약금을 포기하고 이 계약을 해제할 수 있다.</p>
<p>제6조(채무불이행과 손해배상) 당사자 일방이 채무를 이행하지 아니하는 때에는 상대방은 상당한 기간을 정하여 그 이행을 최고하고 계약을 해제할 수 있으며, 그로 인한 손해배상을 청구할 수 있다.</p>
<p>제7조(계약의 해지) ① 임차인은 본인의 과실 없이 임차주택의 일부가 멸실 기타 사유로 사용할 수 없는 경우 계약을 해지할 수 있다. ② 임대인은 임차인이 제4조 제1항을 위반한 경우 계약을 해지할 수 있다.</p>
<p>제8조(갱신요구와 거절) 임차인은 임대차기간이 끝나기 6개월 전부터 2개월 전까지 계약갱신을 요구할 수 있으며, 임대인은 정당한 사유 없이 거절하지 못한다.</p>
<p>제9조(계약의 종료) 임대차계약이 종료된 경우에 임차인은 임차주택을 원래의 상태로 복구하여 임대인에게 반환하고, 이와 동시에 임대인은 보증금을 임차인에게 반환하여야 한다.</p>
<p>제10조(비용의 정산) ① 임차인은 계약종료 시 공과금과 관리비를 정산하여야 한다. ② 임차인은 이미 납부한 관리비 중 장기수선충당금을 소유자에게 반환 청구할 수 있다. 다만, 관리사무소 등 관리주체가 장기수선충당금을 정산하는 경우에는 그 관리주체에게 청구할 수 있다.</p>
<p>제11조(분쟁의 해결) 임대인과 임차인은 본 임대차계약과 관련한 분쟁이 발생하는 경우, 당사자 간의 협의 또는 주택임대차분쟁조정위원회의 조정을 통해 해결하기 위해 노력한다.</p>
<p>제12조(중개보수 등) 중개보수는 관련 법령에 따른 요율 한도 내에서 임대인과 임차인이 각각 부담한다.</p>
<p>제13조(중개대상물확인·설명서 교부) 개업공인중개사는 중개대상물 확인·설명서를 작성하고 업무보증관계증서(공제증서 등) 사본을 첨부하여 임대인과 임차인에게 각각 교부한다.</p>
</div>
<div class="sp">
  <div class="h">[특약사항]</div>
  {% for s in d.specials %}<div>{% if s.hand is defined %}<span class="hand">{{ f("specials." ~ loop.index0, label="특약사항") }}</span>{% else %}{{ f("specials." ~ loop.index0, label="특약사항") }}{% endif %}</div>{% endfor %}
</div>
<div class="small" style="margin:4px 0 2px">본 계약을 증명하기 위하여 계약 당사자가 이의 없음을 확인하고 각각 서명·날인 후 임대인, 임차인, 개업공인중개사는 매 장마다 간인하여, 각각 1통씩 보관한다. <b style="float:right">{{ f("contract_date", label="계약일") }}</b></div>
<table class="lc">
  <colgroup><col style="width:52px"><col style="width:84px"><col style="width:140px"><col style="width:40px"><col style="width:108px"><col style="width:40px"><col></colgroup>
  {% set parties = [("임 대 인", "landlord", "landlord_agent")] + ([("임 대 인", "co_landlord", None)] if d.co_landlord is defined else [])
                 + [("임 차 인", "tenant", None)] %}
  {% set sl = {"landlord": "임대인", "co_landlord": "공동임대인", "tenant": "임차인", "landlord_agent": "임대인대리인"} %}
  {% for role, key, ag in parties %}
  <tr><th rowspan="3">{{ role }}</th><th>주 소</th><td colspan="5">{{ f(key ~ ".address", label="주소") }}</td></tr>
  <tr><th>주민등록번호</th><td class="c">{{ f(key ~ ".rrn", label="주민등록번호") }}</td><th>전 화</th><td class="c">{{ f(key ~ ".phone", label="전화", fix=0.03) }}</td>
      <th>성 명</th><td>{{ f(key ~ ".name", label="성명") }} <span style="float:right" class="small">{{ m.sigspot(key, val(key ~ ".name"), label=sl[key], mark="서명 또는 날인 ㊞") }}</span></td></tr>
  {% if ag and d[ag] is defined %}
  <tr><th>대 리 인</th><td colspan="2" class="small">주소 {{ f(ag ~ ".address", label="대리인주소") }}</td><td colspan="2" class="small">주민등록번호 {{ f(ag ~ ".rrn", label="대리인주민등록번호") }}</td>
      <td class="small">성명 {{ f(ag ~ ".name", label="대리인성명") }} <span style="float:right">{{ m.sigspot(ag, val(ag ~ ".name"), label=sl[ag], mark="㊞") }}</span></td></tr>
  {% else %}
  <tr><th>대 리 인</th><td colspan="2" class="in small">주소</td><td colspan="2" class="in small">주민등록번호</td><td class="in small">성명</td></tr>
  {% endif %}
  {% endfor %}
</table>
<table class="lc bk">
  <colgroup><col style="width:52px"><col style="width:84px"><col><col style="width:84px"><col></colgroup>
  {% set bs = d.brokers %}
  {% macro bcell(i, key, label) %}{% if i < bs|length %}{{ f("brokers." ~ i ~ "." ~ key, label=label) }}{% endif %}{% endmacro %}
  <tr><th rowspan="5">개업<br>공인<br>중개사</th><th>사무소소재지</th><td>{{ bcell(0, "office_address", "사무소소재지") }}</td><th>사무소소재지</th><td>{{ bcell(1, "office_address", "사무소소재지") }}</td></tr>
  <tr><th>사무소명칭</th><td>{{ bcell(0, "office_name", "사무소명칭") }}</td><th>사무소명칭</th><td>{{ bcell(1, "office_name", "사무소명칭") }}</td></tr>
  <tr><th>대 표</th><td>{{ bcell(0, "representative", "대표") }} <span class="small" style="float:right">서명 및 날인 ㊞</span></td><th>대 표</th><td>{{ bcell(1, "representative", "대표") }} <span class="small" style="float:right">서명 및 날인 ㊞</span></td></tr>
  <tr><th>등록번호</th><td>{{ bcell(0, "reg_no", "등록번호") }} <span style="float:right">전화 {{ bcell(0, "phone", "전화") }}</span></td><th>등록번호</th><td>{{ bcell(1, "reg_no", "등록번호") }} <span style="float:right">전화 {{ bcell(1, "phone", "전화") }}</span></td></tr>
  <tr><th>소속공인중개사</th><td>{% if bs[0].assistant is defined %}{{ f("brokers.0.assistant", label="소속공인중개사") }}{% endif %} <span class="small" style="float:right">서명 및 날인 ㊞</span></td><th>소속공인중개사</th><td>{% if bs|length > 1 and bs[1].assistant is defined %}{{ f("brokers.1.assistant", label="소속공인중개사") }}{% endif %} <span class="small" style="float:right">서명 및 날인 ㊞</span></td></tr>
</table>
{% endblock %}
