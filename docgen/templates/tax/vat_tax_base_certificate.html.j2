{% extends "_base.html.j2" %}
{% import "_macros.html.j2" as m with context %}
{# 국세청 민원사무처리규정 [별지 제9호서식] 부가가치세과세표준증명 (과ㆍ면세겸영사업자 포함), 홈택스 발급본 #}
{% block style %}
table.hd { margin: 0; }
table.hd td { border: 0; padding: 2px 4px; font-size: calc(var(--fs) - 1px); vertical-align: bottom; }
table.hd h1 { margin: 0; font-size: calc(var(--title) - 1px); letter-spacing: .12em; text-align: center; white-space: nowrap; }
table.hd .sub { text-align: center; font-size: calc(var(--fs) - 0.5px); }
table.tp { border-top: 2px solid var(--border); border-bottom: 2px solid var(--border); border-left: 0; border-right: 0; }
table.tp th, table.tp td { padding: 6px 7px; }
table.tp tr > :first-child { border-left: 0; } table.tp tr > :last-child { border-right: 0; }
table.tp th.v { writing-mode: vertical-rl; letter-spacing: .4em; padding: 6px 2px; }
table.items th { white-space: normal; line-height: 1.25; font-size: calc(var(--fs) - 1px); padding: 4px 3px; }
table.items td { font-size: calc(var(--fs) - 1px); padding: 5px 4px; }
.cap { font-weight: 700; margin: 12px 0 2px; }
.unit { text-align: right; font-size: calc(var(--fs) - 2px); }
.stmt { text-align: center; margin: 28px 0 0; font-size: calc(var(--fs) + 1px); }
.foot { margin-top: 30px; border-top: 1px solid var(--border); padding-top: 8px; }
.rep-no:not(.pg-repeated) { display: none; }
.rep-no.pg-repeated { margin-bottom: 6px; }
.blank-end { text-align: center; letter-spacing: .3em; font-size: calc(var(--fs) - 1px); margin: 4px 0; }
{% endblock %}
{% block content %}
<div class="docno pg-repeat rep-no">발급번호 : {{ val("issue_no") }}</div>
<div class="gov-head"><span>【국세청 민원사무처리규정 제9호 서식】(2020. 11. 1. 개정)</span><span></span></div>
<table class="hd">
  <colgroup><col style="width:27%"><col><col style="width:18%"></colgroup>
  <tr><td>발급번호<br>{{ f("issue_no", label="발급번호") }}</td>
    <td><h1>부가가치세과세표준증명</h1><div class="sub">(과ㆍ면세겸영사업자 포함)</div></td>
    <td class="right">처리기간<br>즉시</td></tr>
</table>
<table class="tp">
  <colgroup><col style="width:44px"><col style="width:120px"><col><col style="width:140px"><col style="width:170px"></colgroup>
  <tr><th rowspan="4" class="v">납세자</th>
    <th>성명(대표자)</th><td>{{ f("taxpayer.name", label="성명(대표자)") }}</td>
    <th>주민(법인)등록번호</th><td>{{ f("taxpayer.rrn", label="주민(법인)등록번호") }}</td></tr>
  <tr><th>상호(법인명)</th><td>{{ f("taxpayer.trade_name", label="상호(법인명)") }}</td>
    <th>사업자등록번호</th><td>{{ f("taxpayer.biz_no", label="사업자등록번호") }}</td></tr>
  <tr><th>사업장 소재지</th><td colspan="3">{{ f("taxpayer.address", label="사업장소재지") }}</td></tr>
  <tr><th>업　태</th><td>{{ f("taxpayer.biz_type", label="업태") }}</td>
    <th>종　목</th><td>{{ f("taxpayer.biz_item", label="종목") }}</td></tr>
</table>
<div class="between pg-keep-with-next"><div class="cap">신고내용</div><div class="unit">(단위 : 원)</div></div>
<table class="tp items">
  <colgroup><col style="width:24%"><col style="width:11%"><col style="width:11%"><col style="width:14%"><col style="width:13%"><col style="width:13%"><col></colgroup>
  <tr><th rowspan="2">과세기간</th><th rowspan="2">신고구분</th><th rowspan="2">신고일</th>
    <th colspan="3">매출과세표준</th><th rowspan="2">납부할 세액<br>(환급받을 세액)</th></tr>
  <tr><th>계</th><th>과세분</th><th>면세수입금액</th></tr>
  {% for it in d["items"] %}{% set i = loop.index0 %}
  <tr>
    <td class="c">{{ f("items." ~ i ~ ".period", label="과세기간") }}</td>
    <td class="c">{{ f("items." ~ i ~ ".kind", label="신고구분") }}</td>
    <td class="c">{{ f("items." ~ i ~ ".filed", label="신고일") }}</td>
    <td class="num">{{ f("items." ~ i ~ ".base_total", label="매출과세표준계") }}</td>
    <td class="num">{{ f("items." ~ i ~ ".base_taxable", label="과세분") }}</td>
    <td class="num">{{ f("items." ~ i ~ ".base_exempt", label="면세수입금액") }}</td>
    <td class="num">{{ f("items." ~ i ~ ".tax", label="납부할세액(환급받을세액)") }}</td>
  </tr>
  {% endfor %}
</table>
<table class="tp">
  <colgroup><col style="width:164px"><col></colgroup>
  <tr><th>사용목적</th><td>{{ f("purpose", label="사용목적") }}</td></tr>
</table>
<div class="pg-keep">
<p class="stmt">위와 같이 증명합니다.</p>
{{ m.issuer("issue_date", org_path="issuer", seal_text=val("issuer") ~ "인") }}
</div>
<div class="foot note">
  <div>※ 과세표준은 사업자가 신고한 금액이며, 수정신고ㆍ경정 등으로 변경된 경우 변경된 금액으로 표시됩니다.</div>
  <div>※ 이 증명서는 국세청 홈택스(www.hometax.go.kr)에서 인터넷으로 발급되었습니다. 발급번호를 이용하여 홈택스 [민원증명 원본확인] 메뉴에서 진위 여부를 확인할 수 있습니다.</div>
</div>
{% endblock %}
