{% extends "_base.html.j2" %}
{% import "_macros.html.j2" as m with context %}
{% import "bank_form/_account_common.html.j2" as bf with context %}
{% block page_class %} dense{% endblock %}
{% block style %}{{ bf.css() }}
table.fc th { width: 124px; }
table.res th, table.res td { text-align: center; }
table.cat td.opt { line-height: 1.7; }
ol.reason { margin: 2px 0; padding-left: 1.4em; font-size: calc(var(--fs) - 3px); }
ol.reason li { margin: 0; }
{% endblock %}
{% block content %}
{{ f.set_corr_name(val("holder.name")) }}
{{ bf.head("(1-1) FATCA · CRS<br>(보존년한: 최종보고기준일이 속하는 연도 말일로부터 6년)") }}
{{ m.title("본 인 확 인 서", sub="(FATCA · CRS 개인/개인사업자용) Individual Self-Certification") }}
<div class="bf-box bf-note">
  <p>본 확인서는 상호주의에 따른 정기적인 금융정보의 교환을 위한 조세조약의 이행과 관련하여 「국제조세조정에 관한 법률」 및 「정보교환협정에 따른 금융정보자동교환 이행규정」에 따라 작성이 요구되는 필수서식입니다. 계좌보유자가 해외 거주자에 해당하는 경우 관련 금융정보가 국세청을 통하여 해당 국가 과세당국에 제공될 수 있습니다.</p>
  <p class="muted">This form is required under the Law for the Coordination of International Tax Affairs for the automatic exchange of financial account information (FATCA / CRS).</p>
</div>

{{ bf.sec("1", "고객 인적사항", "Personal Information") }}
<table class="bf fc">
<tr><th>성명(한글)<span class="en">Name</span></th><td colspan="3">{{ f("holder.name", label="성명(한글)", fix=0.04) }}</td></tr>
<tr><th>영문 성<span class="en">Last Name (Surname)</span></th><td>{{ f("holder.surname_en", label="영문성", fix=0.03) }}</td>
    <th>영문 이름<span class="en">First Name (Given Name)</span></th><td>{{ f("holder.given_en", label="영문이름", fix=0.03) }}</td></tr>
<tr><th>생년월일<span class="en">Date of Birth</span></th><td>{{ f("holder.birth", label="생년월일", fix=0.05) }}</td>
    <th>연락처<span class="en">Phone No.</span></th><td>{{ f("holder.mobile", label="연락처", fix=0.06) }}</td></tr>
<tr><th>출생국가<span class="en">Country of Birth</span></th><td>{{ f("holder.birth_place", label="출생국가") }}</td>
    <th>국적<span class="en">Nationality</span></th><td>{{ f("holder.nationality", label="국적") }}</td></tr>
<tr><th>현재 거주지 주소<span class="en">Current Residence Address</span></th><td colspan="3">{{ f("holder.address", label="현재거주지주소", fix=0.05) }}</td></tr>
</table>

{{ bf.sec("2", "해외 거주자 여부 확인", "Declaration of Tax Residency") }}
{% set cur = val("residence_category") %}
{% macro opt(o) %}<span class="chk">{% if o == cur %}■ {{ f("residence_category", label="해외거주자여부") }}{% else %}□ {{ o }}{% endif %}</span>{% endmacro %}
{% if cur is none %}{{ f.opts("residence_category", ["미국 시민권자(이중국적자 포함)", "미국 영주권자", "미국 세법상 미국 거주자", "미국 이외의 해외 거주자", "해당사항 없음"], None, "해외거주자여부") }}{{ f("residence_category") }}{% endif %}
<table class="bf cat">
<tr><th style="width:90px">FATCA<span class="en">(미국)</span></th><td class="opt">{{ opt("미국 시민권자(이중국적자 포함)") }} {{ opt("미국 영주권자") }} {{ opt("미국 세법상 미국 거주자") }}</td></tr>
<tr><th>CRS<span class="en">(미국 외)</span></th><td class="opt">{{ opt("미국 이외의 해외 거주자") }} <span class="tiny muted">(대한민국 외 국가의 세법상 거주자)</span></td></tr>
<tr><th>해당 없음</th><td class="opt">{{ opt("해당사항 없음") }} <span class="tiny muted">(대한민국 세법상 거주자로서 위 항목에 해당하지 않는 경우)</span></td></tr>
</table>
<div class="tiny muted">※ 미국 시민권자·영주권자·세법상 미국 거주자는 아래 3에 미국 납세자번호(SSN/ITIN)를 반드시 기재하여 주십시오.</div>

{{ bf.sec("3", "해외 거주자 납세자 정보", "Tax Residence(s) and TIN — 해외 거주자만 작성") }}
<table class="bf res">
<colgroup><col style="width:34px"><col style="width:30%"><col><col style="width:170px"></colgroup>
<tr><th>No</th><th>거주관할권<span class="en">Jurisdiction of Residence</span></th><th>납세자번호<span class="en">TIN</span></th><th>미기재 사유<span class="en">Reason A, B or C</span></th></tr>
{% for r in d.residences %}{% set i = loop.index0 %}
<tr><td>{{ loop.index }}</td><td>{{ f("residences." ~ i ~ ".country", label="거주관할권") }}</td>
<td>{% if r.tin is defined %}{{ f("residences." ~ i ~ ".tin", label="납세자번호", fix=0.05) }}{% endif %}</td>
<td>{% if r.no_tin_reason is defined %}{{ f("residences." ~ i ~ ".no_tin_reason", label="납세자번호미기재사유") }}{% endif %}
  {% if r.reason_detail is defined %}<div class="tiny">({{ f("residences." ~ i ~ ".reason_detail", label="사유B상세") }})</div>{% endif %}</td></tr>
{% endfor %}
{% for _ in range(3 - d.residences|length) %}<tr><td>{{ d.residences|length + loop.index }}</td><td>&nbsp;</td><td></td><td></td></tr>{% endfor %}
</table>
<ol class="reason" type="A">
  <li>거주관할권이 납세자번호를 발급하지 않는 경우 (The jurisdiction does not issue TINs to its residents)</li>
  <li>계좌보유자가 납세자번호를 발급받을 수 없는 경우 — 사유 기재 (The account holder is unable to obtain a TIN — explain)</li>
  <li>거주관할권이 납세자번호 수집을 요구하지 않는 경우 (No TIN is required by the jurisdiction)</li>
</ol>
<div class="tiny muted">※ 세법상 거주지가 미국인 경우 사유 기재와 관계없이 납세자번호를 기재하여야 합니다. 거주관할권이 둘 이상인 경우 모두 기재하여 주십시오.</div>

{{ bf.sec("4", "확인 및 서명", "Declaration and Signature") }}
<div class="bf-box bf-note">
  <p>본인은 위 기재사항이 사실과 다름없음을 확인하며, 기재사항에 변동이 있는 경우 변동일로부터 30일 이내에 은행에 통지하고 새로운 본인확인서를 제출하겠습니다. 본 확인서의 정보는 관련 법령 및 조세조약에 따라 국세청 및 해당 국가 과세당국과 교환될 수 있음을 확인합니다.</p>
  <p class="muted">I certify that the information provided on this form is true, correct and complete, and undertake to notify the bank within 30 days of any change in circumstances.</p>
</div>
<div class="bf-sign">
  <span>작성일 Date&nbsp; {{ f("date", label="작성일") }}</span>
  <span>계좌보유자 Account Holder <span class="who">{{ f("signature", label="계좌보유자") }}</span> {{ m.sigspot("holder", (val("signature")|replace(" ", ""))[:4], mark="(서명 Signature)", p_seal=0.15, p_sign=0.75, label="계좌보유자", anchor="signature") }}</span>
</div>
<div class="right bold">{{ f("bank.name", label="은행명") }} 앞</div>

<div class="bf-use">
  <div class="cap">은행 확인란 (For Bank Use Only)</div>
  <div class="body">
    <table class="bf" style="flex:1">
      <tr><th style="width:96px">접수 영업점</th><td>{{ f("bank_use.branch", label="접수영업점") }}</td></tr>
      <tr><th>합리성 검토</th><td class="tiny">실명확인증표·고객정보와 확인서 기재 내용의 일치 여부 확인 (불일치 시 추가 증빙 징구)</td></tr>
    </table>
    {{ bf.stamps([["담당", "bank_use.clerk"], ["책임자", "bank_use.manager"]]) }}
  </div>
</div>
{{ bf.foot("", "수신-0334 (210×297) 모조 80g") }}
{% endblock %}
