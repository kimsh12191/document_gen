{# 가족관계등록부 증명서 / 주민등록표 공용 조각 (family 그룹 전용) #}

{% macro fam_style() -%}
.fm-form { font-size: calc(var(--fs) - 3px); color: #444; }
h1.title.fm { letter-spacing: .12em; margin: 26px 0 20px; }
table.fm th { background: var(--label-bg); }
table.fm td { text-align: center; }
table.fm td.l { text-align: left; }
.fm-base th { width: 110px; }
.fm-sec { font-weight: 700; margin: 16px 0 2px; letter-spacing: .1em; }
.fm-stmt { text-align: center; margin: 34px 0 6px; font-size: calc(var(--fs) + 1px); }
.fm-meta { font-size: calc(var(--fs) - 1px); margin-top: 26px; line-height: 1.7; }
.fm-meta .l { display: inline-block; width: 90px; }
.fm-foot { position: absolute; left: var(--page-pad); right: var(--page-pad); bottom: calc(var(--page-pad) - 16px); border-top: 1px solid #888; padding-top: 6px; font-size: calc(var(--fs) - 2.5px); color: #333; }
.fm-foot p { margin: 2px 0; }
.fm-close { display: flex; flex-direction: column; }
.fm-foot.flow { position: static; margin-top: 22px; }
.page.a4 { padding-bottom: calc(var(--page-pad) + 52px); }
table.fm .st { margin-left: 6px; font-weight: 700; }
table.fm .nat { display: block; font-size: calc(var(--fs) - 2px); }
{%- endmacro %}

{# 구분/성명/출생연월일/주민등록번호/성별/본 표. paths: 각 행의 경로 리스트 #}
{% macro people(paths) -%}
<table class="fm">
  <colgroup><col style="width:70px"><col style="width:170px"><col style="width:140px"><col><col style="width:50px"><col style="width:66px"></colgroup>
  <tr><th>구분</th><th>성　명</th><th>출생연월일</th><th>주민등록번호</th><th>성별</th><th>본</th></tr>
  {% for pth in paths %}
  <tr>
    <td>{{ f(pth ~ ".relation", label="구분") }}</td>
    <td>{{ f(pth ~ ".name", label="성명") }}{% if f.has(pth ~ ".name_hanja") %}({{ f(pth ~ ".name_hanja", label="성명(한자)") }}){% endif %}{% if f.has(pth ~ ".status") %}<span class="st">{{ f(pth ~ ".status", label="사망") }}</span>{% endif %}{% if f.has(pth ~ ".nationality") %}<span class="nat">국적 : {{ f(pth ~ ".nationality", label="국적") }}</span>{% endif %}</td>
    <td>{{ f(pth ~ ".birth", label="출생연월일") }}</td>
    <td>{% if f.has(pth ~ ".rrn") %}{{ f(pth ~ ".rrn", label="주민등록번호") }}{% endif %}</td>
    <td>{{ f(pth ~ ".gender", label="성별") }}</td>
    <td>{% if f.has(pth ~ ".bon") %}{{ f(pth ~ ".bon", label="본") }}{% endif %}</td>
  </tr>
  {% endfor %}
</table>
{%- endmacro %}

{# 가족관계등록부 증명서 하단: 증명 문구, 발급일, 발급기관, 발급 정보, 안내문 #}
{% macro fam_footer(cert_name, flow=False) -%}
{# 증명문구·발급기관·발급정보는 한 덩어리로 넘긴다 (flex 는 paginate.js 가 쪼개지 않음) #}
<div class="fm-close">
<p class="fm-stmt">위 {{ cert_name }}({{ val("cert_type") }})는 가족관계등록부의 기록사항과 틀림없음을 증명합니다.</p>
<div class="issuer" style="margin-top:14px">
  <div class="date">{{ f("issue_date", label="발급일") }}</div>
  <div class="org"{% if d.doc_check_no is defined %} style="font-size:calc(var(--fs) + 4px);letter-spacing:.06em"{% endif %}>{{ f("issuer", label="발급기관") }}{{ m.seal("전산운영책임관인" if d.doc_check_no is defined else "직인", square=True, over=True) }}</div>
</div>
<div class="fm-meta">
  <div><span class="l">발급시각 :</span>{{ f("issue_time", label="발급시각") }}</div>
  {% if d.officer is defined %}
  <div><span class="l">발급담당자 :</span>{{ f("officer", label="발급담당자") }}</div>
  <div><span class="l">☎ :</span>{{ f("officer_phone", label="전화") }}</div>
  {% endif %}
  <div><span class="l">신청인 :</span>{{ f("applicant", label="신청인") }}</div>
</div>
</div>
<div class="fm-foot{{ ' flow' if flow }}">
  {% if val("cert_type") == "상세" %}
  <p>※ 위 증명서는 「가족관계의 등록 등에 관한 법률」 제15조제3항에 따른 등록사항을 현출한 상세증명서입니다.</p>
  {% else %}
  <p>※ 위 증명서는 「가족관계의 등록 등에 관한 법률」 제15조제2항에 따른 등록사항을 현출한 일반증명서입니다.</p>
  {% endif %}
  {% if d.doc_check_no is defined %}
  <p>※ 이 증명서는 인터넷으로 발급되었으며, 대법원 전자가족관계등록시스템(efamily.scourt.go.kr)에서 문서확인번호로 위·변조 여부를 확인할 수 있습니다.</p>
  <p>문서확인번호 : {{ f("doc_check_no", label="문서확인번호") }}</p>
  {% else %}
  <p>※ 이 증명서는 위·변조 방지를 위하여 특수용지를 사용하였습니다.</p>
  {% endif %}
</div>
{%- endmacro %}

{# 주민등록표 등·초본 상단: 서식 표시, 문서확인번호/발급번호, 제목, 증명문구·담당자·신청인·발급일·발급기관 (실제 발급본은 증명 블록이 표 위에 온다) #}
{% macro resident_style() -%}
.rr-form { font-size: calc(var(--fs) - 3.5px); color: #444; }
.rr-top { display: flex; justify-content: space-between; font-size: calc(var(--fs) - 2px); margin-top: 2px; }
h1.title.rr-t { letter-spacing: .4em; margin: 8px 0 0; }
h1.title.rr-t .sub { letter-spacing: .4em; font-size: calc(var(--fs) + 1px); color: #111; margin-top: 2px; }
.rr-cert { margin: 10px 0 4px; line-height: 1.55; }
.rr-cert .stmt { padding-left: 26px; }
.rr-cert .who { padding-left: 26px; }
.rr-cert .who span.g { display: inline-block; width: 40px; }
.rr-iss { text-align: right; margin: -2px 0 22px; }
.rr-iss .date { letter-spacing: .05em; }
.rr-iss .org { display: inline-block; position: relative; font-size: calc(var(--fs) + 5px); font-weight: 700; letter-spacing: .15em; padding-right: 58px; margin-top: 6px; }
.rr-iss .org .seal { right: -34px; top: -6px; }
table.rr { border-top: 2px solid var(--border); border-bottom: 2px solid var(--border); margin-top: 10px; }
table.rr td { text-align: center; }
table.rr td.nw, table.rr th.nw { white-space: nowrap; }
table.rr td.l { text-align: left; }
table.rr th { font-weight: 600; }
.rr-end { text-align: center; margin: 10px 0 0; letter-spacing: .3em; }
.page.a4 { padding-bottom: calc(var(--page-pad) + 52px); }
.rr-top.pg-repeated { margin-bottom: 8px; }
{%- endmacro %}

{# long: 여러 쪽이 될 수 있는 경우 (쪽 번호는 paginate.js 가 아래에 넣으므로 위의 '1 / 1' 을 뺀다) #}
{% macro resident_head(kind, form_no, stmt, long=False) -%}
<div class="rr-form">■ 주민등록법 시행규칙 [별지 {{ form_no }}] &lt;개정 2019. 11. 19.&gt;</div>
<div class="rr-top pg-repeat">
  <div>{% if d.officer is defined %}발급번호 : {{ f("doc_no", label="발급번호") }}{% else %}문서확인번호 : {{ f("doc_no", label="문서확인번호") }}{% endif %}</div>
  {% if not long %}<div>1 / 1</div>{% endif %}
</div>
<h1 class="title rr-t">주 민 등 록 표<span class="sub">( {{ kind }} )</span></h1>
<div class="rr-cert">
  <div class="stmt">{{ stmt }}</div>
  {% if d.officer is defined %}<div class="who">담당자 : {{ f("officer", label="담당자") }}&nbsp;&nbsp;&nbsp;&nbsp;전화 : {{ f("officer_phone", label="전화") }}</div>{% endif %}
  <div class="who">신 청 인 : {{ f("applicant", label="신청인") }}&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;용도 및 목적 : {{ f("purpose", label="용도및목적") }}</div>
</div>
<div class="rr-iss">
  <div class="date">{{ f("issue_date", label="발급일") }}</div>
  <div class="org">{{ f("issuer", label="발급기관") }}{{ m.seal("직인", square=True, over=True) }}</div>
</div>
{%- endmacro %}

{# 주민등록표 등·초본 하단 #}
{% macro resident_footer() -%}
<p class="rr-end">= 이 하 여 백 =</p>
<div class="fm-foot">
  {% if d.officer is defined %}
  <p>※ 수입증지가 첨부되지 아니한 증명은 그 효력을 보증할 수 없습니다.</p>
  {% else %}
  <p>※ 이 증명서는 인터넷으로 발급되었으며, 정부24(gov.kr)의 인터넷발급문서진위확인 메뉴를 통해 위·변조 여부를 확인할 수 있습니다.(발급일로부터 90일까지) 또한 문서하단의 바코드로 진위확인(정부24 앱 또는 스캐너용 문서확인프로그램)을 하실 수 있습니다.</p>
  {% endif %}
  <p>※ 개인정보 보호를 위하여 주민등록표 등·초본은 필요한 경우에 한하여 제출하시고, 목적 외로 사용하지 마십시오.</p>
</div>
{%- endmacro %}
