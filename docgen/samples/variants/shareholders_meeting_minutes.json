 "chair": "김소윤",
 "agendas": [
  {
   "no": "제1호 의안",
   "title": "제4기(2024년도) 재무제표 승인의 건",
   "body": "의장은 제출된 재무상태표, 손익계산서 및 이익잉여금처분계산서(안)의 내용을 설명하고 그 승인을 물은바, 출석주주 전원의 찬성으로 원안대로 승인 가결하다."
  },
  {
   "no": "제2호 의안",
   "title": "이익배당의 건",
   "body": "의장은 아래와 같이 현금배당을 실시할 것을 제안하고 그 가부를 물은바, 출석주주 의결권의 과반수인 19,064주의 찬성으로 원안대로 승인 가결하다. (주주 노태현 반대)",
   "detail": "배당의 종류 : 현금배당 / 1주당 배당금 : 보통주 100원 / 배당기준일 : 2024.12.31",
   "votes": "찬성 19,064주, 반대 29주"
  },
  {
   "no": "제3호 의안",
   "title": "감사 보수한도 승인의 건",
   "body": "의장은 당해 사업연도 감사 보수한도액을 아래와 같이 정하고자 함을 설명하고 그 승인을 물은바, 출석주주 전원이 이의 없이 찬성하여 원안대로 승인 가결하다.",
   "detail": "감사 보수한도액: 금 일억삼천만원 (₩130,000,000)"
  },
  {
   "no": "제4호 의안",
   "title": "감사 선임의 건",
   "body": "의장은 감사 김채진의 임기 만료로 감사를 선임하여야 함을 설명하고 그 선임을 물은바, 출석주주 전원의 찬성으로 아래 사람을 감사로 선임하다. 피선임자는 즉석에서 취임을 승낙하다.",
   "detail": "감사  김채진 (1975년 8월 18일생)  중임"
  },
  {
   "no": "제5호 의안",
   "title": "이사 보수한도 승인의 건",
   "body": "의장은 당해 사업연도 이사 보수한도액을 아래와 같이 정하고자 함을 설명하고 그 승인을 물은바, 출석주주 전원의 찬성으로 원안대로 승인 가결하다.",
   "detail": "이사 보수한도액: 금 구억원 (₩900,000,000)"
  }
