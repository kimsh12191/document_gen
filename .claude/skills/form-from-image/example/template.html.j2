{% extends "_base.html.j2" %}
{% import "_macros.html.j2" as m with context %}
{% block style %}
.page { padding: 24px 59px 12px; --fs: 12px; --lh: 1.25; }
.head { display: flex; justify-content: space-between; align-items: flex-start; height: 70px; }
.head h1 { font-size: 23px; font-weight: 700; margin: 30px 0 0 70px; letter-spacing: .02em; }
table.staff { border-collapse: collapse; table-layout: fixed; width: 264px; }
table.staff td { border: 1px solid var(--border); text-align: center; font-size: 9px; padding: 0; }
table.staff tr.h td { height: 18px; background: var(--label-bg); }
table.staff tr.b td { height: 46px; }
.to { width: 368px; white-space: nowrap; margin: 22px 0 10px; border-bottom: 1px solid var(--border); padding-bottom: 2px; font-size: 12px; }
.to b { font-size: 16px; }
.to .br { display: inline-block; width: 130px; margin-left: 60px; text-align: right; }
table.f { width: 100%; table-layout: fixed; border-collapse: collapse; }
table.f td, table.f th { border: 1px solid var(--border); padding: 0 6px; font-weight: normal; font-size: 12px; }
table.f th { background: var(--label-bg); text-align: left; }
table.f th.c, table.f td.c { text-align: center; }
table.f th.n { white-space: nowrap; letter-spacing: -.04em; padding: 0 3px; font-size: 11.5px; }
table.f td.r { text-align: right; }
.gray { color: #999; }
.ln { margin: 2px 0; }
.mail { display: inline-block; min-width: 150px; }
.box { border: 1px solid var(--border); padding: 3px 8px; margin-top: 4px; font-size: 10.5px; line-height: 1.32; }
.box ol { margin: 0; padding-left: 16px; }
.req { text-align: center; margin: 6px 0 2px; font-size: 13px; }
.ymd { text-align: center; margin: 6px 0 4px; font-size: 13px; word-spacing: 2px; }
.sec { font-weight: 700; margin: 6px 0 2px; font-size: 13px; }
.foot { display: flex; justify-content: space-between; align-items: flex-end; margin-top: 12px; }
.foot .code { font-size: 7px; line-height: 1.3; }
.foot .logo { font-size: 20px; font-weight: 700; }
{% endblock %}
{% block content %}
<div class="head">
  <h1>예금(신탁) 잔액증명 의뢰서</h1>
  <table class="staff">
    <tr class="h"><td>본인확인</td><td>담당</td><td>책임자</td><td>감사통할</td><td>부점장</td></tr>
    <tr class="b"><td></td><td></td><td></td><td></td><td></td></tr>
  </table>
</div>
<div class="to">주식회사 <b>하나은행</b><span class="br">{{ f("bank.branch", label="지점(부)") }}</span> 지점(부) 앞</div>

<table class="f">
  <colgroup><col style="width:7.3%"><col style="width:12.3%"><col style="width:32.1%"><col style="width:7.5%"><col style="width:6.6%"><col style="width:12.1%"><col style="width:9.1%"><col style="width:13%"></colgroup>
  <tr style="height:32px">
    <th class="c" rowspan="9">신청<br>사항</th>
    <th>신청구분</th>
    <td>{{ m.choice("apply_type", ["등록", "변경", "해제"], label="신청구분") }}</td>
    <th colspan="2">발급기준일</th>
    <td colspan="3">{{ f("base_date", label="발급기준일") }}</td>
  </tr>
  <tr style="height:26px">
    <th class="c" rowspan="4">대상계좌<br>(발급세부)</th>
    <td rowspan="3">{{ m.choice("target_scope", ["지정계좌", "전체계좌"], label="대상계좌") }}<div class="small">※ 전체계좌 선택시 계좌번호 작성 불요</div></td>
    <th class="c" rowspan="3">신청<br>부수</th>
    <th class="c">국문</th>
    <td class="r">{{ f("copies.kor", label="신청부수 국문") }} 매</td>
    <th class="c" rowspan="2">발급부수</th>
    <td class="c gray">전산인자</td>
  </tr>
  <tr style="height:25px">
    <th class="c" rowspan="2">영문</th>
    <td class="r">{{ f("copies.eng", label="신청부수 영문") }} 매</td>
    <td class="c gray">전산인자</td>
  </tr>
  <tr style="height:28px">
    <td colspan="3">(통화코드 : {{ f("currency", label="통화코드") }} )</td>
  </tr>
  <tr style="height:64px">
    <td colspan="6">
      <div class="ln">{{ m.choice("account_mask", ["계좌마스킹(계좌번호 일부숨김)"], label="계좌마스킹") }}&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;□ 발급용도 : {{ f("purpose", label="발급용도") }}</div>
      <div class="ln">□ 수수료 출금계좌 : {{ f("fee_account", label="수수료 출금계좌") }}</div>
      <div class="ln small">&nbsp;&nbsp;&nbsp;※ 잔액증명서 발급에 따른 수수료를 신청계좌에서 무통장ㆍ무인감 출금 처리함에 동의합니다</div>
    </td>
  </tr>
  <tr style="height:30px">
    <th>수령방법</th>
    <td colspan="6">{{ m.choice("receive_method", ["창구수령", "카카오톡(문자)", "E-mail"], label="수령방법") }} : <span class="mail">{{ f("receive_email", label="E-mail") }}</span></td>
  </tr>
  {% set acc = d.accounts or [] %}
  {% for i in range(3) %}
  <tr style="height:26px">
    {% if i == 0 %}<th class="c" rowspan="3">계좌번호</th>{% endif %}
    <td>{% if i < acc|length %}{{ f("accounts." ~ i ~ ".number", label="계좌번호") }}{% endif %}</td>
    {% if i == 0 %}<th class="c" colspan="2" rowspan="3">계좌번호</th>{% endif %}
    <td colspan="3">{% if i + 3 < acc|length %}{{ f("accounts." ~ (i + 3) ~ ".number", label="계좌번호") }}{% endif %}</td>
  </tr>
  {% endfor %}
  <tr style="height:35px">
    <th class="c" rowspan="4">정기<br>발급</th>
    <th>기준일자</th>
    <td>□ 매월 : {{ f("periodic.day", label="기준일자 매월") }} 일</td>
    <th colspan="2">수령방법</th>
    <td colspan="3" class="small">{{ m.choice("periodic.receive_method", ["우편수령", "창구수령", "E-mail"], label="정기발급 수령방법") }} : {{ f("periodic.email", label="정기발급 E-mail") }}</td>
  </tr>
  <tr style="height:30px">
    <th>유효기간</th>
    <td colspan="6">□ &nbsp;{{ f("periodic.start_y", label="유효기간 시작 년") }} 년 {{ f("periodic.start_m", label="유효기간 시작 월") }} 월 {{ f("periodic.start_d", label="유효기간 시작 일") }} 일 ~ {{ f("periodic.end_y", label="유효기간 끝 년") }} 년 {{ f("periodic.end_m", label="유효기간 끝 월") }} 월 {{ f("periodic.end_d", label="유효기간 끝 일") }} 일 &nbsp;<span class="small">※ 최대 3년이하로 설정 가능</span></td>
  </tr>
  <tr style="height:29px">
    <th class="n">창구수령대리인</th>
    <td colspan="6">□ 성명 : <span class="mail">{{ f("pickup_agent.name", label="창구수령대리인 성명") }}</span> □ 생년월일 : <span class="mail">{{ f("pickup_agent.birth", label="창구수령대리인 생년월일") }}</span> □ 관계 : {{ f("pickup_agent.relation", label="창구수령대리인 관계") }}</td>
  </tr>
  <tr style="height:29px">
    <th class="n">우편수령대리인</th>
    <td colspan="6">□ 성명 : <span class="mail">{{ f("mail_agent.name", label="우편수령대리인 성명") }}</span> □ 주소</td>
  </tr>
</table>

<div class="box">&lt; 고객 확인 사항 &gt;
<ol>
  <li>잔액증명서 발급기준일 당일은 예금의 잔액변경 및 대출의 담보로 제공할 수 없으니 각종이체 지정일 여부를 확인하기 바랍니다.</li>
  <li>잔액증명서 발급 시 예금인출 제한내용, 질권설정 등 예금관련 중요사항이 있는 경우에는 동 내용을 모두 표시합니다.</li>
  <li>전체계좌를 신청한 경우 발급기준일 현재 보유하신 계좌에 대하여 잔액증명서를 발급하므로 계좌번호를 작성하지 않으셔도 됩니다.</li>
  <li>정기발급(창구수령)을 신청한 경우 수령지체 또는 교부불능 등으로 은행이 전달하지 못하여 지정일자의 익영업일에 폐기하여도 이의를 제기하지 않으며, 본인이 내점하지 못할경우 상기 수령 대리인에게 교부하여 주시기 바랍니다.</li>
  <li>정기발급(우편수령)을 신청한 경우 발송일 현재 당행에 등록된 주소로 발송되며, 운송중 분실 및 3자수령 등으로 본인이 수령하지 못하여도 이의를 제기하지 않겠습니다. 또한, 주소변동 등으로 1회 이상 우편물이 반송될때에는 발급을 중지하여도 이의를 제기하지 않겠습니다.</li>
  <li>수령방법 E-mail 선택시 본인 E-mail임을 확인합니다.</li>
</ol></div>
<p class="req">귀 은행의 본인(당사) 명의에 대하여 상기와 같이 예금잔액증명서를 발급하여 주시기 바랍니다.</p>
<p class="ymd">{{ f("apply_y", label="신청일 년") }} 년 &nbsp;&nbsp; {{ f("apply_m", label="신청일 월") }} 월 &nbsp;&nbsp; {{ f("apply_d", label="신청일 일") }} 일</p>

<div class="sec">▶ 신청인(고객 확인 사항 동의확인 포함)</div>
<table class="f">
  <colgroup><col style="width:7.3%"><col style="width:13.6%"><col style="width:31.1%"><col style="width:14%"><col style="width:34%"></colgroup>
  <tr style="height:35px">
    <th class="c" rowspan="3">예금주<br>(동의확인)</th>
    <th>성명<br>(상호명)</th>
    <td>{{ f("customer.name", label="성명(상호명)") }} <span style="float:right">{{ m.sigspot("customer", val("customer.name"), mark="(서명/인)", label="예금주") }}</span></td>
    <th>생년월일<br>(사업자번호)</th>
    <td>{{ f("customer.birth", label="생년월일(사업자번호)") }}</td>
  </tr>
  <tr style="height:29px">
    <th>영문명</th><td class="c">{{ f("customer.name_en", label="영문명") }}</td>
    <th>연락처</th><td class="c">{{ f("customer.phone", label="연락처") }}</td>
  </tr>
  <tr style="height:31px">
    <th>주소</th><td colspan="3" class="c">{{ f("customer.address", label="주소") }}</td>
  </tr>
</table>
<div class="small" style="margin:3px 0 4px">※ 영문명은 영문잔액증명서 발급시 기재하며, 주소는 정기발급건 우편수령시 전산등록된 주소로 발송되니 등록된 주소 확인요함</div>
<table class="f">
  <colgroup><col style="width:7.3%"><col style="width:13.6%"><col style="width:31.1%"><col style="width:14%"><col style="width:34%"></colgroup>
  <tr style="height:30px">
    <th class="c" rowspan="4">위임장<br><span class="small">※위임시<br>작성</span></th>
    <th>대리인성명</th><td>{{ f("agent.name", label="대리인성명") }}</td>
    <th>생년월일</th><td>{{ f("agent.birth", label="생년월일") }}</td>
  </tr>
  <tr style="height:30px">
    <th>본인과의 관계</th><td>{{ f("agent.relation", label="본인과의 관계") }}</td>
    <th>연락처</th><td class="c">{{ f("agent.phone", label="연락처") }}</td>
  </tr>
  <tr style="height:31px">
    <th>주소</th><td colspan="3" class="c">{{ f("agent.address", label="주소") }}</td>
  </tr>
  <tr style="height:83px">
    <th>위임인<br>(예금주)</th>
    <td colspan="3">
      <div>본인은 상기 계좌의 ({{ m.choice("delegation_scope", ["잔액증명서 발급", "정기발급 신청"], label="위임 범위") }}) 과 관련한 일체의 행위를 상기 대리인에게 위임합니다.</div>
      <div style="margin:6px 0 2px 260px">위임인 : {{ f("delegator.name", label="위임인") }} <span style="float:right">{{ m.sigspot("delegator", val("delegator.name"), mark="(서명/인)", label="위임인") }}</span></div>
      <div class="small gray">※ 개인은 인감증명서/본인서명사실확인서의 인감/서명, 법인은 법인인감증명서의 법인인감 날인함</div>
    </td>
  </tr>
</table>
<div class="foot">
  <div class="code">5-08-0094(1-1) (2025.01 개정)<br>(보존년한 : 5년)</div>
  <div class="logo">하나은행</div>
</div>
{% endblock %}
