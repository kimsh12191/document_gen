{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:docgen:labeled-package:1",
  "title": "docgen labeled package v1",
  "type": "object",
  "required": [
    "format",
    "name",
    "real_data",
    "gt"
  ],
  "properties": {
    "format": {
      "const": "docgen-labels/1"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "real_data": {
      "type": "boolean"
    },
    "gt": {
      "enum": [
        "exact",
        "pseudo",
        "reviewed"
      ]
    },
    "ocr_scope": {
      "enum": ["full_page", "fields_only_example"]
    }
  }
}
