{% extends "_base.html.j2" %}
{% import "_macros.html.j2" as m with context %}
{% import "bank_form/_loan_parts.html.j2" as lp with context %}
{% import "bank_form/_account_common.html.j2" as bf with context %}
{% import "efinance/_parts.html.j2" as ep with context %}
{% block content %}
{{ ep.css() }}
{{ f.set_corr_name(val("signature")) }}
{% set SERVICES = ["인터넷뱅킹", "모바일뱅킹", "폰뱅킹", "텔레뱅킹", "오픈뱅킹"] %}
{% set MEDIA = ["보안카드", "OTP(카드형)", "OTP(토큰형)", "공동인증서", "금융인증서"] + (["모바일 OTP"] if bk.mobile_otp else []) %}
{{ lp.head(kind="ebank") }}
{{ lp.title_row("개인 전자금융 서비스 신청서") }}
<div style="margin:0 0 4px">{{ lp.legal_name() }} <b>{{ f("branch", label="취급점") }}</b> 앞
&nbsp;&nbsp;신청구분 : {{ m.choice("kind", ["신규", "변경", "해지", "재발급"], label="신청구분") }}{{ lp.nochk("kind") }}</div>

{{ ep.sec(1, "신청인") }}
<table class="bf">
<colgroup><col style="width:130px"><col><col style="width:130px"><col></colgroup>
<tr><th>성　　명</th><td>{{ f("customer.name", label="성명", fix=0.04) }}</td><th>생년월일</th><td>{{ f("customer.birth", label="생년월일", fix=0.05) }}</td></tr>
<tr><th>휴대전화</th><td>{{ f("customer.phone", label="휴대전화", fix=0.06) }}</td><th>이메일주소</th><td>{{ f("customer.email", label="이메일주소", fix=0.05) }}</td></tr>
<tr><th>주　　소</th><td colspan="3">{{ f("customer.address", label="주소", fix=0.04) }}</td></tr>
<tr><th>이용자 ID</th><td>{{ f("user_id", label="이용자ID", fix=0.05) }}</td><th>출금 계좌</th><td>{{ f("account", label="출금계좌", fix=0.08) }}</td></tr>
</table>

{{ ep.sec(2, "신청 서비스") }}
<table class="bf">
<colgroup><col style="width:130px"><col></colgroup>
<tr><th>서비스 종류</th><td>{{ bf.multi("services", SERVICES, label="서비스종류") }}</td></tr>
<tr><th>보안매체</th><td>{{ bf.multi("media", MEDIA, label="보안매체") }}</td></tr>
<tr><th>보안매체 번호</th><td>{{ f("media_no", label="보안매체번호", fix=0.06) }}</td></tr>
</table>

{{ ep.sec(3, "이체한도 신고") }}
{{ ep.limits() }}

{{ ep.sec(4, "부가 서비스") }}
<table class="bf">
<colgroup><col style="width:130px"><col><col style="width:130px"><col></colgroup>
<tr><th>입출금 문자통지</th><td>{{ m.choice("sms_notice", ["신청", "신청하지 않음"], label="입출금문자통지") }}</td>
    <th>해외 IP 차단</th><td>{{ m.choice("overseas_ip", ["차단", "허용"], label="해외IP차단") }}</td></tr>
<tr><th>지연이체 서비스</th><td colspan="3">{{ m.choice("delay_transfer", ["신청", "신청하지 않음"], label="지연이체서비스") }}
<span class="tiny muted">※ 신청 시 이체 실행이 3시간 지연되며, 그 사이 취소할 수 있습니다.</span></td></tr>
</table>

{{ ep.notice() }}

<p class="lead" style="margin:8px 0 4px">위와 같이 전자금융 서비스 이용을 신청하며, 전자금융거래 기본약관을 교부받고 그 내용을 설명 들었습니다.</p>
<div class="center">{{ f("date", label="작성일") }}</div>
<div class="sig">신청인&nbsp;<span class="who">{{ f("signature", label="신청인") }}</span>{{ m.sigspot("applicant", val("signature"), label="신청인", anchor="signature") }}</div>

{{ lp.bank_use(["접수일자", "실명확인", "매체 교부", "담당자", "책임자"]) }}
{% endblock %}
