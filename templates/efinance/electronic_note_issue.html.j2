{% extends "_base.html.j2" %}
{% import "_macros.html.j2" as m with context %}
{% import "bank_form/_loan_parts.html.j2" as lp with context %}
{% import "efinance/_parts.html.j2" as ep with context %}
{% block content %}
{{ ep.css() }}
{{ f.set_corr_name(val("company.ceo")) }}
{{ lp.head(kind="enote") }}
{{ lp.title_row("전자어음 교부 신청서") }}
<div style="margin:0 0 4px">{{ lp.legal_name() }} <b>{{ f("branch", label="취급점") }}</b> 앞
&nbsp;&nbsp;신청구분 : {{ m.choice("kind", ["신규 교부", "한도 증액", "재교부"], label="신청구분") }}{{ lp.nochk("kind") }}</div>

{{ ep.sec(1, "신청 법인") }}
<table class="bf">
<colgroup><col style="width:130px"><col><col style="width:130px"><col></colgroup>
<tr><th>법 인 명</th><td>{{ f("company.name", label="법인명", fix=0.03) }}</td><th>사업자등록번호</th><td>{{ f("company.biz_no", label="사업자등록번호", fix=0.06) }}</td></tr>
<tr><th>법인등록번호</th><td>{{ f("company.corp_no", label="법인등록번호", fix=0.06) }}</td><th>대 표 자</th><td>{{ f("company.ceo", label="대표자", fix=0.04) }}</td></tr>
<tr><th>설 립 일</th><td>{{ f("company.established", label="설립일", fix=0.05) }}</td><th>연 락 처</th><td>{{ f("company.phone", label="연락처", fix=0.06) }}</td></tr>
<tr><th>소 재 지</th><td colspan="3">{{ f("company.address", label="소재지", fix=0.04) }}</td></tr>
</table>

{{ ep.sec(2, "교부 신청 내용") }}
<table class="bf">
<colgroup><col style="width:130px"><col><col style="width:130px"><col></colgroup>
<tr><th>신용등급</th><td>{{ f("credit_grade", label="신용등급") }}</td><th>발행 한도</th><td class="num bold">{{ f("limit", label="발행한도") }}</td></tr>
<tr><th>교부 매수</th><td>{{ f("count", label="교부매수") }}</td><th>만기 제한</th><td>{{ f("term", label="만기제한") }}</td></tr>
<tr><th>결제 계좌</th><td>{{ f("account", label="결제계좌", fix=0.08) }}</td><th>관리기관</th><td>{{ f("registry", label="관리기관") }}</td></tr>
</table>

{{ ep.sec(3, "담당자") }}
<table class="bf">
<colgroup><col style="width:130px"><col><col style="width:130px"><col></colgroup>
<tr><th>담당자 성명</th><td>{{ f("manager.name", label="담당자성명", fix=0.04) }}</td><th>부　　서</th><td>{{ f("manager.department", label="담당자부서") }}</td></tr>
<tr><th>연 락 처</th><td colspan="3">{{ f("manager.phone", label="담당자연락처", fix=0.06) }}</td></tr>
</table>

<div class="notice">
<p>※ 전자어음은 「전자어음의 발행 및 유통에 관한 법률」에 따라 전자어음관리기관에 등록된 경우에만 발행할 수 있습니다.</p>
<p>※ 전자어음의 만기는 발행일부터 1년을 초과할 수 없습니다.</p>
<p>※ 발행 한도는 신용등급·거래실적에 따라 배정되며, 한도 초과 발행은 제한됩니다.</p>
<p>※ 전자어음이 지급 거절되면 당좌거래가 정지되고 어음교환소의 거래정지처분을 받을 수 있습니다.</p>
</div>

<p class="lead" style="margin:8px 0 4px">위와 같이 전자어음의 교부를 신청하며, 전자어음 이용약관에 동의합니다.</p>
<div class="center">{{ f("date", label="작성일") }}</div>
<div class="sig">신청 법인&nbsp;<span class="who">{{ f("signature", label="신청법인") }}</span>{{ m.sigspot("corp", val("company.ceo"), label="법인인감", anchor="signature") }}</div>

{{ lp.bank_use(["접수일자", "법인확인", "한도 배정", "담당자", "책임자"]) }}
{% endblock %}
