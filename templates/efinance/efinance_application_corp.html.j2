{% extends "_base.html.j2" %}
{% import "_macros.html.j2" as m with context %}
{% import "bank_form/_loan_parts.html.j2" as lp with context %}
{% import "bank_form/_account_common.html.j2" as bf with context %}
{% import "efinance/_parts.html.j2" as ep with context %}
{% block content %}
{{ ep.css() }}
{{ f.set_corr_name(val("company.ceo")) }}
{% set SERVICES = ["인터넷뱅킹(기업)", "펌뱅킹", "CMS", "전자어음", "외환업무", "급여이체", "자금관리(CMS Plus)"] %}
{{ lp.head(kind="ebank_corp") }}
{{ lp.cont_head("ebank_corp") }}
{{ lp.title_row("기업 전자금융서비스 신청서", sub="은행용") }}
<div style="margin:0 0 4px">{{ lp.legal_name() }} <b>{{ f("branch", label="취급점") }}</b> 앞
&nbsp;&nbsp;신청구분 : {{ m.choice("kind", ["신규", "변경", "해지"], label="신청구분") }}{{ lp.nochk("kind") }}
&nbsp;&nbsp;계약번호 : {{ f("contract_no", label="계약번호", fix=0.05) }}</div>

{{ ep.sec(1, "신청 법인") }}
<table class="bf">
<colgroup><col style="width:130px"><col><col style="width:130px"><col></colgroup>
<tr><th>법 인 명</th><td>{{ f("company.name", label="법인명", fix=0.03) }}</td><th>사업자등록번호</th><td>{{ f("company.biz_no", label="사업자등록번호", fix=0.06) }}</td></tr>
<tr><th>법인등록번호</th><td>{{ f("company.corp_no", label="법인등록번호", fix=0.06) }}</td><th>대 표 자</th><td>{{ f("company.ceo", label="대표자", fix=0.04) }}</td></tr>
<tr><th>연 락 처</th><td>{{ f("company.phone", label="연락처", fix=0.06) }}</td><th>E-mail</th><td>{{ f("company.email", label="Email", fix=0.05) }}</td></tr>
<tr><th>소 재 지</th><td colspan="3">{{ f("company.address", label="소재지", fix=0.04) }}</td></tr>
</table>

{{ ep.sec(2, "신청 서비스") }}
<table class="bf">
<colgroup><col style="width:130px"><col></colgroup>
<tr><th>서비스 종류</th><td>{{ bf.multi("services", SERVICES, label="서비스종류") }}</td></tr>
<tr><th>대표 출금계좌</th><td>{{ f("account", label="대표출금계좌", fix=0.08) }}</td></tr>
<tr><th>수수료 출금계좌</th><td>{{ f("fee_account", label="수수료출금계좌", fix=0.08) }}</td></tr>
</table>

{{ ep.sec(3, "이용자 등록") }}
{{ m.grid(["성명", "생년월일", "권한", "이용자 ID", "보안매체"], "users",
          ["name", "birth", "role", "user_id", "media"],
          widths=["18%", "18%", "18%", "22%", "24%"], min_rows=1, cls="compact") }}
<table class="bf compact">
<colgroup><col style="width:130px"><col></colgroup>
<tr><th>이체 승인 방식</th><td>{{ m.choice("approval", ["단독 승인", "복수 승인(2인)", "복수 승인(3인)"], label="이체승인방식") }}{{ lp.nochk("approval") }}</td></tr>
</table>

{{ ep.sec(4, "이체한도 신고") }}
{{ ep.limits() }}

{{ ep.notice() }}
<div class="notice">
<p>※ 법인 고객은 이용자별 권한(조회·이체·승인)을 구분하여 등록하여야 하며, 인사이동 시 지체 없이 변경 신고하여야 합니다.</p>
</div>

<p class="lead" style="margin:8px 0 4px">위와 같이 기업 전자금융서비스 이용을 신청하며, 전자금융거래 기본약관 및 기업 전자금융서비스 이용약관에 동의합니다.</p>
<div class="center">{{ f("date", label="작성일") }}</div>
<div class="sig">신청 법인&nbsp;<span class="who">{{ f("signature", label="신청법인") }}</span>{{ m.sigspot("corp", val("company.ceo"), label="법인인감", anchor="signature") }}</div>

{{ lp.bank_use(["접수일자", "법인확인", "매체 교부", "담당자", "책임자"]) }}
{% endblock %}
