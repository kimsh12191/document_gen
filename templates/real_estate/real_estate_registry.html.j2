{% extends "_base.html.j2" %}
{% import "_macros.html.j2" as m with context %}
{% block page_class %} dense{% endblock %}
{% block style %}
.page.a4.dense { padding: 34px 40px; font-size: 11.5px; line-height: 1.3; }
.rg-top { display: flex; justify-content: space-between; font-size: 10.5px; margin-bottom: 2px; }
.rg-title { text-align: center; font-size: 19px; font-weight: 700; letter-spacing: .08em; margin: 2px 0 6px; }
.rg-title .s { font-size: 13px; font-weight: 400; }
.rg-prop { display: flex; justify-content: space-between; border-bottom: 2px solid #000; padding-bottom: 2px; margin-bottom: 4px; font-size: 11.5px; }
.rg-sec { font-weight: 700; margin: 6px 0 1px; font-size: 12px; }
.rg-sec span { font-weight: 400; }
table.rg { margin: 0 0 2px; border-top: 2px solid #000; border-bottom: 1.5px solid #000; }
table.rg th { background: none; border-color: #000; border-width: 1px; padding: 1px 3px; font-size: 11px; font-weight: 600; }
table.rg td { border-color: #000; border-width: 1px; padding: 2px 4px; vertical-align: top; font-size: 11px; line-height: 1.28; }
table.rg tr.x td.strike { text-decoration: line-through; text-decoration-color: #c00; }
.rg-end { text-align: center; margin: 6px 0 4px; letter-spacing: .3em; font-size: 11px; }
.rg-foot { font-size: 10.5px; border-top: 1px solid #000; padding-top: 4px; }
.rg-issuer { text-align: center; margin-top: 8px; font-size: 13px; }
.rg-issuer .o { font-weight: 700; letter-spacing: .05em; position: relative; display: inline-block; padding-right: 48px; }
.rg-mark { position: absolute; left: 50%; top: 52%; transform: translate(-50%, -50%) rotate(-30deg); font-size: 90px; color: rgba(0,0,0,.05); font-weight: 900; letter-spacing: .3em; pointer-events: none; }
{% endblock %}
{% block content %}
{% set viewing = d.view_datetime is defined %}
<div class="rg-top">
  <div>{% if viewing %}[ 열람용 ]{% else %}[ 제출용 ]{% endif %}</div>
  <div>{% if viewing %}열람일시 : {{ f("view_datetime", label="열람일시") }}{% else %}발행번호 {{ f("issue_no", label="발행번호") }}{% endif %}</div>
</div>
<div class="rg-title">등기사항전부증명서(말소사항 포함) <span class="s">- 집합건물 -</span></div>
<div class="rg-prop">
  <div>[집합건물] {{ f("property", label="부동산의표시") }}</div>
  <div style="white-space:nowrap">고유번호 {{ f("unique_no", label="고유번호") }}</div>
</div>

<div class="rg-sec">【 표 제 부 】 <span>( 1동의 건물의 표시 )</span></div>
<table class="rg">
  <colgroup><col style="width:48px"><col style="width:96px"><col style="width:200px"><col><col style="width:130px"></colgroup>
  <tr><th>표시번호</th><th>접 수</th><th>소재지번,건물명칭 및 번호</th><th>건 물 내 역</th><th>등기원인 및 기타사항</th></tr>
  <tr>
    <td class="c">{{ f("building.display_no", label="표시번호") }}</td>
    <td>{{ f("building.receipt", label="접수") }}</td>
    <td>{{ f("building.location", label="소재지번,건물명칭및번호") }}</td>
    <td>{{ f("building.detail", label="건물내역") }}</td>
    <td>{{ f("building.cause", label="등기원인및기타사항") }}</td>
  </tr>
</table>
<div class="rg-sec" style="margin-top:2px"><span>( 대지권의 목적인 토지의 표시 )</span></div>
<table class="rg">
  <colgroup><col style="width:48px"><col><col style="width:60px"><col style="width:100px"><col style="width:130px"></colgroup>
  <tr><th>표시번호</th><th>소 재 지 번</th><th>지 목</th><th>면 적</th><th>등기원인 및 기타사항</th></tr>
  <tr>
    <td class="c">{{ f("land.display_no", label="표시번호") }}</td>
    <td>{{ f("land.location", label="소재지번") }}</td>
    <td class="c">{{ f("land.category", label="지목") }}</td>
    <td class="num">{{ f("land.area", label="면적") }}</td>
    <td>{{ f("land.cause", label="등기원인및기타사항") }}</td>
  </tr>
</table>

<div class="rg-sec">【 표 제 부 】 <span>( 전유부분의 건물의 표시 )</span></div>
<table class="rg">
  <colgroup><col style="width:48px"><col style="width:96px"><col style="width:150px"><col><col style="width:130px"></colgroup>
  <tr><th>표시번호</th><th>접 수</th><th>건 물 번 호</th><th>건 물 내 역</th><th>등기원인 및 기타사항</th></tr>
  <tr>
    <td class="c">{{ f("unit.display_no", label="표시번호") }}</td>
    <td>{{ f("unit.receipt", label="접수") }}</td>
    <td>{{ f("unit.unit_no", label="건물번호") }}</td>
    <td>{{ f("unit.detail", label="건물내역") }}</td>
    <td>{{ f("unit.cause", label="등기원인및기타사항") }}</td>
  </tr>
</table>
<div class="rg-sec" style="margin-top:2px"><span>( 대지권의 표시 )</span></div>
<table class="rg">
  <colgroup><col style="width:48px"><col style="width:150px"><col><col style="width:160px"></colgroup>
  <tr><th>표시번호</th><th>대지권종류</th><th>대지권비율</th><th>등기원인 및 기타사항</th></tr>
  <tr>
    <td class="c">{{ f("land_right.display_no", label="표시번호") }}</td>
    <td>{{ f("land_right.kind", label="대지권종류") }}</td>
    <td class="c">{{ f("land_right.ratio", label="대지권비율") }}</td>
    <td>{{ f("land_right.cause", label="등기원인및기타사항") }}</td>
  </tr>
</table>

<div class="rg-sec">【 갑 구 】 <span>( 소유권에 관한 사항 )</span></div>
<table class="rg">
  <colgroup><col style="width:48px"><col style="width:96px"><col style="width:100px"><col style="width:100px"><col></colgroup>
  <tr><th>순위번호</th><th>등 기 목 적</th><th>접 수</th><th>등 기 원 인</th><th>권리자 및 기타사항</th></tr>
  {% for r in d.gapgu %}{% set i = loop.index0 %}{% set pre = "gapgu." ~ i ~ "." %}
  <tr>
    <td class="c">{{ f(pre ~ "rank", label="순위번호") }}</td>
    <td>{{ f(pre ~ "purpose", label="등기목적") }}</td>
    <td>{{ f(pre ~ "receipt", label="접수") }}</td>
    <td>{% if r.cause is defined %}{{ f(pre ~ "cause", label="등기원인") }}{% endif %}</td>
    <td>{{ f(pre ~ "holder.role", label="권리자구분") }}&nbsp; {{ f(pre ~ "holder.name", label="소유자") }}&nbsp; {{ f(pre ~ "holder.reg_no", label="등록번호") }}<br>
      &nbsp;{{ f(pre ~ "holder.address", label="주소") }}
      {% if r.holder.note is defined %}<br>{{ f(pre ~ "holder.note", label="거래가액") }}{% endif %}</td>
  </tr>
  {% endfor %}
</table>

<div class="rg-sec">【 을 구 】 <span>( 소유권 이외의 권리에 관한 사항 )</span></div>
{% set ns = namespace(gone=[]) %}
{% for r in d.eulgu %}{% if '번근저당권설정등기말소' in r.purpose %}{% set ns.gone = ns.gone + [r.purpose.split('번')[0]] %}{% endif %}{% endfor %}
<table class="rg">
  <colgroup><col style="width:48px"><col style="width:96px"><col style="width:100px"><col style="width:100px"><col></colgroup>
  <tr><th>순위번호</th><th>등 기 목 적</th><th>접 수</th><th>등 기 원 인</th><th>권리자 및 기타사항</th></tr>
  {% for r in d.eulgu %}{% set i = loop.index0 %}{% set pre = "eulgu." ~ i ~ "." %}{% set x = r.rank in ns.gone %}
  <tr class="{{ 'x' if x }}">
    <td class="c strike">{{ f(pre ~ "rank", label="순위번호") }}</td>
    <td class="strike">{{ f(pre ~ "purpose", label="등기목적") }}</td>
    <td class="strike">{{ f(pre ~ "receipt", label="접수") }}</td>
    <td class="strike">{{ f(pre ~ "cause", label="등기원인") }}</td>
    <td class="strike">{% if r.max_amount is defined %}채권최고액 {{ f(pre ~ "max_amount", label="채권최고액") }}<br>
      채무자 {{ f(pre ~ "debtor", label="채무자") }}<br>&nbsp;{{ f(pre ~ "debtor_address", label="채무자주소") }}<br>
      근저당권자 {{ f(pre ~ "mortgagee", label="근저당권자") }}<br>&nbsp;{{ f(pre ~ "mortgagee_address", label="근저당권자주소") }}{% endif %}</td>
  </tr>
  {% else %}
  <tr><td colspan="5" class="c">기록사항 없음</td></tr>
  {% endfor %}
</table>
<div class="rg-end">-- 이 하 여 백 --</div>
<div class="rg-foot">
  <div class="between"><span>관할등기소 {{ f("registry_office", label="관할등기소") }}</span>
  {% if not viewing %}<span>수수료 {{ f("fee", label="수수료") }} 영수함</span>{% endif %}</div>
  <div class="tiny">* 본 등기사항증명서는 {{ '열람용이므로 출력하신 등기사항증명서는 법적인 효력이 없습니다.' if viewing else '등기기록의 내용과 틀림없음을 증명합니다.' }}</div>
  <div class="tiny">* 실선으로 그어진 부분은 말소사항을 표시함. &nbsp;* 기록사항 없는 갑구, 을구는 '기록사항 없음'으로 표시함. &nbsp;* 증명서는 컬러 또는 흑백으로 출력 가능함.</div>
</div>
{% if not viewing %}
<div class="rg-issuer">
  <div>서기 {{ f("issue_date", label="발행일") }}</div>
  <div class="o mt">법원행정처 등기정보중앙관리소 &nbsp;&nbsp;전산운영책임관 <span class="seal square over">전산운영<br>책임관인</span></div>
</div>
{% else %}
<div class="rg-mark">열람용</div>
{% endif %}
{% endblock %}
