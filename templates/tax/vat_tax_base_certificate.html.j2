{% extends "_base.html.j2" %}
{% import "_macros.html.j2" as m with context %}
{% block style %}
.ht-top { display: flex; justify-content: space-between; font-size: calc(var(--fs) - 1px); margin-bottom: 4px; }
.ht-title { border: 2px solid var(--border); text-align: center; padding: 14px 0; margin-bottom: 10px; }
.ht-title h1 { margin: 0; font-size: var(--title); letter-spacing: .2em; }
.cap { font-weight: 700; margin: 14px 0 2px; }
.unit { text-align: right; font-size: calc(var(--fs) - 2px); }
.stmt { text-align: center; margin: 30px 0 0; font-size: calc(var(--fs) + 0.5px); }
.foot { margin-top: 34px; border-top: 1px solid var(--border); padding-top: 8px; }
{% endblock %}
{% block content %}
<div class="ht-top"><span>발급번호 : {{ f("issue_no", label="발급번호") }}</span><span>처리기간 : 즉시</span></div>
<div class="ht-title"><h1>부가가치세 과세표준증명</h1></div>
<div class="cap">□ 납세자 인적사항</div>
{{ m.kv([["상호(법인명)", "taxpayer.trade_name"], ["사업자등록번호", "taxpayer.biz_no"],
         ["성명(대표자)", "taxpayer.name"], ["주민등록번호", "taxpayer.rrn"],
         ["사업장 소재지", "taxpayer.address", True],
         ["업　태", "taxpayer.biz_type"], ["종　목", "taxpayer.biz_item"],
         ["과세유형", "taxpayer.kind"], ["증명기간", "period"]], cols=2, label_w="120px") }}
<div class="between"><div class="cap">□ 신고내용</div><div class="unit">(단위 : 원)</div></div>
{{ m.grid(["과세기간", "신고구분", "신고일", "과세표준", "납부(환급)세액"], "items", ["period", "kind", "filed", "base", "tax"],
          num_cols=[3, 4], widths=["30%", "13%", "15%", "22%", "20%"]) }}
{{ m.kv([["사용목적", "purpose"]], label_w="120px") }}
<p class="stmt">위의 기재사항과 같이 부가가치세 과세표준을 신고하였음을 증명합니다.</p>
{{ m.issuer("issue_date", org_path="issuer", seal_text=val("issuer") ~ "인") }}
<div class="foot note">
  <div>※ 이 증명서는 국세청 홈택스(www.hometax.go.kr)에서 인터넷으로 발급되었습니다.</div>
  <div>※ 과세표준은 사업자가 신고한 금액이며, 수정신고·경정 등으로 변경된 경우 변경된 금액으로 표시됩니다.</div>
  <div>※ 발급일로부터 90일 이내에 홈택스 [민원증명 &gt; 민원증명 원본확인] 메뉴에서 발급번호로 진위 여부를 확인할 수 있습니다.</div>
</div>
{% endblock %}
