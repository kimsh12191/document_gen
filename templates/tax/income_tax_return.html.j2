{% extends "_base.html.j2" %}
{% import "_macros.html.j2" as m with context %}
{# 소득세법 시행규칙 [별지 제40호서식(1)] (35쪽 중 제1쪽) 종합소득세ㆍ농어촌특별세 과세표준확정신고 및 납부계산서 #}
{% block page_class %} dense{% endblock %}
{% block style %}
.itr-title { display: flex; border: 2px solid var(--border); margin: 2px 0 0; }
.itr-title .mg { width: 120px; border-right: 1px solid var(--border); padding: 4px 6px; font-size: calc(var(--fs) - 1px); }
.itr-title .t { flex: 1; text-align: center; padding: 6px 0 5px; }
.itr-title .yr { font-size: calc(var(--fs) + 1px); }
.itr-title h1 { margin: 2px 0 0; font-size: calc(var(--title) - 9px); letter-spacing: .03em; line-height: 1.3; }
.itr-title .res { width: 230px; border-left: 1px solid var(--border); }
.itr-title .res table { margin: 0; height: 100%; }
.itr-title .res th, .itr-title .res td { border-width: 0 0 1px 0; padding: 2px 5px; font-size: calc(var(--fs) - 1.5px); }
.itr-title .res tr:last-child th, .itr-title .res tr:last-child td { border-bottom: 0; }
.itr-title .res th { border-right: 1px solid var(--border); }
.cap { font-weight: 700; margin: 5px 0 1px; }
table { margin: 2px 0; }
th, td { padding: 3px 6px; }
td.opts { font-size: calc(var(--fs) - 1px); line-height: 1.5; }
.opt { white-space: nowrap; margin-right: 8px; }
.opt .cd { font-size: calc(var(--fs) - 2.5px); color: #444; margin-right: 1px; }
table.calc th.l { text-align: left; padding-left: 8px; font-weight: 400; }
table.calc td.num { width: 30%; }
table.calc th, table.calc td { padding-top: 1px; padding-bottom: 1px; }
table.calc tr.hl th, table.calc tr.hl td { font-weight: 700; }
.unit { text-align: right; font-size: calc(var(--fs) - 2px); }
.decl { margin: 5px 4px 1px; line-height: 1.45; }
.sig { text-align: right; margin-top: 1px; }
.to { margin-top: 4px; font-size: calc(var(--fs) + 2px); font-weight: 700; }
{% endblock %}
{% macro opts(path, items, label) -%}
{% set cur = val(path) %}
{% for code, o in items %}<span class="opt"><span class="cd">{{ code }}</span>{% if o == cur %}[√] {{ f(path, label=label) }}{% else %}[ ] {{ o }}{% endif %}</span>{% endfor %}
{%- endmacro %}
{% block content %}
{% set rev = {"2023": "2023. 3. 20.", "2024": "2024. 3. 22.", "2025": "2025. 3. 21.", "2026": "2026. 3. 20."}.get(val("filed_date")[:4]) %}
<div class="gov-head"><span>■ 소득세법 시행규칙 [별지 제40호서식(1)]{% if rev %} &lt;개정 {{ rev }}&gt;{% endif %}</span><span>(35쪽 중 제1쪽)</span></div>
<div class="itr-title">
  <div class="mg">관리번호<br>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;-</div>
  <div class="t">
    <div class="yr">( {{ f("tax_year", label="귀속연도") }} 년귀속)</div>
    <h1>종합소득세ㆍ농어촌특별세<br>과세표준확정신고 및 납부계산서</h1>
  </div>
  <div class="res"><table>
    <tr><th>거주구분</th><td>{{ m.choice("residency", ["거주자", "비거주자"], label="거주구분", on="[√]", off="[ ]") }}</td></tr>
    <tr><th>내ㆍ외국인</th><td>{{ m.choice("nationality", ["내국인", "외국인"], label="내ㆍ외국인", on="[√]", off="[ ]") }}</td></tr>
    <tr><th>거주지국</th><td>대한민국 &nbsp;코드 KR</td></tr>
  </table></div>
</div>
<div class="cap">❶ 기본사항</div>
<table class="outer">
  <colgroup><col style="width:124px"><col><col style="width:124px"><col style="width:200px"></colgroup>
  <tr><th>① 성　　명</th><td>{{ f("taxpayer.name", label="성명") }}</td><th>② 주민등록번호</th><td>{{ f("taxpayer.rrn", label="주민등록번호") }}</td></tr>
  <tr><th>③ 주　　소</th><td colspan="3">{{ f("taxpayer.address", label="주소") }}</td></tr>
  <tr><th>④ 전자우편주소</th><td>{{ f("taxpayer.email", label="전자우편주소") }}</td><th>⑤ 주소지 전화번호</th><td>&nbsp;</td></tr>
  <tr><th>⑥ 사업장 전화번호</th><td>{{ f("taxpayer.biz_phone", label="사업장전화번호") }}</td><th>⑦ 휴대전화번호</th><td>{{ f("taxpayer.mobile", label="휴대전화번호") }}</td></tr>
  <tr><th>⑧ 신 고 유 형</th><td colspan="3" class="opts">{{ opts("filing_type", [["11", "자기조정"], ["12", "외부조정"], ["20", "성실신고확인"], ["31", "간편장부"], ["32", "추계-기준율"], ["33", "추계-단순율"], ["40", "비사업자"]], "신고유형") }}</td></tr>
  <tr><th>⑨ 기 장 의 무</th><td colspan="3" class="opts">{{ opts("bookkeeping", [["1", "복식부기의무자"], ["2", "간편장부대상자"], ["3", "비사업자"]], "기장의무") }}</td></tr>
  <tr><th>⑩ 신 고 구 분</th><td colspan="3" class="opts">{{ opts("filing_kind", [["10", "정기신고"], ["20", "수정신고"], ["30", "경정청구"], ["40", "기한후신고"], ["60", "추가신고(인정상여)"]], "신고구분") }}</td></tr>
</table>
<div class="cap">❷ 환급금 계좌신고</div>
<table class="outer">
  <colgroup><col style="width:124px"><col><col style="width:124px"><col style="width:200px"></colgroup>
  <tr><th>⑪ 금융기관/<br>체신관서명</th><td>{% if d.refund_account is defined %}{{ f("refund_account.bank", label="금융기관/체신관서명") }}{% endif %}</td>
    <th>⑫ 계좌번호</th><td>{% if d.refund_account is defined %}{{ f("refund_account.number", label="계좌번호") }}{% endif %}</td></tr>
</table>
<div class="between"><div class="cap">❸ 세액의 계산</div><div class="unit">(단위 : 원)</div></div>
{% set rows = [
  ["종합소득금액", "⑲", "total_income", False],
  ["소득공제", "⑳", "deduction", False],
  ["과세표준 (⑲-⑳)", "㉑", "base", True],
  ["세율", "㉒", "rate", False],
  ["산출세액", "㉓", "computed", True],
  ["세액감면", "㉔", "reduction", False],
  ["세액공제", "㉕", "credit", False],
  ["결정세액 (㉓-㉔-㉕)", "㉖", "determined", True],
  ["가산세", "㉗", "penalty", False],
  ["추가납부세액 (농어촌특별세의 경우에는 환급세액)", "㉘", "additional", False],
  ["합계 (㉖+㉗+㉘)", "㉙", "total", False],
  ["기납부세액", "㉚", "prepaid", False],
  ["납부(환급)할 총세액 (㉙-㉚)", "㉛", "payable", True],
  ["납부특례세액 차감", "㉜", "special_deduct", False],
  ["납부특례세액 가산", "㉝", "special_add", False],
  ["분납할 세액 (2개월 이내)", "㉞", "installment", False],
  ["신고기한 이내 납부할 세액 (㉛-㉜+㉝-㉞)", "㉟", "due_payable", True],
] %}
<table class="calc outer">
  <colgroup><col><col style="width:36px"><col style="width:30%"><col style="width:22%"></colgroup>
  <tr><th>구　　분</th><th></th><th>종합소득세</th><th>농어촌특별세</th></tr>
  {% for label, no, key, hl in rows %}
  <tr{% if hl %} class="hl"{% endif %}><th class="l">{{ label }}</th><td class="c">{{ no }}</td>
    <td class="num">{{ f("national." ~ key, label=label.split(" (")[0]) }}</td><td></td></tr>
  {% endfor %}
</table>
<p class="decl">신고인은 「소득세법」 제70조, 「농어촌특별세법」 제7조, 「국세기본법」 제45조, 제45조의2, 제45조의3에 따라 위의 내용을 신고하며, 위 내용을 충분히 검토하였고 신고인이 알고 있는 사실 그대로를 정확하게 적었음을 확인합니다.</p>
<div class="sig">{{ f("filed_date", label="신고일") }}</div>
<div class="sig">신고인&nbsp;&nbsp;<span class="signline" style="min-width:90px">{{ f("taxpayer.name", label="신고인") }}</span>&nbsp;&nbsp;{{ m.sigspot("taxpayer", val("taxpayer.name"), label="신고인", anchor="taxpayer.name", p_seal=0.3, p_sign=0.3) }}</div>
<p class="decl" style="margin-top:4px">세무대리인은 조세전문자격자로서 위 신고서를 성실하고 공정하게 작성하였음을 확인합니다.</p>
<div class="sig">세무대리인&nbsp;&nbsp;<span class="signline" style="min-width:90px">{% if d.tax_agent is defined %}{{ f("tax_agent.name", label="세무대리인") }}{% endif %}</span>&nbsp;&nbsp;(서명 또는 인)</div>
<table class="outer compact" style="margin-top:4px">
  <colgroup><col style="width:124px"><col><col style="width:124px"><col></colgroup>
  <tr><th>세무대리인 사업자등록번호</th><td>{% if d.tax_agent is defined %}{{ f("tax_agent.biz_no", label="세무대리인사업자등록번호") }}{% endif %}</td>
    <th>전화번호</th><td>{% if d.tax_agent is defined %}{{ f("tax_agent.phone", label="세무대리인전화번호") }}{% endif %}</td></tr>
</table>
<div class="to">{{ f("tax_office", label="세무서장") }}&nbsp;&nbsp;귀하</div>
{% endblock %}
