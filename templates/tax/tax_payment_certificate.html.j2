{% extends "_base.html.j2" %}
{% import "_macros.html.j2" as m with context %}
{# 국세징수법 시행규칙 [별지 제94호서식] 납세증명서. 법인용(tax_payment_certificate_corp)도 이 템플릿을 쓴다. #}
{% block style %}
table.hd { margin: 0; }
table.hd td { border: 0; padding: 2px 4px; font-size: calc(var(--fs) - 1px); vertical-align: bottom; }
table.hd td.t { text-align: center; }
table.hd h1 { margin: 0; font-size: calc(var(--title) + 2px); letter-spacing: .5em; }
table.tp { border-top: 2px solid var(--border); border-bottom: 2px solid var(--border); border-left: 0; border-right: 0; }
table.tp th, table.tp td { padding: 7px 8px; }
table.tp tr > :first-child { border-left: 0; } table.tp tr > :last-child { border-right: 0; }
table.tp th.v { writing-mode: vertical-rl; letter-spacing: .4em; padding: 6px 2px; }
table.tp td.c, table.tp td.num { font-size: calc(var(--fs) - 1px); }
table.tp td.nil { text-align: center; padding: 14px 6px; }
table.tp th.sec { text-align: left; padding-left: 10px; }
.stmt { margin: 26px 6px 0; line-height: 1.8; font-size: calc(var(--fs) + 0.5px); text-indent: 1em; }
.foot { margin-top: 30px; border-top: 1px solid var(--border); padding-top: 8px; }
{% endblock %}
{% block content %}
{% set corp = d.taxpayer.corp_reg_no is defined %}
<div class="gov-head"><span>■ 국세징수법 시행규칙 [별지 제94호서식]</span><span></span></div>
<table class="hd">
  <colgroup><col style="width:30%"><col><col style="width:22%"></colgroup>
  <tr><td>발급번호<br>{{ f("issue_no", label="발급번호") }}</td>
    <td class="t"><h1>납세증명서</h1></td>
    <td class="right">처리기간<br>즉시</td></tr>
</table>
<table class="tp">
  <colgroup><col style="width:44px"><col style="width:132px"><col><col style="width:150px"><col style="width:170px"></colgroup>
  <tr><th rowspan="3" class="v">납세자</th>
    <th>상호(법인명)</th><td>{{ f("taxpayer.corp_name", label="상호(법인명)") if corp else f("taxpayer.trade_name", label="상호(법인명)") }}</td>
    <th>사업자등록번호</th><td>{{ f("taxpayer.biz_no", label="사업자등록번호") }}</td></tr>
  <tr><th>성명(대표자)</th><td>{{ f("taxpayer.ceo", label="성명(대표자)") if corp else f("taxpayer.name", label="성명(대표자)") }}</td>
    <th>주민등록번호<br>(법인등록번호)</th>
    <td>{{ f("taxpayer.corp_reg_no", label="법인등록번호") if corp else f("taxpayer.rrn", label="주민등록번호") }}</td></tr>
  <tr><th>주소(본점)</th><td colspan="3">{{ f("taxpayer.address", label="주소(본점)") }}</td></tr>
  <tr><th colspan="2">증명서 유효기간</th><td colspan="3">{{ f("valid_period", label="증명서유효기간") }}</td></tr>
  <tr><th colspan="2">유효기간을 정한 사유</th><td colspan="3">{{ f("valid_reason", label="유효기간을정한사유") }}</td></tr>
  <tr><th colspan="2">사용목적</th><td colspan="3">{{ m.choice("purpose_type", ["대금 수령", "해외이주", "기타"], label="사용목적", on="[√]", off="[ ]") }}
      ( {{ f("purpose", label="사용목적") }} )</td></tr>
  <tr><th colspan="2">대금 지급자</th><td colspan="3">{{ f("payer", label="대금지급자") }}</td></tr>
</table>
<table class="tp compact">
  <colgroup><col style="width:18%"><col style="width:22%"><col style="width:14%"><col style="width:14%"><col style="width:14%"><col></colgroup>
  <tr><th colspan="6" class="sec">연장ㆍ유예 명세</th></tr>
  <tr><th>연장ㆍ유예 종류</th><th>연장ㆍ유예 기간</th><th>과세기간</th><th>세목</th><th>납부기한</th><th>세액</th></tr>
  {% if d.deferrals is defined %}{% for it in d.deferrals %}{% set i = loop.index0 %}
  <tr><td class="c">{{ f("deferrals." ~ i ~ ".kind", label="연장ㆍ유예종류") }}</td><td class="c">{{ f("deferrals." ~ i ~ ".period", label="연장ㆍ유예기간") }}</td>
    <td class="c">{{ f("deferrals." ~ i ~ ".tax_period", label="과세기간") }}</td><td class="c">{{ f("deferrals." ~ i ~ ".tax_item", label="세목") }}</td>
    <td class="c">{{ f("deferrals." ~ i ~ ".due", label="납부기한") }}</td><td class="num">{{ f("deferrals." ~ i ~ ".amount", label="세액") }}</td></tr>
  {% endfor %}{% else %}
  <tr><td colspan="6" class="nil">{{ f("deferral", label="연장ㆍ유예명세") }}</td></tr>{% endif %}
</table>
<table class="tp">
  <colgroup><col style="width:176px"><col></colgroup>
  <tr><th>체납액</th><td>{{ f("arrears", label="체납액") }}</td></tr>
</table>
<div class="pg-keep">
<p class="stmt">「국세징수법」 제108조 및 같은 법 시행령 제95조에 따라 발급일 현재 위의 연장ㆍ유예액 또는 「국세기본법」 제42조, 「종합부동산세법」 제7조의2ㆍ제12조의2 또는 「부가가치세법」 제3조의2에 따른 양도담보권자 또는 수탁자의 물적납세의무와 관련된 체납액을 제외하고는 다른 체납액이 없음을 증명합니다.</p>
{{ m.issuer("issue_date", org_path="issuer", seal_text=val("issuer") ~ "인") }}
</div>
<div class="foot note">
  <div>※ 위 내용은 발급일 현재 상황으로서 추후 변경될 수 있습니다.</div>
  <div>※ 이 증명서는 국세청 홈택스(www.hometax.go.kr)에서 인터넷으로 발급되었습니다. 발급번호를 이용하여 홈택스 [민원증명 원본확인] 메뉴에서 진위 여부를 확인할 수 있습니다.</div>
</div>
{% endblock %}
