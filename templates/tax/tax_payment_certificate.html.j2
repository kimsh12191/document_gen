{% extends "_base.html.j2" %}
{% import "_macros.html.j2" as m with context %}
{% block style %}
.ht-top { display: flex; justify-content: space-between; font-size: calc(var(--fs) - 1px); margin-bottom: 4px; }
.ht-title { border: 2px solid var(--border); text-align: center; padding: 14px 0; margin-bottom: 12px; }
.ht-title h1 { margin: 0; font-size: var(--title); letter-spacing: .45em; }
table.tp th { width: 1%; }
table.tp td.nil { text-align: center; padding: 14px; }
.stmt { margin: 28px 6px 0; line-height: 1.7; font-size: calc(var(--fs) + 0.5px); }
.foot { margin-top: 34px; border-top: 1px solid var(--border); padding-top: 8px; }
{% endblock %}
{% block content %}
{% set corp = d.taxpayer.corp_reg_no is defined %}
<div class="ht-top"><span>발급번호 : {{ f("issue_no", label="발급번호") }}</span><span>처리기간 : 즉시</span></div>
<div class="ht-title"><h1>납세증명서</h1></div>
<table class="tp outer">
  <colgroup><col style="width:70px"><col style="width:120px"><col><col style="width:130px"><col style="width:170px"></colgroup>
  <tr><th rowspan="3">납세자</th>
    <th>상호(법인명)</th><td>{{ f("taxpayer.corp_name", label="법인명") if corp else f("taxpayer.trade_name", label="상호") }}</td>
    <th>사업자등록번호</th><td>{{ f("taxpayer.biz_no", label="사업자등록번호") }}</td></tr>
  <tr><th>성명(대표자)</th><td>{{ f("taxpayer.ceo", label="대표자") if corp else f("taxpayer.name", label="성명") }}</td>
    <th>{{ "법인등록번호" if corp else "주민등록번호" }}</th>
    <td>{{ f("taxpayer.corp_reg_no", label="법인등록번호") if corp else f("taxpayer.rrn", label="주민등록번호") }}</td></tr>
  <tr><th>{{ "본점 소재지" if corp else "주　소" }}</th><td colspan="3">{{ f("taxpayer.address", label="본점소재지" if corp else "주소") }}</td></tr>
  <tr><th colspan="2">증명서 유효기간</th><td colspan="3">{{ f("valid_period", label="증명서유효기간") }}</td></tr>
  <tr><th colspan="2">사용목적</th><td colspan="3">{{ m.choice("purpose_type", ["대금수령", "대금수령 이외"], label="사용목적구분") }}
      ( {{ f("purpose", label="사용목적") }} )</td></tr>
  <tr><th colspan="2">대금 지급자</th><td colspan="3">&nbsp;</td></tr>
</table>
<table class="outer compact">
  <tr><th colspan="7" style="text-align:left">징수유예 등 또는 체납처분유예의 명세</th></tr>
  <tr><th>유예종류</th><th>유예기간</th><th>과세기간</th><th>세목</th><th>납부기한</th><th>세액</th><th>가산금</th></tr>
  <tr><td colspan="7" class="c" style="padding:12px">{{ f("deferral", label="징수유예등또는체납처분유예의명세") }}</td></tr>
</table>
<table class="outer">
  <colgroup><col style="width:190px"><col></colgroup>
  <tr><th>체납액</th><td>{{ f("arrears", label="체납액") }}</td></tr>
</table>
<p class="stmt">「국세징수법」 제107조 및 같은 법 시행령 제91조에 따라 발급일 현재 위의 징수유예 등 또는 체납처분유예액을 제외하고는 다른 체납액이 없으므로, 위의 기재사항과 같이 납세증명서를 발급합니다.</p>
{{ m.issuer("issue_date", org_path="issuer", seal_text=val("issuer") ~ "인") }}
<div class="foot note">
  <div>※ 이 증명서는 국세청 홈택스(www.hometax.go.kr)에서 인터넷으로 발급되었습니다.</div>
  <div>※ 발급일로부터 90일 이내에 홈택스 [민원증명 &gt; 민원증명 원본확인] 메뉴에서 발급번호를 입력하여 진위 여부를 확인할 수 있습니다.</div>
  <div>※ 납세증명서는 증명서 유효기간 이내에 한하여 효력이 있으며, 발급일 이후 새로 발생한 체납액은 반영되지 않습니다.</div>
</div>
{% endblock %}
