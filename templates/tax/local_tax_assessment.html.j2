{% extends "_base.html.j2" %}
{% import "_macros.html.j2" as m with context %}
{% block style %}
.ht-title { text-align: center; margin: 6px 0 12px; }
.ht-title h1 { margin: 0; font-size: calc(var(--title) - 2px); letter-spacing: .15em; }
.cap { font-weight: 700; margin: 12px 0 2px; }
table.items td { font-size: calc(var(--fs) - 2px); padding: 3px 4px; }
table.items th { font-size: calc(var(--fs) - 1.5px); padding: 4px 4px; white-space: normal; }
table.items td.obj { text-align: left; word-break: keep-all; }
table.items tr.sum td { font-weight: 700; background: var(--label-bg); }
.unit { text-align: right; font-size: calc(var(--fs) - 2px); }
.stmt { text-align: center; margin: 22px 0 0; font-size: calc(var(--fs) + 0.5px); }
.foot { margin-top: 26px; border-top: 1px solid var(--border); padding-top: 6px; }
{% endblock %}
{% block content %}
<div class="gov-head"><span>■ 지방세기본법 시행규칙 [별지 제5호서식]</span><span>(앞쪽)</span></div>
<table class="outer">
  <colgroup><col style="width:120px"><col><col style="width:120px"><col style="width:120px"></colgroup>
  <tr><th>발급번호</th><td>{{ f("issue_no", label="발급번호") }}</td><th>처리기간</th><td class="c">즉시</td></tr>
</table>
<div class="ht-title"><h1>지방세 세목별 과세증명서</h1></div>
<div class="cap">□ 납세자</div>
{{ m.kv([["성　명", "taxpayer.name"], ["주민등록번호", "taxpayer.rrn"], ["주　소", "taxpayer.address", True],
         ["증명기간", "period"], ["사용목적", "purpose"]], cols=2, label_w="110px") }}
<div class="between"><div class="cap">□ 과세내역</div><div class="unit">(단위 : 원)</div></div>
<table class="items outer">
  <colgroup><col style="width:44px"><col style="width:92px"><col style="width:76px"><col><col style="width:92px"><col style="width:72px"><col style="width:66px"><col style="width:76px"></colgroup>
  <tr><th>과세<br>연도</th><th>세목</th><th>납기</th><th>과세대상</th><th>과세표준</th><th>세액</th><th>지방교육세</th><th>합계</th></tr>
  {% for it in d["items"] %}{% set i = loop.index0 %}
  <tr>
    <td class="c">{{ f("items." ~ i ~ ".year", label="과세연도") }}</td>
    <td class="c">{{ f("items." ~ i ~ ".tax_item", label="세목") }}</td>
    <td class="c">{{ f("items." ~ i ~ ".due", label="납기") }}</td>
    <td class="obj">{{ f("items." ~ i ~ ".object", label="과세대상") }}</td>
    <td class="num">{{ f("items." ~ i ~ ".base", label="과세표준") }}</td>
    <td class="num">{{ f("items." ~ i ~ ".tax", label="세액") }}</td>
    <td class="num">{{ f("items." ~ i ~ ".edu", label="지방교육세") }}</td>
    <td class="num">{{ f("items." ~ i ~ ".total", label="합계") }}</td>
  </tr>
  {% endfor %}
  <tr class="sum"><td colspan="5" class="c">합　　계</td>
    <td class="num">{{ f("sum.tax", label="세액합계") }}</td>
    <td class="num">{{ f("sum.edu", label="지방교육세합계") }}</td>
    <td class="num">{{ f("sum.total", label="총합계") }}</td></tr>
</table>
<p class="stmt">위와 같이 지방세 과세 사실이 있음을 증명합니다.</p>
{{ m.issuer("issue_date", org_path="issuer", seal_text=val("issuer").split()[-1] ~ "인") }}
<div class="foot note">
  <div>※ 이 증명서는 위 기간 중 해당 지방자치단체에 부과된 지방세 내역을 증명하는 것으로, 납부 여부를 증명하지는 않습니다.</div>
  <div>※ 재산세 세액에는 재산세 도시지역분 및 지역자원시설세가 포함되지 않습니다.</div>
  <div>※ 발급일로부터 90일까지 정부24(www.gov.kr) [문서확인] 메뉴에서 발급번호로 진위를 확인할 수 있습니다.</div>
</div>
{% endblock %}
