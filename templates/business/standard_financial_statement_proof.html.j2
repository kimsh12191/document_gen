{% extends "_base.html.j2" %}
{% import "_macros.html.j2" as m with context %}
{% block page_class %} dense{% endblock %}

{% block style %}
table.hd { margin: 0; }
table.hd td { border: 0; padding: 2px 4px; font-size: calc(var(--fs) - 1px); vertical-align: bottom; }
table.hd h1 { margin: 0; font-size: var(--title); letter-spacing: .2em; text-align: center; white-space: nowrap; }
table.tp { border-top: 2px solid var(--border); border-bottom: 2px solid var(--border); border-left: 0; border-right: 0; }
table.tp th, table.tp td { padding: 4px 7px; }
table.tp tr > :first-child { border-left: 0; } table.tp tr > :last-child { border-right: 0; }
table.tp th.v { writing-mode: vertical-rl; letter-spacing: .3em; padding: 4px 2px; }
.cap { font-weight: 700; margin: 10px 0 2px; }
.fs-wrap { display: flex; gap: 10px; align-items: flex-start; }
.fs-wrap > div { flex: 1; }
table.fs th, table.fs td { padding: 3px 6px; }
table.fs td.acct { text-align: left; }
table.fs td.acct.i1 { padding-left: 16px; }
table.fs td.acct.i2 { padding-left: 28px; }
table.fs tr.tot td { font-weight: 700; background: var(--label-bg); }
.unit { text-align: right; font-size: calc(var(--fs) - 2px); }
.stmt { text-align: center; margin: 12px 0 0; }
.issuer { margin-top: 12px; margin-bottom: 24px; }
.issuer .date { margin-bottom: 10px; }
.rep-no:not(.pg-repeated) { display: none; }
.rep-no.pg-repeated { margin-bottom: 6px; }
table.fs.detail { margin-bottom: 10px; }
.blank-end { text-align: center; letter-spacing: .3em; font-size: calc(var(--fs) - 1px); margin: 4px 0; }
.foot { margin-top: 10px; border-top: 1px solid var(--border); padding-top: 6px; }
{% endblock %}
{% macro row(label, key, sec, lv=0, tot=False) -%}
<tr{% if tot %} class="tot"{% endif %}><td class="acct i{{ lv }}">{{ label }}</td><td class="num">{{ f(sec ~ "." ~ key, label=label.split(". ")[-1]) }}</td></tr>
{%- endmacro %}
{% block content %}
<div class="docno pg-repeat rep-no">발급번호 : {{ val("issue_no") }}</div>
<div class="gov-head"><span>【국세청 민원사무처리규정 제13호 서식】(2024. 4. 17. 개정)</span><span></span></div>
<table class="hd">
  <colgroup><col style="width:27%"><col><col style="width:18%"></colgroup>
  <tr><td>발급번호<br>{{ f("issue_no", label="발급번호") }}</td>
    <td><h1>표준재무제표증명</h1><div class="c">{{ m.choice("taxpayer_type", ["개인", "법인"], label="개인/법인", on="■", off="□") }}</div></td>
    <td class="right">처리기간<br>즉 시</td></tr>
</table>
<table class="tp">
  <colgroup><col style="width:44px"><col style="width:120px"><col><col style="width:140px"><col style="width:160px"></colgroup>
  <tr><th rowspan="4" class="v">납세자</th>
    <th>상호(법인명)</th><td>{{ f("taxpayer.trade_name", label="상호(법인명)") }}</td>
    <th>사업자등록번호</th><td>{{ f("taxpayer.biz_no", label="사업자등록번호") }}</td></tr>
  <tr><th>성명(대표자)</th><td>{{ f("taxpayer.name", label="성명(대표자)") }}</td>
    <th>주민(법인)등록번호</th><td>{{ f("taxpayer.rrn", label="주민(법인)등록번호") }}</td></tr>
  <tr><th>업　태</th><td>{{ f("taxpayer.biz_type", label="업태") }}</td>
    <th>종　목</th><td>{{ f("taxpayer.biz_item", label="종목") }}</td></tr>
  <tr><th>사 업 장</th><td colspan="3">{{ f("taxpayer.address", label="사업장") }}</td></tr>
  <tr><th colspan="2">사업연도</th><td>{{ f("period", label="사업연도") }}</td>
    <th>신고구분</th><td>{{ f("filing_kind", label="신고구분") }}</td></tr>
  <tr><th colspan="2">첨부서류</th><td>{{ f("attachments", label="첨부서류") }}</td>
    <th>신 고 일</th><td>{{ f("filed_date", label="신고일") }}</td></tr>
</table>
<p class="stmt">붙임의 표준재무제표는 과세표준 신고 시 세무서에 제출한 표준재무제표와 같음을 증명합니다.</p>
{{ m.issuer("issue_date", org_path="issuer", seal_text=val("issuer") ~ "인") }}
{% if d.bs_accounts is defined %}
{# heavy: 세부 계정과목까지 (재무상태표 → 손익계산서 순서로 세로로 쌓아 쪽 나눔) #}
<div class="between pg-keep-with-next"><div class="cap">붙임 : 표준재무제표</div><div class="unit">(단위 : 원)</div></div>
{% macro det(sec, grp) -%}
{% for a in d[sec].get(grp, []) %}{% set i = loop.index0 %}
<tr><td class="acct i2">{{ f(sec ~ "." ~ grp ~ "." ~ i ~ ".account", label="계정과목") }}</td><td class="num">{{ f(sec ~ "." ~ grp ~ "." ~ i ~ ".amount", label="금액") }}</td></tr>
{% endfor %}
{%- endmacro %}
<table class="fs compact detail">
<colgroup><col><col style="width:34%"></colgroup>
<tr><th colspan="2">표준재무상태표</th></tr>
<tr><th>과　목</th><th>금　액</th></tr>
{{ row("Ⅰ. 유동자산", "current", "balance_sheet") }}
{{ row("1. 당좌자산", "quick", "balance_sheet", 1) }}{{ det("bs_accounts", "quick") }}
{{ row("2. 재고자산", "inventory", "balance_sheet", 1) }}{{ det("bs_accounts", "inventory") }}
{{ row("Ⅱ. 비유동자산", "noncurrent", "balance_sheet") }}
{{ row("1. 투자자산", "investment", "balance_sheet", 1) }}{{ det("bs_accounts", "investment") }}
{{ row("2. 유형자산", "tangible", "balance_sheet", 1) }}{{ det("bs_accounts", "tangible") }}
{{ row("3. 무형자산", "intangible", "balance_sheet", 1) }}{{ det("bs_accounts", "intangible") }}
{{ row("4. 기타비유동자산", "other_noncurrent", "balance_sheet", 1) }}{{ det("bs_accounts", "other_noncurrent") }}
{{ row("자산총계", "assets", "balance_sheet", 0, True) }}
{{ row("Ⅰ. 유동부채", "current_liab", "balance_sheet") }}{{ det("bs_accounts", "current_liab") }}
{{ row("Ⅱ. 비유동부채", "noncurrent_liab", "balance_sheet") }}{{ det("bs_accounts", "noncurrent_liab") }}
{{ row("부채총계", "liabilities", "balance_sheet", 0, True) }}
{{ row("Ⅰ. 자본금", "capital", "balance_sheet") }}
{{ row("자본총계", "equity", "balance_sheet", 0, True) }}
{{ row("부채와자본총계", "liab_equity", "balance_sheet", 0, True) }}
</table>
<table class="fs compact detail">
<colgroup><col><col style="width:34%"></colgroup>
<tr><th colspan="2">표준손익계산서</th></tr>
<tr><th>과　목</th><th>금　액</th></tr>
{{ row("Ⅰ. 매출액", "revenue", "income_statement") }}{{ det("pl_accounts", "revenue") }}
{{ row("Ⅱ. 매출원가", "cogs", "income_statement") }}{{ det("pl_accounts", "cogs") }}
{{ row("Ⅲ. 매출총이익", "gross", "income_statement", 0, True) }}
{{ row("Ⅳ. 판매비와관리비", "sga", "income_statement") }}
{{ row("1. 급여", "salary", "income_statement", 1) }}
{{ row("2. 복리후생비", "welfare", "income_statement", 1) }}
{{ row("3. 지급임차료", "rent", "income_statement", 1) }}
{{ row("4. 감가상각비", "depreciation", "income_statement", 1) }}
{% for a in d.pl_accounts.get("sga", []) %}{% set i = loop.index0 %}
<tr><td class="acct i1">{{ i + 5 }}. {{ f("pl_accounts.sga." ~ i ~ ".account", label="계정과목") }}</td><td class="num">{{ f("pl_accounts.sga." ~ i ~ ".amount", label="금액") }}</td></tr>
{% endfor %}
{{ row("Ⅴ. 영업이익", "op", "income_statement", 0, True) }}
{{ row("Ⅵ. 영업외수익", "non_op_income", "income_statement") }}{{ det("pl_accounts", "non_op_income") }}
{{ row("Ⅶ. 영업외비용", "non_op_expense", "income_statement") }}{{ det("pl_accounts", "non_op_expense") }}
{{ row("Ⅷ. 당기순이익", "net", "income_statement", 0, True) }}
</table>
<div class="blank-end">- 이하 여백 -</div>
{% else %}
<div class="between"><div class="cap">붙임 : 표준재무제표</div><div class="unit">(단위 : 원)</div></div>
<div class="fs-wrap">
<div>
<table class="fs compact">
<tr><th colspan="2">표준재무상태표</th></tr>
<tr><th>과　목</th><th>금　액</th></tr>
{{ row("Ⅰ. 유동자산", "current", "balance_sheet") }}
{{ row("1. 당좌자산", "quick", "balance_sheet", 1) }}
{{ row("2. 재고자산", "inventory", "balance_sheet", 1) }}
{{ row("Ⅱ. 비유동자산", "noncurrent", "balance_sheet") }}
{{ row("1. 투자자산", "investment", "balance_sheet", 1) }}
{{ row("2. 유형자산", "tangible", "balance_sheet", 1) }}
{{ row("3. 무형자산", "intangible", "balance_sheet", 1) }}
{{ row("4. 기타비유동자산", "other_noncurrent", "balance_sheet", 1) }}
{{ row("자산총계", "assets", "balance_sheet", 0, True) }}
{{ row("Ⅰ. 유동부채", "current_liab", "balance_sheet") }}
{{ row("Ⅱ. 비유동부채", "noncurrent_liab", "balance_sheet") }}
{{ row("부채총계", "liabilities", "balance_sheet", 0, True) }}
{{ row("Ⅰ. 자본금", "capital", "balance_sheet") }}
{{ row("자본총계", "equity", "balance_sheet", 0, True) }}
{{ row("부채와자본총계", "liab_equity", "balance_sheet", 0, True) }}
</table>
</div>
<div>
<table class="fs compact">
<tr><th colspan="2">표준손익계산서</th></tr>
<tr><th>과　목</th><th>금　액</th></tr>
{{ row("Ⅰ. 매출액", "revenue", "income_statement") }}
{{ row("Ⅱ. 매출원가", "cogs", "income_statement") }}
{{ row("Ⅲ. 매출총이익", "gross", "income_statement", 0, True) }}
{{ row("Ⅳ. 판매비와관리비", "sga", "income_statement") }}
{{ row("1. 급여", "salary", "income_statement", 1) }}
{{ row("2. 복리후생비", "welfare", "income_statement", 1) }}
{{ row("3. 임차료", "rent", "income_statement", 1) }}
{{ row("4. 감가상각비", "depreciation", "income_statement", 1) }}
{{ row("5. 기타 판매비와관리비", "other_sga", "income_statement", 1) }}
{{ row("Ⅴ. 영업이익", "op", "income_statement", 0, True) }}
{{ row("Ⅵ. 영업외수익", "non_op_income", "income_statement") }}
{{ row("Ⅶ. 영업외비용", "non_op_expense", "income_statement") }}
{{ row("Ⅷ. 당기순이익", "net", "income_statement", 0, True) }}
</table>
</div>
</div>
{% endif %}
<div class="foot note">
  <div>※ 위 내용은 과세표준 신고 시 제출한 표준재무제표 기준이며, 수정신고 등에 따라 달라질 수 있습니다.</div>
  <div>※ 이 증명서는 국세청 홈택스(www.hometax.go.kr)에서 인터넷으로 발급되었습니다. 발급번호를 이용하여 홈택스 [민원증명 원본확인] 메뉴에서 진위 여부를 확인할 수 있습니다.</div>
</div>
{% endblock %}
