{% extends "_base.html.j2" %}
{% import "_macros.html.j2" as m with context %}
{% import "corporate/_seal.html.j2" as cs with context %}
{% block page_class %} dense{% endblock %}
{% block style %}
.page.a4 { padding: min(var(--page-pad), 44px) min(var(--page-pad), 60px); }
h1.title { letter-spacing:.6em; margin:0 0 2px; }
.cname { text-align:center; font-size:calc(var(--fs) + 2px); margin-bottom:10px; }
.chap { text-align:center; font-weight:700; margin:10px 0 4px; letter-spacing:.3em; }
.art { margin:4px 0; text-align:justify; line-height:1.45; }
.art .h { font-weight:700; }
.art .p { display:block; padding-left:1.2em; }
.purp { columns:2; column-gap:18px; padding-left:1.6em; margin:1px 0 2px; }
.purp div { break-inside:avoid; }
.omit { text-align:center; color:#555; margin:8px 0; letter-spacing:.4em; }
.hist { margin-bottom:6px; display:flex; flex-wrap:wrap; gap:2px 18px; justify-content:center; font-size:calc(var(--fs) - 1px); }
.cert { border:2px solid var(--seal); color:var(--seal); display:inline-block; padding:4px 14px; margin-top:8px; transform:rotate(-1.5deg); }
{% endblock %}
{% block content %}
{{ m.title("정　관") }}
<div class="cname">{{ f("company_name", label="상호") }}</div>
<div class="hist">{% for x in d.revision_history %}<span>{{ f("revision_history." ~ loop.index0, label="제정·개정일") }}</span>{% endfor %}</div>

<div class="chap">제1장 총　칙</div>
<div class="art"><span class="h">제1조(상호)</span> 이 회사는 {{ f("company_name", label="상호") }}(이하 "회사"라 한다)라 한다. 영문으로는 {{ f("company_name_en", label="영문상호") }}로 표기한다.</div>
<div class="art"><span class="h">제2조(목적)</span> 이 회사는 다음의 사업을 영위함을 목적으로 한다.
  <div class="purp">{% for x in d.purposes %}<div>{{ f("purposes." ~ loop.index0, label="목적") }}</div>{% endfor %}</div>
</div>
<div class="art"><span class="h">제3조(본점의 소재지 및 지점 등의 설치)</span> ① 이 회사의 본점은 {{ f("head_office_city", label="본점소재지") }}에 둔다.
  <span class="p">② 회사는 필요에 따라 이사회의 결의로 국내외에 지점, 출장소, 사무소 및 현지법인을 둘 수 있다.</span></div>
<div class="art"><span class="h">제4조(공고방법)</span> 이 회사의 공고는 {{ f("notice_method", label="공고방법") }}</div>

<div class="chap">제2장 주식과 주권</div>
<div class="art"><span class="h">제5조(발행예정주식의 총수)</span> 이 회사가 발행할 주식의 총수는 {{ f("authorized_shares", label="발행예정주식의총수") }}로 한다.</div>
<div class="art"><span class="h">제6조(1주의 금액)</span> 이 회사가 발행하는 주식 1주의 금액은 {{ f("par_value", label="1주의금액") }}으로 한다.</div>
<div class="art"><span class="h">제7조(설립 시에 발행하는 주식의 총수)</span> 이 회사가 설립 시에 발행하는 주식의 총수는 {{ f("initial_shares", label="설립시발행주식총수") }}로 한다.</div>
<div class="art"><span class="h">제8조(주식 및 주권의 종류)</span> ① 이 회사가 발행할 주식은 보통주식으로서 전부 기명식으로 한다.
  <span class="p">② 이 회사의 주권은 1주권, 5주권, 10주권, 50주권, 100주권, 500주권, 1,000주권, 10,000주권의 8종류로 한다.</span></div>
<div class="art"><span class="h">제9조(신주인수권)</span> ① 이 회사의 주주는 신주 발행에 있어서 그가 소유한 주식 수에 비례하여 신주의 배정을 받을 권리를 가진다.
  <span class="p">② 주주가 신주인수권을 포기 또는 상실하거나 신주 배정에서 단주가 발생하는 경우에 그 처리방법은 이사회의 결의로 정한다.</span></div>
<div class="art"><span class="h">제10조(명의개서 등)</span> ① 주식의 양도로 인한 명의개서를 청구할 때에는 소정의 청구서에 주권을 첨부하여 제출하여야 한다.
  <span class="p">② 주식의 양도는 이사회의 승인을 얻어야 한다.</span></div>
<div class="art"><span class="h">제11조(주주명부의 폐쇄 및 기준일)</span> ① 이 회사는 매 결산기 최종일의 익일부터 정기주주총회 종료일까지 주주명부의 기재변경을 정지한다.
  <span class="p">② 이 회사는 매 결산기 최종일의 주주명부에 기재되어 있는 주주를 그 결산기에 관한 정기주주총회에서 권리를 행사할 주주로 한다.</span></div>

<div class="chap">제3장 주주총회</div>
<div class="art"><span class="h">제12조(소집시기)</span> ① 이 회사의 주주총회는 정기주주총회와 임시주주총회로 한다.
  <span class="p">② 정기주주총회는 매 사업연도 종료 후 3개월 이내에, 임시주주총회는 필요에 따라 소집한다.</span></div>
<div class="omit">( 중　략 )</div>
<div class="chap">부　칙</div>
<div class="art"><span class="h">제1조(시행일)</span> 이 정관은 회사설립일인 {{ f("effective_date", label="시행일") }}부터 시행한다.</div>
<div class="art"><span class="h">제2조(발기인)</span> 이 회사의 발기인의 성명, 주민등록번호 및 주소는 이 정관 말미에 기재와 같다.</div>
{% for x in d.revision_effective %}
<div class="art"><span class="h">부칙 (개정 {{ f("revision_effective." ~ loop.index0, label="시행일") }})</span> 이 정관은 위 개정일부터 시행한다.</div>
{% endfor %}<div class="center">
<div class="cert">
  <div class="bold">원 본 대 조 필</div>
  <div class="small">위 정관은 원본과 상위 없음을 증명합니다.</div>
  <div class="small">{{ f("certify_date", label="증명일") }}</div>
  <div class="small">{{ f("company_name", label="상호") }} 대표이사 {{ f("ceo_name", label="대표이사") }}&nbsp;{{ cs.corp_seal(d.company_name, "대표이사인", 50, "aoi") }}</div>
</div>
</div>
{% endblock %}
