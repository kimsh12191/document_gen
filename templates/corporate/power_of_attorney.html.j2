{% extends "_base.html.j2" %}
{% import "_macros.html.j2" as m with context %}
{% import "corporate/_seal.html.j2" as cs with context %}
{# 은행 제출용 위임장: 1. 대리인 정보 → 2. 위임내용 → 작성일 → 위임인(본인) 기명날인 → 은행 귀중 (은행 위임장 서식 구성) #}
{% block style %}
h1.title { letter-spacing:.8em; margin:10px 0 22px; }
.sec { font-weight:700; margin:16px 0 4px; }
table.po th { width:120px; letter-spacing:.05em; }
.lead { margin:10px 0 6px; }
.tasks { border:var(--bw) solid var(--border); padding:10px 18px; line-height:1.9; }
.dt { text-align:center; margin:26px 0 16px; font-size:calc(var(--fs) + 1px); letter-spacing:.05em; }
.grantor-wrap { display:flex; align-items:center; gap:10px; }
.grantor-wrap table { flex:1; margin:0; }
.sealbox { width:118px; text-align:center; flex:none; }
.sealbox .lbl { font-size:calc(var(--fs) - 2px); color:#444; margin-bottom:4px; }
.to { margin-top:26px; font-size:calc(var(--fs) + 6px); font-weight:700; letter-spacing:.15em; }
.att { margin-top:10px; font-size:calc(var(--fs) - 1.5px); color:#333; }
{% endblock %}
{% block content %}
{{ m.title("위 임 장") }}
<div class="sec">1. 대리인(수임인) 정보</div>
<table class="po">
  <tr><th>성　　명</th><td>{{ f("agent.name", label="성명") }}</td><th>생년월일</th><td>{{ f("agent.birth", label="생년월일") }}</td></tr>
  <tr><th>본인과의 관계</th><td>{{ f("agent.relation", label="본인과의관계") }}</td><th>연 락 처</th><td>{{ f("agent.phone", label="연락처") }}</td></tr>
  <tr><th>주　　소</th><td colspan="3">{{ f("agent.address", label="주소") }}</td></tr>
</table>

<div class="sec">2. 위임내용</div>
<div class="lead">본인은 위 대리인에게 다음 사항에 관한 일체의 권한을 위임합니다.</div>
<div class="tasks">
  {% for t in d.tasks %}<div>{{ f("tasks." ~ loop.index0, label="위임내용") }}</div>{% endfor %}
  <div class="mt">위임기간 : {{ f("period", label="위임기간") }}</div>
</div>

<div class="dt">{{ f("grant_date", label="작성일") }}</div>

<div class="sec">3. 위임인(본인) &nbsp;<span class="small" style="font-weight:400">위임인 구분 : {{ m.choice("grantor.type", ["법인", "개인"], label="위임인구분") }}</span></div>
<div class="grantor-wrap">
<table class="po">
  {% if d.grantor.type == "법인" %}
  <tr><th>상　　호</th><td>{{ f("grantor.name", label="상호") }}</td><th>대 표 자</th><td>대표이사 {{ f("grantor.ceo", label="대표자") }}</td></tr>
  <tr><th>사업자등록번호</th><td>{{ f("grantor.biz_no", label="사업자등록번호") }}</td><th>법인등록번호</th><td>{{ f("grantor.corp_reg_no", label="법인등록번호") }}</td></tr>
  <tr><th>본점소재지</th><td colspan="3">{{ f("grantor.address", label="본점소재지") }}</td></tr>
  <tr><th>연 락 처</th><td colspan="3">{{ f("grantor.phone", label="연락처") }}</td></tr>
  {% else %}
  <tr><th>성　　명</th><td>{{ f("grantor.name", label="성명") }}</td><th>생년월일</th><td>{{ f("grantor.birth", label="생년월일") }}</td></tr>
  <tr><th>연 락 처</th><td colspan="3">{{ f("grantor.phone", label="연락처") }}</td></tr>
  <tr><th>주　　소</th><td colspan="3">{{ f("grantor.address", label="주소") }}</td></tr>
  {% endif %}
</table>
<div class="sealbox">
  {% if d.grantor.type == "법인" %}
  <div class="lbl">(법인인감)</div>{{ cs.corp_seal(d.grantor.name.replace("(주)", "주식회사 "), "대표이사인", 92, "poa") }}
  {% else %}
  <div class="lbl">(인감)</div>{{ m.seal(d.grantor.name, size="lg", key="grantor", kind="인감") }}
  {% endif %}
</div>
</div>
<div class="att">{% if d.grantor.type == "법인" %}※ 위임인은 법인인감을 날인하고 법인인감증명서(최근 3개월 이내 발급분)를 첨부하여야 합니다.{% else %}※ 위임인은 인감증명서상의 인감을 날인하거나 본인서명사실확인서와 같은 서명을 하여야 합니다.{% endif %}<br>※ 첨부 : {{ f("attachment", label="첨부서류") }}, 대리인 신분증 사본 1부</div>
<div class="to">{{ f("recipient", label="제출처") }}</div>
{% endblock %}
