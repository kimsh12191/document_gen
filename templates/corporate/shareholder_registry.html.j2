{% extends "_base.html.j2" %}
{% import "_macros.html.j2" as m with context %}
{% import "corporate/_seal.html.j2" as cs with context %}
{% block style %}
h1.title { letter-spacing:.5em; margin-bottom:6px; }
.base { text-align:right; margin-bottom:10px; }
table.sh { table-layout:fixed; }
table.sh th, table.sh td { padding:4px 3px; word-break:keep-all; overflow-wrap:anywhere; }
table.sh th { font-size:calc(var(--fs) - 2px); white-space:normal; line-height:1.25; }
table.sh td { font-size:calc(var(--fs) - 2px); }
table.sh td:last-child { white-space:nowrap; }
table.sh td.addr { text-align:left; font-size:calc(var(--fs) - 2.5px); line-height:1.3; }
table.sh tr.sum td { font-weight:700; background:var(--label-bg); }
.confirm { text-align:center; font-size:calc(var(--fs) + 1px); margin:40px 0 24px; }
.ceo { position:relative; display:inline-block; padding-right:60px; font-size:calc(var(--fs) + 2px); letter-spacing:.05em; }
{% endblock %}
{% block content %}
{{ m.title("주 주 명 부") }}
<div class="base">(기준일 : {{ f("base_date", label="기준일") }})</div>
{{ m.kv([["회 사 명", "company_name"], ["법인등록번호", "corp_reg_no"], ["사업자등록번호", "biz_no"], ["발행주식총수", "total_shares"],
         ["본점소재지", "head_office", True], ["1주의 금액", "par_value"], ["자 본 금", "capital"]], cols=2, label_w="110px") }}
<table class="sh mt">
  <tr><th style="width:5%">번호</th><th style="width:9%">주주명</th><th style="width:14%">주민등록번호<br>(사업자번호)</th><th>주　소</th><th style="width:6%">주식<br>종류</th><th style="width:8%">소유<br>주식수</th><th style="width:11%">금　액<br>(원)</th><th style="width:7%">지분율</th><th style="width:10%">취득일</th><th style="width:8%">비고</th></tr>
  {% for r in d.shareholders %}{% set i = loop.index0 %}{% set pth = "shareholders." ~ i ~ "." %}
  <tr>
    <td class="c">{{ f(pth ~ "no", label="번호") }}</td>
    <td class="c">{{ f(pth ~ "name", label="주주명") }}</td>
    <td class="c">{{ f(pth ~ "id_no", label="주민등록번호(사업자번호)") }}</td>
    <td class="addr">{{ f(pth ~ "address", label="주소") }}</td>
    <td class="c">{{ f(pth ~ "share_type", label="주식종류") }}</td>
    <td class="num">{{ f(pth ~ "shares", label="소유주식수") }}</td>
    <td class="num">{{ f(pth ~ "amount", label="금액") }}</td>
    <td class="num">{{ f(pth ~ "ratio", label="지분율") }}</td>
    <td class="c">{{ f(pth ~ "acquired", label="취득일") }}</td>
    <td class="c">{{ f(pth ~ "note", label="비고") }}</td>
  </tr>
  {% endfor %}
  {% for _ in range(6 - d.shareholders|length) %}<tr><td>&nbsp;</td><td></td><td></td><td></td><td></td><td></td><td></td><td></td><td></td><td></td></tr>{% endfor %}
  <tr class="sum"><td colspan="5" class="c">합　　계</td><td class="num">{{ f("sum_shares", label="합계주식수") }}</td><td class="num">{{ f("sum_amount", label="합계금액") }}</td><td class="num">{{ f("sum_ratio", label="합계지분율") }}</td><td></td><td></td></tr>
</table>
<div class="confirm">위 주주명부는 당사 주주명부와 상위 없음을 확인합니다.</div>
<div class="issuer">
  <div class="date">{{ f("certify_date", label="확인일") }}</div>
  <div class="org" style="padding-right:0">{{ f("company_name", label="회사명") }}</div>
  <div class="mt"><span class="ceo">대표이사&nbsp;&nbsp;{{ f("ceo_name", label="대표이사") }}<span style="position:absolute;right:-50px;top:-30px">{{ cs.corp_seal(d.company_name.replace("(주)", "주식회사 "), "대표이사인", 92, "shr") }}</span></span></div>
</div>
{% endblock %}
