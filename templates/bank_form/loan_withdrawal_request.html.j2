{% extends "_base.html.j2" %}
{% import "_macros.html.j2" as m with context %}
{% import "bank_form/_loan_parts.html.j2" as lp with context %}
{% block style %}
table.bf th, table.bf td { padding: 5px 7px; }
{% endblock %}
{% block content %}
{{ lp.css() }}
{{ f.set_corr_name(val("signature")) }}
{{ lp.head(kind="withdraw_req") }}
{{ lp.title_row("대출계약 철회신청서") }}
<div style="margin:0 0 4px">{{ lp.legal_name() }} <b>{{ f("branch", label="취급점") }}</b> 앞</div>

<div class="bf-sec">1. 차주</div>
<table class="bf">
<colgroup><col style="width:120px"><col><col style="width:120px"><col></colgroup>
<tr><th>차　　주</th><td>{{ f("borrower.name", label="차주", fix=0.04) }}</td><th>생년월일</th><td>{{ f("borrower.birth", label="생년월일", fix=0.05) }}</td></tr>
<tr><th>연 락 처</th><td>{{ f("borrower.phone", label="연락처", fix=0.06) }}</td><th>주　　소</th><td>{{ f("borrower.address", label="주소", fix=0.04) }}</td></tr>
</table>

<div class="bf-sec">2. 철회 대상 대출</div>
<table class="bf">
<colgroup><col style="width:120px"><col><col style="width:120px"><col></colgroup>
<tr><th>계좌번호</th><td>{{ f("loan.account", label="계좌번호", fix=0.08) }}</td><th>상 품 명</th><td>{{ f("loan.product", label="상품명") }}</td></tr>
<tr><th>금　　액</th><td class="num">{{ f("loan.amount", label="금액") }}</td><th>실 행 일</th><td>{{ f("loan.executed", label="실행일", fix=0.05) }}</td></tr>
<tr><th>약정이율</th><td>{{ f("loan.rate", label="약정이율") }}</td><th>경과일수</th><td>{{ f("loan.days", label="경과일수") }} 일</td></tr>
</table>

<div class="bf-sec">3. 철회 사유</div>
<table class="bf">
<colgroup><col style="width:120px"><col></colgroup>
<tr><th>철회 사유</th><td>{{ m.choice("reason", ["대출금리·조건이 기대와 다름", "타 금융기관 조건이 유리함", "자금이 필요 없게 됨", "대출한도가 부족함", "기타"], label="철회사유") }}{{ lp.nochk("reason") }}</td></tr>
<tr><th>처리 구분</th><td>{{ m.choice("keep_loan", ["철회함", "중도상환이나 철회하지 않고 대출 유지함"], label="처리구분") }}</td></tr>
</table>

<div class="bf-sec">4. 반환 금액</div>
<table class="bf">
<colgroup><col style="width:120px"><col><col style="width:120px"><col></colgroup>
<tr><th>대출 원금</th><td class="num">{{ f("repay.principal", label="대출원금") }}</td><th>약정이자</th><td class="num">{{ f("repay.interest", label="약정이자") }}</td></tr>
<tr><th>인 지 세</th><td class="num">{{ f("repay.stamp", label="인지세") }}</td><th>근저당 설정비용</th><td class="num">{{ f("repay.setup_cost", label="근저당설정비용") }}</td></tr>
<tr><th>반환 합계</th><td class="num bold">{{ f("repay.total", label="반환합계") }}</td><th>상환 예정일</th><td>{{ f("repay.date", label="상환예정일", fix=0.05) }}</td></tr>
<tr><th>출금 계좌</th><td colspan="3">{{ f("repay.account", label="출금계좌", fix=0.08) }}</td></tr>
</table>

<div class="notice">
<p>1. 대출계약 철회권은 개인 차주가 계약서류를 받은 날 또는 대출금을 받은 날 중 나중의 날부터 <b>14일 이내</b>에 행사할 수 있습니다 (신용대출 4천만원 이하, 담보대출 2억원 이하).</p>
<p>2. 철회 시 대출 원금과 그 기간에 대한 약정이자, 은행이 부담한 인지세·근저당권 설정비용 등 부대비용을 모두 상환하여야 합니다.</p>
<p>3. 철회가 완료되면 해당 대출 기록은 신용정보집중기관에 제공되지 않으며, 중도상환해약금은 부과되지 않습니다.</p>
<p>4. 같은 은행에서는 연 2회, 전 금융기관 기준 1개월에 1회를 초과하여 철회권을 행사하는 경우 신규 대출이 제한될 수 있습니다.</p>
</div>

<p class="lead" style="margin:8px 0 4px">위와 같이 대출계약의 철회를 신청하며, 위 유의사항을 설명 듣고 이해하였습니다.</p>
<div class="center">{{ f("date", label="작성일") }}</div>
<div class="sig">차주&nbsp;<span class="who">{{ f("signature", label="차주") }}</span>{{ m.sigspot("debtor", val("signature"), label="차주", anchor="signature") }}</div>

{{ lp.bank_use(["접수일자", "철회요건 확인", "상환처리", "담당자", "책임자"]) }}
{% endblock %}
