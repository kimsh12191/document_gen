{% extends "_base.html.j2" %}
{% import "_macros.html.j2" as m with context %}
{% import "bank_form/_loan_parts.html.j2" as lp with context %}
{% import "bank_form/_account_common.html.j2" as bf with context %}
{% block style %}
table.bf th, table.bf td { padding: 4px 7px; }
table.bf th { width: 130px; }
{% endblock %}
{% block content %}
{{ lp.css() }}
{{ f.set_corr_name(val("signature")) }}
{% set WAYS = ["근로소득", "사업소득", "임대소득", "연금소득", "기타소득", "담보의 처분(매매, 경매등)"] %}
{{ lp.head(kind="suitability") }}
{{ lp.title_row("적합성·적정성 고객정보 확인서", sub="개인 및 개인사업자용") }}
<div style="margin:0 0 4px">{{ lp.legal_name() }} <b>{{ f("branch", label="취급점") }}</b> 앞</div>

<div class="bf-sec">1. 고객 정보</div>
<table class="bf">
<colgroup><col style="width:130px"><col><col style="width:130px"><col></colgroup>
<tr><th>성　　명</th><td>{{ f("customer.name", label="성명", fix=0.04) }}</td><th>생년월일</th><td>{{ f("customer.birth", label="생년월일", fix=0.05) }}</td></tr>
<tr><th>연 락 처</th><td>{{ f("customer.phone", label="연락처", fix=0.06) }}</td><th>E-mail</th><td>{{ f("customer.email", label="Email", fix=0.05) }}</td></tr>
<tr><th>주　　소</th><td colspan="3">{{ f("customer.address", label="주소", fix=0.04) }}</td></tr>
<tr><th>후견인 여부</th><td colspan="3">{{ m.choice("guardian", ["해당사항 없음", "피성년후견인", "피한정후견인"], label="후견인여부") }}{{ lp.nochk("guardian") }}</td></tr>
</table>

<div class="bf-sec">2. 적합성·적정성 판단 정보 (고객 기재)</div>
<table class="bf">
<colgroup><col style="width:130px"><col></colgroup>
<tr><th>대출 용도</th><td>{{ m.choice("purpose", ["가계자금", "사업자금", "주택자금", "경조자금", "교육비", "의료비", "타 기관 대출금 상환", "기타"], label="대출용도") }}{{ lp.nochk("purpose") }}</td></tr>
<tr><th>총자산규모<br><span class="tiny">(순자산)</span></th><td>{{ m.choice("assets", ["자산없음", "1억원 미만", "1억원 ~ 5억원", "5억원 이상"], label="총자산규모") }}{{ lp.nochk("assets") }}</td></tr>
<tr><th>담보제공 계획</th><td>{{ m.choice("collateral_plan", ["없음", "있음"], label="담보제공계획") }}</td></tr>
<tr><th>연간소득<br><span class="tiny">(가족소득 포함)</span></th><td>{{ m.choice("income", ["소득없음", "5천만원 미만", "5천만원 이상 1억원 미만", "1억원 이상"], label="연간소득") }}{{ lp.nochk("income") }}</td></tr>
<tr><th>부　　채</th><td>{{ m.choice("debt", ["부채없음 (잘 모름 포함)", "5천만원 미만", "5천만원 이상 1억원 미만", "1억원 이상"], label="부채") }}{{ lp.nochk("debt") }}</td></tr>
<tr><th>연체 여부</th><td>{{ m.choice("overdue", ["연체정보 없음", "연체정보 있음"], label="연체여부") }}</td></tr>
<tr><th>신용점수</th><td>{{ f("credit_score", label="신용점수") }}</td></tr>
<tr><th>변제 방법</th><td>{{ bf.multi("repay_ways", WAYS, label="변제방법") }}</td></tr>
</table>

<div class="bf-sec">3. 은행 기재란</div>
<table class="bf">
<colgroup><col style="width:130px"><col><col style="width:130px"><col></colgroup>
<tr><th>기거래 건전성</th><td>{{ f("bank_use.soundness", label="기거래건전성") }}</td><th>신용 상태</th><td>{{ f("bank_use.credit_state", label="신용상태") }}</td></tr>
<tr><th>상환능력 및<br>변제계획</th><td colspan="3">{{ f("bank_use.plan_review", label="상환능력및변제계획") }}</td></tr>
</table>

<div class="notice">
<p>1. 귀 행에 제공한 적합성·적정성 관련 정보는 본인의 재산상황, 용도 등의 정보를 정확히 알려드린 것입니다.</p>
<p>2. 본인은 위 정보가 대출의 적합성·적정성 판단 목적으로만 이용됨을 확인합니다.</p>
<p>3. 본인은 제공한 정보가 부정확할 경우, 대출심사 및 대출계약 이후 불이익을 받을 수 있음을 확인합니다.</p>
<p>4. 본인에게 적합하지 않은 것으로 판단되는 경우 대출 권유가 제한될 수 있음을 안내받았습니다.</p>
<p>5. 위 적합성·적정성 판단을 위한 고객정보 수집·이용에 동의합니다.</p>
</div>

<div class="center">{{ f("date", label="작성일") }}</div>
<div class="sig">고객&nbsp;<span class="who">{{ f("signature", label="고객") }}</span>{{ m.sigspot("customer", val("signature"), label="고객", anchor="signature") }}</div>

{{ lp.bank_use(["작성일자", "적합성 판단", "적정성 판단", "담당자", "책임자"]) }}
{% endblock %}
