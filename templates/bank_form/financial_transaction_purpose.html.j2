{% extends "_base.html.j2" %}
{% import "_macros.html.j2" as m with context %}
{% import "bank_form/_account_common.html.j2" as bf with context %}
{% block page_class %} dense{% endblock %}
{% block style %}{{ bf.css() }}
table.ftp th { width: 96px; }
table.bf th, table.bf td { padding: 3px 7px; }
table.ex td { font-size: calc(var(--fs) - 2.5px); padding: 1px 6px; }
table.qa td.a { width: 128px; text-align: center; }
.warn { border: 2px solid var(--seal); padding: 5px 9px; margin: 6px 0; }
.warn .h { color: var(--seal); font-weight: 800; font-size: calc(var(--fs) + 1px); margin-bottom: 2px; }
.warn p { margin: 1px 0; font-size: calc(var(--fs) - 2px); }
{% endblock %}
{% block content %}
{{ bf.head("입출금이 자유로운 예금 신규용<br>보존기간: 거래종료 후 5년") }}
{{ m.title("금융거래목적확인서") }}
<div class="bf-box bf-note">
  <p>전기통신금융사기(보이스피싱) 피해 예방을 위하여 「전기통신금융사기 피해 방지 및 피해금 환급에 관한 특별법」에 따라 입출금이 자유로운 예금 계좌를 신규 개설하시는 고객의 금융거래 목적을 확인하오니 아래 사항을 기재하여 주시기 바랍니다.</p>
  <p>※ 금융거래 목적을 확인할 수 있는 증빙서류를 제출하지 않거나 목적이 확인되지 않는 경우 계좌 개설이 거절되거나 <b>금융거래한도계좌</b>로 개설될 수 있습니다.</p>
</div>

{{ bf.sec("1", "고객 정보") }}
<table class="bf ftp">
<tr><th>성　명</th><td>{{ f("customer.name", label="성명") }}</td><th>실명번호</th><td>{{ f("customer.rrn", label="실명번호") }}</td></tr>
<tr><th>주　소</th><td colspan="3">{{ f("customer.address", label="주소") }}</td></tr>
<tr><th>연락처</th><td>{{ f("customer.mobile", label="연락처") }}</td><th>직　업</th><td>{{ f("customer.job", label="직업") }}{% if d.customer.company is defined %} / {{ f("customer.company", label="직장명") }}{% endif %}</td></tr>
<tr><th>신규 예금</th><td colspan="3">{{ m.choice("account_type", ["보통예금", "저축예금", "기타 입출금예금"], label="신규예금종류") }}</td></tr>
</table>

{{ bf.sec("2", "금융거래 목적 및 증빙서류") }}
<table class="bf ftp">
<tr><th>금융거래 목적</th><td>
  {{ m.choice("purpose", ["급여계좌", "사업자 거래", "공과금 이체", "모임 회비", "아르바이트", "기타"], label="금융거래목적") }}
  {% if d.purpose_detail is defined %}<span>( {{ f("purpose_detail", label="기타금융거래목적") }} )</span>{% else %}<span class="muted">(&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;)</span>{% endif %}
</td></tr>
<tr><th>제출 증빙서류</th><td>{{ f("evidence", label="제출증빙서류") }}</td></tr>
</table>
<table class="bf compact ex" style="margin-top:2px">
<colgroup><col style="width:96px"><col></colgroup>
<tr><th>거래목적</th><th>증빙서류 예시 (발급일로부터 3개월 이내 서류)</th></tr>
<tr><td class="c">급여계좌</td><td>재직증명서, 근로소득원천징수영수증, 급여명세서, 건강보험 자격득실확인서, 공무원증 등 관공서 발급 신분증</td></tr>
<tr><td class="c">사업자 거래</td><td>사업자등록증(명), 물품공급계약서, 전자세금계산서(공급자용), 부가가치세 과세표준증명, 납세증명서</td></tr>
<tr><td class="c">공과금 이체</td><td>공과금 납입영수증, 관리비 고지서 등 (본인 명의)</td></tr>
<tr><td class="c">모임 회비</td><td>모임 회칙, 구성원(회원) 명부</td></tr>
<tr><td class="c">아르바이트</td><td>근로계약서, 급여명세서, 고용주의 사업자등록증 사본</td></tr>
</table>

{{ bf.sec("3", "확인 사항") }}
<table class="bf qa">
<tr><th>확인 내용</th><th>답변</th></tr>
<tr><td class="q">① 타인으로부터 통장 개설을 요청받거나, 통장(카드)을 양도·대여하는 대가로 금전 등을 받기로 하셨습니까?</td>
    <td class="a">{{ m.choice("questions.q1", ["예", "아니오"], label="통장양도대여요청여부") }}</td></tr>
<tr><td class="q">② 취업 또는 대출을 해주겠다며 통장·체크카드·비밀번호 등을 보내 달라는 요청을 받으셨습니까?</td>
    <td class="a">{{ m.choice("questions.q2", ["예", "아니오"], label="취업대출빙자요청여부") }}</td></tr>
<tr><td class="q">③ 최근 20영업일 이내에 다른 금융회사에서 입출금계좌를 개설하신 사실이 있습니까?</td>
    <td class="a">{{ m.choice("questions.q3", ["예", "아니오"], label="최근타행계좌개설여부") }}</td></tr>
</table>

<div class="warn">
  <div class="h">⚠ 대포통장 관련 주의사항</div>
  <p>• 통장·체크카드·OTP 등 접근매체를 타인에게 양도·대여하거나 대가를 받고 빌려주는 행위는 「전자금융거래법」 제49조에 따라 <b>5년 이하의 징역 또는 3천만원 이하의 벌금</b>에 처해질 수 있습니다.</p>
  <p>• 대포통장 명의인으로 등록되면 「전기통신금융사기 피해 방지 및 피해금 환급에 관한 특별법」에 따라 <b>최장 12년간 신규 계좌 개설 및 비대면 금융거래가 제한</b>되고, 금융질서문란행위자로 등록될 수 있습니다.</p>
  <p>• 금융거래 목적 확인을 위해 제출한 서류가 허위로 판명되는 경우 계좌 거래가 정지·해지될 수 있습니다.</p>
</div>

<div class="bf-note">본인은 위 내용을 충분히 설명 듣고 이해하였으며, 기재한 금융거래 목적 및 확인 사항이 사실과 다름없음을 확인합니다.</div>
<div class="bf-sign">
  <span>{{ f("date", label="작성일") }}</span>
  <span>고객 성명 <span class="who">{{ f("signature", label="고객성명") }}</span> (서명 또는 인)</span>
</div>
<div class="right bold">{{ f("bank.name", label="은행명") }} 귀중</div>

<div class="bf-use">
  <div class="cap">은행 사용란</div>
  <div class="body">
    <table class="bf" style="flex:1">
      <tr><th style="width:96px">처리 결과</th><td>{{ m.choice("bank_use.result", ["일반계좌 개설", "금융거래한도계좌 개설", "개설 거절"], label="처리결과") }}</td></tr>
      <tr><th>한도계좌 안내</th><td>한도계좌: 1일 인터넷뱅킹 100만원, ATM 100만원, 창구 300만원 이내 / 증빙서류 제출 시 한도 해제 가능</td></tr>
    </table>
    {{ bf.stamps([["담당", "bank_use.clerk"], ["책임자", "bank_use.manager"]]) }}
  </div>
</div>
{% endblock %}
