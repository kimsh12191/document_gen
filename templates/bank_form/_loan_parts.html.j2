{#
  bank_form_loan.py 서식 전용 공통 조각. 템플릿에서:
    {% import "bank_form/_loan_parts.html.j2" as lp with context %}
#}
{% import "_macros.html.j2" as m with context %}

{% macro css() -%}
<style>
.page.a4 { padding-top: min(var(--page-pad), 44px); padding-bottom: min(var(--page-pad), 36px); }
.bf-head { display: flex; justify-content: space-between; align-items: flex-end; border-bottom: 2px solid var(--accent); padding-bottom: 4px; margin-bottom: 8px; }
.bf-bank { font-size: calc(var(--fs) + 5px); font-weight: 800; color: var(--accent); letter-spacing: .04em; display: flex; align-items: center; gap: 6px; }
.bf-bank .mk { display: inline-block; width: 16px; height: 16px; border: 3px solid var(--accent); border-radius: 50%; }
.bf-code { font-size: calc(var(--fs) - 3px); color: #444; text-align: right; line-height: 1.3; }
.bf-titlerow { display: flex; justify-content: space-between; align-items: center; gap: 10px; margin: 2px 0 6px; }
.bf-sub { font-size: calc(var(--fs) + 1px); letter-spacing: .05em; font-weight: 400; color: #444; }
.bf-titlerow h1.title { margin: 4px 0; text-align: left; flex: 1; }
table.appr { width: auto; margin: 0; }
table.appr th, table.appr td { padding: 1px 4px; font-size: calc(var(--fs) - 3px); text-align: center; }
table.appr td { width: 50px; height: 40px; }
.bf-sec { font-size: calc(var(--fs) + 0.5px); font-weight: 700; margin: 7px 0 2px; color: var(--accent); }
.bf-sec::before { content: "■ "; }
table.bf { margin: 3px 0; }
table.bf th, table.bf td { padding: 3px 6px; }
table.bf th { text-align: left; }
table.bf table.compact th { text-align: center; }
.bf-use { border: 1.5px dashed #777; padding: 4px 8px; margin-top: 12px; }
.bf-use .t { font-size: calc(var(--fs) - 2px); font-weight: 700; margin-bottom: 2px; }
.bf-use table { margin: 0; }
.bf-use th, .bf-use td { font-size: calc(var(--fs) - 2.5px); padding: 2px 4px; }
.bf-use td { height: 30px; }
.hand { font-family: 'NanumSquareRound', 'Nanum Gothic', sans-serif; color: #1c2c86; font-weight: 700; letter-spacing: .03em; display: inline-block; transform: rotate(-0.8deg); }
.lead { margin: 4px 0; text-indent: .5em; }
.notice { font-size: calc(var(--fs) - 2.5px); color: #333; margin: 3px 0; line-height: 1.35; }
.notice p { margin: 1px 0; padding-left: 1em; text-indent: -1em; }
.sig { display: flex; justify-content: flex-end; align-items: center; gap: 6px; margin-top: 6px; }
.inmark { position: relative; display: inline-block; min-width: 34px; text-align: center; }
.inmark .seal { position: absolute; left: 50%; top: 50%; transform: translate(-50%, -50%) rotate(-8deg); margin: 0; }
.sig .who { min-width: 90px; text-align: center; font-size: calc(var(--fs) + 1px); }
</style>
{%- endmacro %}

{#
  서식별 관리번호. 실제 은행 서식 상단 줄 표기를 은행별로 흉내 낸다.
    하나:  "5-16-0178(2-1) (2016.03 개정) (보존년한 : 완제일로부터 5년)"
    신한:  "(2021. 01 개정) (2-1) 3-202-0032(21.0×29.7) 백상지100g/㎡"
    국민:  "E009-206(210×297) NCR지 (2023. 11 개정) K11 (5-1)"
  kind → [하나 코드, 신한 코드, 국민 코드, 기타 은행 코드, 총 페이지수, 보존년한, 개정년월, 용지]
#}
{% set FORMS = {
  "loan_app":      ["5-16-0178", "3-202-0032", "E009-101", "여신-1101", 2, 5,  "2025.01", "백상지100g/㎡"],
  "loan_app_corp": ["5-16-0152", "5-204-0351", "E011-102", "기업-2101", 2, 10, "2025.03", "백상지80g/㎡"],
  "agree":         ["3-06-1104", "4-202-0190", "E009-206", "여신-1201", 5, 10, "2025.04", "NCR용지74g/㎡"],
  "agree_corp":    ["3-06-0201", "4-201-0207", "E011-204", "기업-2201", 4, 10, "2025.04", "NCR용지74g/㎡"],
  "mortgage":      ["3-06-1040", "4-202-0230", "E010-310", "여신-1301", 4, 10, "2024.10", "NCR용지74g/㎡"],
  "guarantee":     ["3-06-1062", "4-202-0215", "E010-402", "여신-1401", 4, 10, "2024.10", "NCR용지74g/㎡"],
  "cms":           ["5-11-0310", "1-202-0061", "E007-115", "수신-0715", 1, 5,  "2024.07", "백상지80g/㎡", "해지"],
} %}

{% macro form_line(kind) -%}
{% set F = FORMS[kind] %}{% set rev = F[6] %}{% set base = F[8] if F|length > 8 else "완제" %}{% set rev_sp = rev[:4] ~ ". " ~ rev[5:] %}
{%- if d.bank == "하나은행" -%}{{ F[0] }}({{ F[4] }}-1) ({{ rev }} 개정) (보존년한 : {{ base }}일로부터 {{ F[5] }}년)
{%- elif d.bank == "신한은행" -%}({{ rev_sp }} 개정) ({{ F[4] }}-1) {{ F[1] }}(21.0×29.7) {{ F[7] }}
{%- elif d.bank == "국민은행" -%}{{ F[2] }}(210×297) {{ "NCR지" if "NCR" in F[7] else "백상지" }} ({{ rev_sp }} 개정) K11 ({{ F[4] }}-1)
{%- else -%}{{ F[3] }} ({{ F[4] }}-1) ({{ rev }} 개정) (보존기한 : {{ base }} 후 {{ F[5] }}년)
{%- endif -%}
{%- endmacro %}

{# 은행 법인 명칭 (표시 전용, GT 아님) #}
{% macro legal_name() -%}
{{ {"농협은행": "농협은행 주식회사", "기업은행": "중소기업은행", "SC제일은행": "주식회사 한국스탠다드차타드은행"}.get(d.bank, "주식회사 " ~ d.bank) }}
{%- endmacro %}

{# 은행별 결재(검인)란 칸 이름 #}
{% macro appr_boxes() -%}
{%- if d.bank == "하나은행" -%}{{ ["담당", "책임자", "관리자", "부점장"]|join("|") }}
{%- elif d.bank == "신한은행" -%}{{ ["담당자", "확인자"]|join("|") }}
{%- elif d.bank == "SC제일은행" -%}{{ ["계/대리/과장", "차장/팀장", "부점장"]|join("|") }}
{%- else -%}{{ ["담 당", "책임자"]|join("|") }}
{%- endif -%}
{%- endmacro %}

{# 상단 은행명 + 서식번호. code 대신 kind(FORMS 키)를 주면 은행별 관리번호 표기 #}
{% macro head(code=None, sub="", kind=None) -%}
<div class="bf-head">
  <div class="bf-bank"><span class="mk"></span>{{ f("bank", label="은행명") }}</div>
  <div class="bf-code">{% if kind %}{{ form_line(kind) }}{% else %}{{ code }}{% endif %}{% if sub %}<br>{{ sub }}{% endif %}</div>
</div>
{%- endmacro %}

{# 제목 + 결재란. boxes 를 주지 않으면 은행별 기본 칸 #}
{% macro title_row(text, sub=None, boxes=None) -%}
{% set boxes = boxes or appr_boxes().split("|") %}
<div class="bf-titlerow">
  <h1 class="title">{{ text }}{% if sub %} <span class="bf-sub">{{ sub }}</span>{% endif %}</h1>
  <table class="appr"><tr>{% for b in boxes %}<th>{{ b }}</th>{% endfor %}</tr>
  <tr>{% for b in boxes %}<td></td>{% endfor %}</tr></table>
</div>
{%- endmacro %}

{# "(인)" 표시 위에 도장 #}
{% macro in_seal(text=None, size="sm", square=False, mark="(인)") -%}
<span class="inmark">{{ mark }}{% if text %}{{ m.seal(text, square=square, size=size) }}{% endif %}</span>
{%- endmacro %}

{# 하단 은행 사용란 #}
{% macro bank_use(cols=("접수일자", "접수번호", "실명확인", "담당자", "책임자"), title="은행 사용란") -%}
<div class="bf-use">
  <div class="t">※ {{ title }} (고객은 기재하지 마십시오)</div>
  <table><tr>{% for c in cols %}<th>{{ c }}</th>{% endfor %}</tr>
  <tr>{% for c in cols %}<td>{% if c in ("담당자", "책임자", "담당", "검인") %}<span class="muted tiny">(인)</span>{% endif %}</td>{% endfor %}</tr></table>
</div>
{%- endmacro %}
