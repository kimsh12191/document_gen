{% macro articles(kind, start) -%}
{% for a in ARTICLES[kind] %}
<div style="display:flex;flex-direction:column"><div class="art">제{{ start + loop.index0 }}조({{ a[0] }})</div>
<div class="small" style="margin:0 0 0 8px">{{ a[1] }}</div></div>
{% endfor %}
{%- endmacro %}

{# 특약사항 (data.special_terms 가 있을 때). 은행이 입력·출력한 문구 #}
{% macro special_terms(no, who="본인") -%}
{% if d.special_terms is defined %}
<div style="display:flex;flex-direction:column"><div class="art">제{{ no }}조(특약사항)</div>
<div class="small" style="margin:0 0 2px 8px">{{ who }}은(는) 위 각 조항 외에 다음 특약사항을 확약합니다.</div></div>
<div class="sp-terms">
{% for t in d.special_terms %}<div class="small sp-term">{{ loop.index }}. {{ f("special_terms." ~ loop.index0, label="특약사항") }}</div>
{% endfor %}
</div>
<style>.sp-terms { margin: 0 0 0 8px; } .sp-term { padding-left: 1.2em; text-indent: -1.2em; margin: 1px 0; }</style>
{% endif %}
{%- endmacro %}

{# 체크 누락(아무 보기도 체크 안 됨): m.choice 는 data-field 를 남기지 않으므로 빈 위치 표시를 단다 (정답 null) #}
{% macro nochk(path) -%}
{% if path in f.fields and not f.has(path) %}{{ f(path) }}{% endif %}
{%- endmacro %}
