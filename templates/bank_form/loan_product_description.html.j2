{% extends "_base.html.j2" %}
{% import "_macros.html.j2" as m with context %}
{% import "bank_form/_loan_parts.html.j2" as lp with context %}
{% block style %}
table.bf th, table.bf td { padding: 4px 7px; }
.num-h { font-weight: 700; margin: 7px 0 2px; color: var(--accent); }
.hand-box { border: 1px solid var(--border); padding: 6px 10px; margin: 5px 0; }
{% endblock %}
{% block content %}
{{ lp.css() }}
{{ f.set_corr_name(val("signature")) }}
{{ lp.head(kind="loan_desc") }}
{{ lp.cont_head("loan_desc") }}
{{ lp.title_row("대출상품설명서", sub="권유용") }}
<div class="small" style="margin:0 0 4px">이 설명서는 「금융소비자 보호에 관한 법률」 제19조에 따라 대출 권유 단계에서 교부하는 서류입니다.</div>

<div class="num-h">1. 고객 및 상품 개요</div>
<table class="bf">
<colgroup><col style="width:120px"><col><col style="width:120px"><col></colgroup>
<tr><th>성　　명</th><td>{{ f("customer.name", label="성명", fix=0.04) }}</td><th>생년월일</th><td>{{ f("customer.birth", label="생년월일", fix=0.05) }}</td></tr>
<tr><th>연 락 처</th><td>{{ f("customer.phone", label="연락처", fix=0.06) }}</td><th>취 급 점</th><td>{{ f("branch", label="취급점") }}</td></tr>
<tr><th>상 품 명</th><td>{{ f("product.name", label="상품명") }}</td><th>여신 과목</th><td>{{ f("product.subject", label="여신과목") }}</td></tr>
<tr><th>대출 금액</th><td class="num">{{ f("product.amount", label="대출금액") }}</td><th>대출 용도</th><td>{{ f("product.purpose", label="대출용도") }}</td></tr>
<tr><th>대출 기간</th><td>{{ f("product.term", label="대출기간") }}</td><th>상환 방법</th><td>{{ f("product.repayment", label="상환방법") }}</td></tr>
<tr><th>대출 실행일</th><td>{{ f("product.start_date", label="대출실행일", fix=0.05) }}</td><th>만 기 일</th><td>{{ f("product.maturity", label="만기일", fix=0.05) }}</td></tr>
<tr><th>담보 구분</th><td colspan="3">{{ f("product.collateral", label="담보구분") }}</td></tr>
</table>

<div class="num-h">2. 대출이자율</div>
<table class="bf">
<colgroup><col style="width:120px"><col><col style="width:120px"><col></colgroup>
<tr><th>금리 방식</th><td>{{ f("rate.type", label="금리방식") }}</td><th>기준금리 종류</th><td>{{ f("rate.base_name", label="기준금리종류") }}</td></tr>
<tr><th>기준금리</th><td class="num">{{ f("rate.base", label="기준금리") }}</td><th>가산금리</th><td class="num">{{ f("rate.spread", label="가산금리") }}</td></tr>
<tr><th>우대금리</th><td class="num">{{ f("rate.pref", label="우대금리") }}</td><th>최종 적용금리</th><td class="num bold">{{ f("rate.applied", label="최종적용금리") }}</td></tr>
<tr><th>연체이자율</th><td colspan="3">{{ f("rate.late", label="연체이자율") }}</td></tr>
</table>
<div class="tiny muted">※ 최종 적용금리 = 기준금리 + 가산금리 − 우대금리. 변동금리의 경우 기준금리 변동 주기마다 적용금리가 바뀝니다.</div>

<div class="num-h">3. 금리인하요구권</div>
<div class="notice"><p>{{ f("rate_cut", label="금리인하요구권") }}</p></div>

<div class="num-h">4. 수수료 등 비용</div>
{{ m.grid(["구분", "내용"], "fees", ["name", "amount"], widths=["28%", "72%"], cls="compact") }}
<div class="tiny muted">※ 중도상환해약금 면제 : {{ f("prepay_free", label="중도상환해약금면제") }}</div>

<div class="num-h">5. 대출계약 철회권</div>
<div class="notice"><p>{{ f("withdraw", label="대출계약철회권") }}</p></div>

<div class="num-h">6. 유의사항 (위험 고지)</div>
<div class="notice">
{% for x in d.risks %}<p>{{ loop.index }}) {{ f("risks." ~ loop.index0, label="유의사항") }}</p>
{% endfor %}
</div>

<div class="num-h">7. 설명 확인</div>
<div class="hand-box">
<span class="small">[ 고객 자필기재 ]</span>&nbsp;&nbsp;<span class="hand">{{ f("handwritten", label="자필기재") }}</span>
</div>
<div class="small">본인은 위 상품의 내용과 위험에 관하여 설명을 듣고 이해하였으며, 이 설명서를 교부받았음을 확인합니다.
설명을 제대로 이해하지 못한 상태에서 이해하였다는 기재를 하는 경우 분쟁 발생 시 권리구제가 어려울 수 있습니다.</div>

<div class="center" style="margin-top:6px">{{ f("date", label="작성일") }}</div>
<div class="sig">설명한 직원&nbsp;<span class="who">{{ f("explained_by", label="설명한직원") }}</span>{{ lp.in_seal(val("explained_by"), key="staff.explainer", kind="행원인", anchor="explained_by") }}</div>
<div class="sig">고객&nbsp;<span class="who">{{ f("signature", label="고객") }}</span>{{ m.sigspot("customer", val("signature"), label="고객", anchor="signature") }}</div>

{{ lp.bank_use(["설명일자", "설명방법", "녹취 여부", "담당자", "책임자"]) }}
{% endblock %}
