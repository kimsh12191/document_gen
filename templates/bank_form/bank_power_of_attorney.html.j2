{% extends "_base.html.j2" %}
{% import "_macros.html.j2" as m with context %}
{% import "bank_form/_loan_parts.html.j2" as lp with context %}
{% import "bank_form/_account_common.html.j2" as bf with context %}
{% block style %}
table.bf th, table.bf td { padding: 6px 8px; }
.hand-box { border: 1px solid var(--border); padding: 6px 10px; margin: 4px 0; }
{% endblock %}
{% block content %}
{{ lp.css() }}
{{ f.set_corr_name(val("signature")) }}
{% set SCOPE = ["신규계좌 개설", "비밀번호 변경", "통장·인감 분실신고", "계좌해지",
                "제신고(주소·연락처)", "잔액증명서 발급", "통장 재발급"] %}
{{ lp.head(kind="poa") }}
{{ lp.title_row("위 임 장", sub="예금 거래 대리") }}
<div style="margin:0 0 4px">{{ lp.legal_name() }} <b>{{ f("branch", label="취급점") }}</b> 앞</div>

<div class="bf-sec">1. 위임인 (예금주)</div>
<table class="bf">
<colgroup><col style="width:120px"><col><col style="width:120px"><col></colgroup>
<tr><th>성　　명</th><td>{{ f("grantor.name", label="위임인", fix=0.04) }}</td><th>생년월일</th><td>{{ f("grantor.birth", label="위임인생년월일", fix=0.05) }}</td></tr>
<tr><th>연 락 처</th><td>{{ f("grantor.phone", label="위임인연락처", fix=0.06) }}</td><th>계좌번호</th><td>{{ f("account", label="계좌번호", fix=0.08) }}</td></tr>
<tr><th>주　　소</th><td colspan="3">{{ f("grantor.address", label="위임인주소", fix=0.04) }}</td></tr>
</table>

<div class="bf-sec">2. 대리인 (수임인)</div>
<table class="bf">
<colgroup><col style="width:120px"><col><col style="width:120px"><col></colgroup>
<tr><th>성　　명</th><td>{{ f("agent.name", label="대리인", fix=0.04) }}</td><th>생년월일</th><td>{{ f("agent.birth", label="대리인생년월일", fix=0.05) }}</td></tr>
<tr><th>본인과의 관계</th><td>{{ f("agent.relation", label="본인과의관계") }}</td><th>연 락 처</th><td>{{ f("agent.phone", label="대리인연락처", fix=0.06) }}</td></tr>
<tr><th>주　　소</th><td colspan="3">{{ f("agent.address", label="대리인주소", fix=0.04) }}</td></tr>
</table>

<div class="bf-sec">3. 위임 사항</div>
<table class="bf">
<colgroup><col style="width:120px"><col></colgroup>
<tr><th>위임 범위</th><td>{{ bf.multi("scope", SCOPE, label="위임범위") }}</td></tr>
<tr><th>예금 종류</th><td>{{ m.choice("product", ["입출금이 자유로운 예금", "정기예금", "적금", "기타"], label="예금종류") }}{{ lp.nochk("product") }}</td></tr>
<tr><th>세부 내용</th><td>{{ m.choice("detail", ["비밀번호 변경", "통장/인감 분실", "계좌해지", "기타"], label="세부내용") }}{{ lp.nochk("detail") }}</td></tr>
<tr><th>기타 사항</th><td>{{ f("detail_etc", label="기타사항") }}</td></tr>
<tr><th>위임 유효기간</th><td>{{ f("valid_until", label="위임유효기간", fix=0.05) }} 까지</td></tr>
</table>

<div class="hand-box">
<span class="small">[ 위임인 자필기재 ]</span>&nbsp;&nbsp;<span class="hand">{{ f("handwritten", label="자필기재") }}</span>
</div>

<div class="notice">
<p>※ 위임장에는 위임인의 인감(서명)을 날인하고, 인감증명서 또는 본인서명사실확인서(발급일로부터 3개월 이내)를 첨부하여야 합니다.</p>
<p>※ 대리인은 신분증을 지참하여야 하며, 은행은 위임 사실을 위임인에게 확인할 수 있습니다.</p>
<p>※ 위임 범위를 벗어난 거래는 처리되지 않습니다.</p>
</div>

<p class="lead" style="margin:8px 0 4px">위임인은 위 대리인에게 위 위임사항에 관한 일체의 권한을 위임합니다.</p>
<div class="center">{{ f("date", label="작성일") }}</div>
<div class="sig">위임인&nbsp;<span class="who">{{ f("signature", label="위임인") }}</span>{{ m.sigspot("grantor", val("signature"), label="위임인", anchor="signature") }}</div>
<div class="sig">대리인&nbsp;<span class="who">{{ f("agent_signature", label="대리인") }}</span>{{ m.sigspot("agent", val("agent_signature"), label="대리인", anchor="agent_signature") }}</div>

{{ lp.bank_use(["접수일자", "위임 확인", "실명확인", "담당자", "책임자"]) }}
{% endblock %}
