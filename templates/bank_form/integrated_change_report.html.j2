{% extends "_base.html.j2" %}
{% import "_macros.html.j2" as m with context %}
{% import "bank_form/_loan_parts.html.j2" as lp with context %}
{% import "bank_form/_account_common.html.j2" as bf with context %}
{% block style %}
table.bf th, table.bf td { padding: 5px 7px; }
.chk { margin-right: 10px; }
{% endblock %}
{% block content %}
{{ lp.css() }}
{{ f.set_corr_name(val("signature")) }}
{% set LABELS = {"address": "주　　소", "phone": "연 락 처", "seal": "인감(서명)", "note": "변경 항목"} %}
{% set ITEMS = ["주소 변경", "연락처 변경", "인감(서명) 변경", "비밀번호 변경", "통장 재발급",
                "성명(상호) 변경", "통장 분실신고", "E-mail 변경"] %}
{{ lp.head(kind="change_report") }}
{{ lp.cont_head("change_report") }}
{{ lp.title_row("통 합 제 신 고 서", sub="예금 거래 신고사항 변경") }}
<div style="margin:0 0 4px">{{ lp.legal_name() }} <b>{{ f("branch", label="취급점") }}</b> 앞</div>

<div class="bf-sec">1. 신고인</div>
<table class="bf">
<colgroup><col style="width:120px"><col><col style="width:120px"><col></colgroup>
<tr><th>성　　명</th><td>{{ f("customer.name", label="성명", fix=0.04) }}</td><th>생년월일</th><td>{{ f("customer.birth", label="생년월일", fix=0.05) }}</td></tr>
<tr><th>계좌(카드)번호</th><td>{{ f("account", label="계좌(카드)번호", fix=0.08) }}</td><th>연 락 처</th><td>{{ f("customer.phone", label="연락처", fix=0.06) }}</td></tr>
<tr><th>주　　소</th><td colspan="3">{{ f("customer.address", label="주소", fix=0.04) }}</td></tr>
</table>

<div class="bf-sec">2. 신고 내용</div>
<table class="bf">
<colgroup><col style="width:120px"><col></colgroup>
<tr><th>신고 항목</th><td>{{ bf.multi("items", ITEMS, label="신고항목") }}</td></tr>
</table>

<div class="bf-sec">3. 변경 전 · 후</div>
<table class="bf">
<colgroup><col style="width:120px"><col><col style="width:120px"><col></colgroup>
<tr><th>구　　분</th><th class="c">변 경 전</th><th>구　　분</th><th class="c">변 경 후</th></tr>
{% for k in d.before %}
<tr><th>{{ LABELS[k] }}</th><td>{{ f("before." ~ k, label="변경전 " ~ LABELS[k], fix=0.04) }}</td>
    <th>{{ LABELS[k] }}</th><td>{{ f("after." ~ k, label="변경후 " ~ LABELS[k], fix=0.04) }}</td></tr>
{% endfor %}
</table>

<div class="bf-sec">4. 휴대전화 정보</div>
<table class="bf">
<colgroup><col style="width:120px"><col><col style="width:120px"><col></colgroup>
<tr><th>단말기 구분</th><td>{{ m.choice("phone_kind", ["스마트폰", "일반폰", "알뜰폰"], label="단말기구분") }}{{ lp.nochk("phone_kind") }}</td>
    <th>통 신 사</th><td>{{ m.choice("carrier", ["SKT", "KT", "LGU+", "기타"], label="통신사") }}{{ lp.nochk("carrier") }}</td></tr>
<tr><th>수령 방법</th><td colspan="3">{{ m.choice("receive", ["창구수령", "등기우편", "수령 생략"], label="수령방법") }}</td></tr>
</table>

{% if d.agent is defined %}
<div class="bf-sec">5. 대리인</div>
<table class="bf">
<colgroup><col style="width:120px"><col><col style="width:120px"><col></colgroup>
<tr><th>대리인 성명</th><td>{{ f("agent.name", label="대리인성명", fix=0.04) }}</td><th>생년월일</th><td>{{ f("agent.birth", label="대리인생년월일", fix=0.05) }}</td></tr>
<tr><th>본인과의 관계</th><td colspan="3">{{ f("agent.relation", label="본인과의관계") }}</td></tr>
</table>
{% endif %}

<div class="notice">
<p>※ 인감(서명) 변경 시에는 신분증과 기존 인감(서명)을 함께 지참하여야 합니다.</p>
<p>※ 신고사항 변경을 게을리하여 은행이 신고된 주소로 발송한 통지가 도달하지 아니한 때에는 보통의 우송기간이 지난 때에 도달한 것으로 봅니다.</p>
</div>

<p class="lead" style="margin:8px 0 4px">위와 같이 신고사항의 변경을 신고합니다.</p>
<div class="center">{{ f("date", label="작성일") }}</div>
<div class="sig">신고인&nbsp;<span class="who">{{ f("signature", label="신고인") }}</span>{{ m.sigspot("applicant", val("signature"), label="신고인", anchor="signature") }}</div>

{{ lp.bank_use(["접수일자", "실명확인", "전산등록", "담당자", "책임자"]) }}
{% endblock %}
