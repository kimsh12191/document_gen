{% extends "_base.html.j2" %}
{% import "_macros.html.j2" as m with context %}
{% import "bank_form/_account_common.html.j2" as bf with context %}
{% block page_class %} dense{% endblock %}
{% block style %}{{ bf.css() }}
table.orm th { width: 112px; }
table.orm td { font-variant-numeric: tabular-nums; }
.amt { font-weight: 700; font-size: calc(var(--fs) + 2px); letter-spacing: .02em; }
{% endblock %}
{% block content %}
{{ bf.head("(2-1) 외환 · 당발송금<br>(보존년한: 처리일로부터 5년)") }}
{{ m.title("외화송금신청서", sub="APPLICATION FOR OUTWARD REMITTANCE") }}
<div class="bf-note">※ 수취인·수취은행 정보는 영문 대문자로 정확히 작성하여 주십시오.</div>

{{ bf.sec("1", "신청인(송금인)", "Applicant") }}
<table class="bf orm">
<tr><th>성명<span class="en">Name</span></th><td>{{ f("remitter.name", label="송금인성명") }}</td><th>영문명<span class="en">English Name</span></th><td>{{ f("remitter.name_en", label="송금인영문명") }}</td></tr>
<tr><th>실명번호<span class="en">ID No.</span></th><td>{{ f("remitter.rrn", label="실명번호") }}</td><th>전화번호<span class="en">Tel No.</span></th><td>{{ f("remitter.phone", label="전화번호") }}</td></tr>
<tr><th>주소<span class="en">Address</span></th><td colspan="3">{{ f("remitter.address", label="송금인주소") }}</td></tr>
{% if d.remitter.company is defined %}<tr><th>상호(사업자번호)<span class="en">Company</span></th><td colspan="3">{{ f("remitter.company", label="상호(사업자번호)") }}</td></tr>{% endif %}
</table>

{{ bf.sec("2", "수취인", "Beneficiary") }}
<table class="bf orm">
<tr><th>성명(상호)<span class="en">Name</span></th><td colspan="3">{{ f("beneficiary.name", label="수취인성명") }}</td></tr>
<tr><th>주소<span class="en">Address</span></th><td colspan="3">{{ f("beneficiary.address", label="수취인주소") }}</td></tr>
<tr><th>국가<span class="en">Country</span></th><td>{{ f("beneficiary.country", label="수취인국가") }}</td><th>신청인과의 관계<span class="en">Relationship</span></th><td>{{ f("beneficiary.relationship", label="신청인과의관계") }}</td></tr>
</table>

{{ bf.sec("3", "수취은행", "Beneficiary's Bank") }}
<table class="bf orm">
<tr><th>SWIFT BIC</th><td>{{ f("beneficiary.swift", label="SWIFTBIC") }}</td><th>은행코드<span class="en">ABA / Sort Code</span></th><td><span class="tiny muted">(해당 시 / If any)</span></td></tr>
<tr><th>은행명<span class="en">Bank Name</span></th><td>{{ f("beneficiary.bank_name", label="수취은행명") }}</td><th>중계은행<span class="en">Intermediary Bank</span></th><td><span class="tiny muted">(해당 시 / If any)</span></td></tr>
<tr><th>지점 및 주소<span class="en">Branch &amp; Address</span></th><td colspan="3">{{ f("beneficiary.bank_address", label="수취은행주소") }}</td></tr>
<tr><th>수취인 계좌번호<span class="en">Account No. / IBAN</span></th><td colspan="3" class="bold">{{ f("beneficiary.account_no", label="수취인계좌번호") }}</td></tr>
</table>

{{ bf.sec("4", "송금 내용", "Remittance Details") }}
<table class="bf orm">
<tr><th>송금통화<span class="en">Currency</span></th><td class="amt">{{ f("remittance.currency", label="송금통화") }}</td><th>송금금액<span class="en">Amount</span></th><td class="amt">{{ f("remittance.amount", label="송금금액") }}</td></tr>
<tr><th>송금사유<span class="en">Purpose of Payment</span></th><td colspan="3">{{ m.choice("remittance.purpose", ["수입대금", "유학생경비", "해외체재비", "증여성송금", "해외이주비", "기타"], label="송금사유") }}
  &nbsp;&nbsp;지급사유코드 <span class="u">{% if d.remittance.purpose_code is defined %}{{ f("remittance.purpose_code", label="지급사유코드") }}{% else %}&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;{% endif %}</span></td></tr>
<tr><th>수수료 부담<span class="en">Charges</span></th><td>{{ m.choice("remittance.charge", ["OUR", "SHA", "BEN"], label="수수료부담") }}</td>
    <th>송금방법<span class="en">Method</span></th><td>{{ m.choice("remittance.method", ["전신송금(T/T)", "송금수표(D/D)"], label="송금방법") }}</td></tr>
<tr><th>송금메시지<span class="en">Message to Beneficiary</span></th><td colspan="3">{{ f("remittance.message", label="송금메시지") }}</td></tr>
<tr><th>지급증빙서류<span class="en">Documents</span></th><td colspan="3">{{ f("remittance.documents", label="지급증빙서류") }}</td></tr>
</table>

<div class="bf-box bf-note" style="margin-top:5px">
  <p>1. 본인은 「외국환거래법」 등 관계 법령을 준수하며, 위 송금이 자금세탁 등 불법거래와 무관함을 확인합니다.</p>
  <p>2. 기재 오류 또는 중계·수취은행 사정으로 송금이 지연·반환될 수 있으며, 이로 인한 수수료와 환차손은 신청인이 부담합니다.</p>
  <p>3. OUR: 국내외 수수료 송금인 부담 / SHA: 국내 수수료 송금인, 해외 수수료 수취인 부담 / BEN: 모든 수수료 수취인 부담</p>
  <p>4. 지급증빙서류 미제출 송금은 연간 미화 10만불 상당액 이내에서만 가능합니다.</p>
</div>
<div class="bf-sign">
  <span>신청일 {{ f("date", label="신청일") }}</span>
  <span>신청인 <span class="who">{{ f("signature", label="신청인") }}</span> (서명 또는 인)</span>
</div>
<div class="right bold">{{ f("bank.name", label="은행명") }} 앞</div>

<div class="bf-use">
  <div class="cap">은행 사용란 (For Bank Use Only)</div>
  <div class="body">
    <table class="bf orm" style="flex:1">
      <tr><th style="width:92px">참조번호</th><td>{{ f("bank_use.ref_no", label="참조번호") }}</td><th style="width:92px">취급 영업점</th><td>{{ f("bank_use.branch", label="취급영업점") }}</td></tr>
      <tr><th>적용환율</th><td>{{ f("bank_use.rate", label="적용환율") }}{% if val("remittance.currency") == "JPY" %} <span class="tiny">(100 JPY당)</span>{% endif %}</td><th>원화환산액</th><td class="num">{{ f("bank_use.krw_amount", label="원화환산액") }}</td></tr>
      <tr><th>송금수수료</th><td class="num">{{ f("bank_use.fee", label="송금수수료") }}</td><th>전신료</th><td class="num">{{ f("bank_use.cable_fee", label="전신료") }}</td></tr>
      <tr><th>합계(원)</th><td colspan="3" class="num bold">{{ f("bank_use.total", label="합계") }}</td></tr>
    </table>
    {{ bf.stamps([["실명확인", None], ["담당자", "bank_use.clerk"], ["결재권자", "bank_use.manager"]]) }}
  </div>
</div>
{{ bf.foot("[지급신청서 겸용]", "외환-0131 (210×297) 모조 100g") }}
{% endblock %}
