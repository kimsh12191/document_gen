{% extends "_base.html.j2" %}
{% import "_macros.html.j2" as m with context %}
{% import "bank_form/_loan_parts.html.j2" as lp with context %}
{% block style %}
table.bf th, table.bf td { padding: 5px 7px; }
.num-h { font-weight: 700; margin: 8px 0 2px; }
{% endblock %}
{% block content %}
{{ lp.css() }}
{{ f.set_corr_name(val("applicant.name")) }}
{{ lp.head(kind="cms", sub="대출이자 등 자동이체용") }}
{% set same = d.debit.bank == d.bank %}
{{ lp.title_row("자동이체 신청서" if same else "CMS 출금이체 신청서", sub="(대출이자·원리금)") }}
<div style="margin:0 0 4px"><b>{{ f("biller.name", label="수납기관") }}</b> 앞 &nbsp;<span class="small muted">(취급점: {{ f("branch", label="취급점") }})</span>
&nbsp;&nbsp; 신청구분 : {{ m.choice("kind", ["신규", "변경", "해지"], label="신청구분") }}</div>

<div class="num-h">1. 수납기관 및 요금정보</div>
<table class="bf">
<colgroup><col style="width:120px"><col><col style="width:120px"><col></colgroup>
<tr><th>요금종류</th><td>{{ f("biller.fee_type", label="요금종류") }}</td><th>이체대상</th><td>{{ m.choice("target", ["대출이자", "대출원리금"], label="이체대상") }}{{ lp.nochk("target") }}</td></tr>
<tr><th>대출상품명</th><td>{{ f("loan_product", label="대출상품명") }}</td><th>납부자번호<br><span class="tiny">(대출계좌번호)</span></th><td>{{ f("loan_account", label="납부자번호(대출계좌번호)") }}</td></tr>
</table>

<div class="num-h">2. 신청고객 기본사항</div>
<table class="bf">
<colgroup><col style="width:120px"><col><col style="width:120px"><col></colgroup>
<tr><th>신청인(납부자)</th><td>{{ f("applicant.name", label="신청인", fix=0.04) }}</td><th>생년월일</th><td>{{ f("applicant.birth", label="생년월일", fix=0.05) }}</td></tr>
<tr><th>연 락 처</th><td>{{ f("applicant.phone", label="연락처", fix=0.06) }}</td><th>주　　소</th><td>{{ f("applicant.address", label="주소", fix=0.05) }}</td></tr>
</table>

<div class="num-h">3. 출금이체 신청내용 <span class="tiny muted" style="font-weight:400">(신청고객 기재란)</span></div>
<table class="bf">
<colgroup><col style="width:120px"><col><col style="width:120px"><col></colgroup>
<tr><th>출금은행</th><td>{{ f("debit.bank", label="출금은행") }}</td><th>출금계좌번호</th><td>{{ f("debit.account", label="출금계좌번호", fix=0.08) }}</td></tr>
<tr><th>예 금 주</th><td>{{ f("debit.holder", label="예금주", fix=0.04) }}</td><th>예금주 생년월일</th><td>{{ f("debit.holder_birth", label="예금주생년월일", fix=0.05) }}</td></tr>
<tr><th>예금주 휴대전화</th><td>{{ f("debit.holder_phone", label="예금주휴대전화", fix=0.06) }}</td><th>신청인과 예금주<br>와의 관계</th><td>{{ m.choice("relation", ["본인", "가족", "기타"], label="신청인과예금주와의관계") }}{{ lp.nochk("relation") }}</td></tr>
<tr><th>출 금 일</th><td>{{ f("transfer_day", label="출금일") }}</td><th>이체개시</th><td>{{ f("start_month", label="이체개시") }}</td></tr>
<tr><th>출금금액</th><td colspan="3">{{ f("amount", label="출금금액") }}</td></tr>
</table>

{% if d.extra_loans is defined %}
<div class="num-h">※ 추가 이체 대상 대출 <span class="tiny muted" style="font-weight:400">(같은 출금계좌에서 함께 출금)</span></div>
<table class="bf compact">
<colgroup><col style="width:40px"><col style="width:30%"><col><col style="width:18%"><col style="width:18%"></colgroup>
<tr><th style="text-align:center">No</th><th style="text-align:center">납부자번호(대출계좌번호)</th><th style="text-align:center">대출상품</th><th style="text-align:center">이체대상</th><th style="text-align:center">출금일</th></tr>
{% for x in d.extra_loans %}{% set k = "extra_loans." ~ loop.index0 %}
<tr><td class="c">{{ loop.index + 1 }}</td><td class="c">{{ f(k ~ ".loan_account", label="납부자번호", fix=0.05) }}</td><td class="c">{{ f(k ~ ".loan_product", label="대출상품") }}</td><td class="c">{{ f(k ~ ".target", label="이체대상") }}</td><td class="c">{{ f(k ~ ".transfer_day", label="출금일") }}</td></tr>
{% endfor %}
</table>
{% endif %}
<div class="num-h">4. 개인정보 수집·이용 및 제3자 제공 동의</div>
<table class="bf compact">
<colgroup><col style="width:120px"><col></colgroup>
<tr><th>수집·이용 목적</th><td class="small">자동이체(출금이체)를 통한 대출이자 등 납부, 출금동의 확인, 출금이체 신규등록 및 해지사실 통지</td></tr>
<tr><th>수집 항목</th><td class="small">성명, 생년월일, 연락처, 출금은행명, 계좌번호, 예금주 정보</td></tr>
<tr><th>보유·이용 기간</th><td class="small">수집·이용 동의일부터 출금이체 종료일(해지일) 후 5년까지</td></tr>
<tr><th>제공받는 자</th><td class="small">{% if same %}해당 없음(당행 계좌 자동이체){% else %}(사)금융결제원, 출금이체 계좌의 금융기관{% endif %}</td></tr>
<tr><th>동의 여부</th><td>개인정보 수집·이용 {{ m.agree("privacy_consent", label="개인정보수집이용동의") }} &nbsp; 제3자 제공 {{ m.agree("third_party_consent", label="제3자제공동의") }}{{ lp.nochk("third_party_consent") }}</td></tr>
</table>
<div class="notice">
<p>※ 동의를 거부할 권리가 있으나, 동의하지 않으시면 자동이체 신청이 불가합니다.</p>
<p>※ 출금일이 휴일인 경우 다음 영업일에 출금되며, 잔액 부족으로 미출금된 금액은 이후 입금 즉시 출금될 수 있고 연체이자(지연배상금)가 발생할 수 있습니다.</p>
<p>※ 변경·해지는 영업점 또는 인터넷뱅킹에서 신청할 수 있으며, 출금계좌가 해지되면 자동이체도 해지됩니다.</p>
</div>

<p class="lead" style="margin:8px 0 4px">신청인은 「개인정보 보호법」 및 「신용정보의 이용 및 보호에 관한 법률」에 따라 위 금융거래정보의 제공, 개인정보의 수집·이용 및 제3자 제공에 동의하며 위와 같이 출금이체를 신청합니다.</p>
<div class="center">{{ f("apply_date", label="신청일") }}</div>
<div class="sig">신청인&nbsp;<span class="who">{{ f("signature", label="신청인") }}</span>{{ m.sigspot("applicant", val("signature"), label="신청인", anchor="signature") }}</div>
<div class="sig">예금주&nbsp;<span class="who">{{ f("holder_signature", label="예금주") }}</span>{{ m.sigspot("holder", val("holder_signature"), label="예금주", anchor="holder_signature") }}</div>
<div class="tiny muted right">※ 신청인과 예금주가 다른 경우 예금주가 별도로 서명하여야 합니다.</div>

{{ lp.bank_use(["접수일자", "실명확인", "등록처리", "담당자", "책임자"]) }}
{% endblock %}
