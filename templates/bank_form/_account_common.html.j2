{#
  bank_form_account 서식 공통 매크로/CSS (bank_form_account.py 전용).
    {% import "bank_form/_account_common.html.j2" as bf with context %}
#}

{% macro css() -%}
.page.a4 { padding: calc(var(--page-pad) * .55) calc(var(--page-pad) * .62); }
.bf-head { display: flex; justify-content: space-between; align-items: flex-end; border-bottom: 2px solid var(--accent); padding-bottom: 3px; margin-bottom: 6px; }
.bf-bank { color: var(--accent); font-weight: 800; font-size: calc(var(--fs) + 5px); letter-spacing: .04em; }
.bf-bank .en { font-size: calc(var(--fs) - 3.5px); font-weight: 600; letter-spacing: .02em; margin-left: 6px; }
.bf-bank .mk { display: inline-block; width: 15px; height: 15px; border: 3px solid var(--accent); border-radius: 50%; margin-right: 6px; vertical-align: -1px; }
.bf-meta { font-size: calc(var(--fs) - 3.5px); color: #444; text-align: right; line-height: 1.3; }
h1.title { margin: 2px 0 6px; font-size: calc(var(--title) - 5px); letter-spacing: .12em; }
h1.title .sub { font-size: calc(var(--fs) - 1px); margin-top: 1px; letter-spacing: .02em; }
.bf-sec { font-weight: 700; margin: 6px 0 1px; font-size: calc(var(--fs) + .5px); }
.bf-sec .n { display: inline-block; background: var(--accent); color: #fff; padding: 0 6px; margin-right: 6px; font-size: calc(var(--fs) - 1px); }
.bf-sec .en { font-weight: 400; font-size: calc(var(--fs) - 2.5px); color: #555; margin-left: 4px; }
table.bf { margin: 2px 0 3px; border: 1.5px solid var(--border); }
table.bf th, table.bf td { padding: 2px 6px; }
table.bf th { font-weight: 600; }
table.bf td.q { text-align: left; }
table.bf th.l { text-align: left; }
th .en, td .en { display: block; font-weight: 400; font-size: calc(var(--fs) - 4px); color: #555; line-height: 1.1; }
.bf-note { font-size: calc(var(--fs) - 3px); color: #333; line-height: 1.35; margin: 2px 0; }
.bf-note p { margin: 1px 0; }
.bf-box { border: 1px solid var(--border); padding: 4px 8px; margin: 4px 0; }
.bf-agree { text-align: right; margin: 2px 0 4px; }
.bf-agree .req { color: var(--accent); font-weight: 700; margin-right: 6px; }
.bf-sign { display: flex; justify-content: flex-end; align-items: center; gap: 18px; margin: 6px 0 2px; }
.bf-sign .who { min-width: 90px; display: inline-block; text-align: center; font-weight: 600; }
.bf-use { border: 2px solid var(--border); margin-top: 6px; padding: 0; display: flex; flex-direction: column; } /* 쪽 나눔 시 한 덩어리 */
.bf-use .cap { background: var(--label-bg); border-bottom: 1px solid var(--border); padding: 1px 8px; font-weight: 700; font-size: calc(var(--fs) - 1px); }
.bf-use .body { display: flex; gap: 8px; padding: 4px 6px; align-items: stretch; }
.bf-use .body > table { margin: 0; }
table.stamp { width: auto; margin: 0; }
table.stamp th { padding: 1px 10px; font-size: calc(var(--fs) - 2px); }
table.stamp td { width: 64px; height: 48px; text-align: center; padding: 2px; }
.seal.staff { transform: rotate(-5deg); font-family: var(--font); }
.seal.staff.long { font-size: 8px; letter-spacing: -.03em; }
.pw { display: inline-block; width: 20px; height: 20px; border: 1px solid var(--border); margin-right: 2px; vertical-align: middle; }
.chk { margin-right: 8px; }
.bf-foot { display: flex; justify-content: space-between; font-size: calc(var(--fs) - 4px); color: #555; margin-top: 3px; }
.bf-page { position: relative; }
.corr { white-space: normal; } /* 긴 값(주소 등)의 정정이 칸을 넘지 않게 */
{%- endmacro %}

{# 상단: 은행명 + 서식 메타 #}
{% macro head(meta) -%}
<div class="bf-head">
  <div class="bf-bank"><span class="mk"></span>{{ f("bank.name", label="은행명") }}{% if bk and bk.en %}<span class="en">{{ bk.en }}</span>{% endif %}</div>
  <div class="bf-meta">{{ meta|safe }}</div>
</div>
{%- endmacro %}

{# 번호 붙은 섹션 제목 #}
{% macro sec(n, text, en=None) -%}
<div class="bf-sec"><span class="n">{{ n }}</span>{{ text }}{% if en %}<span class="en">{{ en }}</span>{% endif %}</div>
{%- endmacro %}

{# 담당/책임자 도장 칸. items: [[라벨, 경로], ...] #}
{% macro stamps(items) -%}
<table class="bf stamp">
<tr>{% for it in items %}<th>{{ it[0] }}</th>{% endfor %}</tr>
<tr>{% for it in items %}<td>{% if it[1] %}<span class="seal sm staff{{ ' long' if val(it[1])|length > 3 }}" data-mark="{{ f.mark('staff.' ~ it[1].split('.')[-1], 'seal', True, val(it[1]), label=it[0], kind='행원인', anchor=it[1]) }}">{{ f(it[1], label=it[0]) }}</span>{% endif %}</td>{% endfor %}</tr>
</table>
{%- endmacro %}

{# 복수 선택 체크박스: path 는 선택된 값들의 리스트 #}
{% macro multi(path, options, label=None) -%}
{% set cur = val(path) %}
{% for o in options %}<span class="chk" data-opt="{{ path }}#{{ loop.index0 }}"><span class="cb" data-box="{{ path }}#{{ loop.index0 }}">{{ "■" if o in cur else "□" }}</span> {% if o in cur %}{{ f(path ~ '.' ~ cur.index(o), label=label) }}{% else %}{{ o }}{% endif %}</span>{% endfor %}{{ f.opts(path, options, cur, label) }}
{%- endmacro %}

{# 하단 서식번호 줄: 서식코드(규격) / 보존기간 등 #}
{% macro foot(left, right="") -%}
<div class="bf-foot"><span>{{ left|safe }}</span><span>{{ right|safe }}</span></div>
{%- endmacro %}

{# 체크 누락(아무 보기도 체크 안 됨): m.choice 는 data-field 를 남기지 않으므로 빈 위치 표시를 단다 (정답 null) #}
{% macro nochk(path) -%}
{% if path in f.fields and not f.has(path) %}{{ f(path) }}{% endif %}
{%- endmacro %}
