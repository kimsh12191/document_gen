{% extends "_base.html.j2" %}
{% import "_macros.html.j2" as m with context %}
{% block style %}
table.tx th, table.tx td { padding: 3px 5px; font-size: calc(var(--fs) - 1.5px); }
table.tx td.memo { text-align: left; }
table.tx tr.sum td, table.tx tr.sum th { background: var(--label-bg); font-weight: 700; }
{% endblock %}
{% block content %}
{{ m.doc_no("issue_no", "발급번호") }}
{{ m.title("거 래 내 역 확 인 서") }}
{{ m.kv([["예 금 주", "holder"], ["생년월일", "birth"], ["계좌번호", "account_no"], ["상 품 명", "product"],
         ["조회기간", "period"], ["조회기간 전 잔액", "opening_balance"]], cols=2, label_w="120px") }}
<table class="tx mt">
  <colgroup><col style="width:19%"><col style="width:11%"><col style="width:19%"><col style="width:13%"><col style="width:13%"><col></colgroup>
  <tr><th>거래일시</th><th>적요</th><th>기재내용</th><th>찾으신금액</th><th>맡기신금액</th><th>거래후잔액</th></tr>
  {% for r in d.rows %}{% set i = loop.index0 %}
  <tr>
    <td class="c">{{ f("rows." ~ i ~ ".datetime", label="거래일시") }}</td>
    <td class="c">{{ f("rows." ~ i ~ ".type", label="적요") }}</td>
    <td class="memo">{{ f("rows." ~ i ~ ".memo", label="기재내용") }}</td>
    <td class="num">{% if r.out is defined %}{{ f("rows." ~ i ~ ".out", label="찾으신금액") }}{% endif %}</td>
    <td class="num">{% if r["in"] is defined %}{{ f("rows." ~ i ~ ".in", label="맡기신금액") }}{% endif %}</td>
    <td class="num">{{ f("rows." ~ i ~ ".balance", label="거래후잔액") }}</td>
  </tr>
  {% endfor %}
  <tr class="sum"><td class="c">합계</td><td class="c">{{ f("summary.count", label="거래건수") }}</td><td></td>
    <td class="num">{{ f("summary.out", label="찾으신금액합계") }}</td><td class="num">{{ f("summary.in", label="맡기신금액합계") }}</td>
    <td class="num">{{ f("summary.balance", label="최종잔액") }}</td></tr>
</table>
<p class="note">※ 본 확인서는 조회기간 중 위 계좌의 거래내역을 확인하기 위한 것으로 다른 용도로 사용할 수 없습니다.<br>※ 금액 단위 : 원</p>
<p class="center mt" style="font-size:calc(var(--fs) + 1px)">위와 같이 거래내역을 확인합니다.</p>
<div class="issuer" style="margin-top:10px">
  <div class="date">{{ f("issue_date", label="발급일") }}</div>
  <div class="org">{{ f("issuer", label="발급점") }}{{ m.seal(val("issuer").split()[-1] ~ "장인", square=True, over=True) }}</div>
</div>
{% endblock %}
