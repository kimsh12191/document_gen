{% extends "_base.html.j2" %}
{% import "_macros.html.j2" as m with context %}
{% block style %}
table.bc tr.sum th, table.bc tr.sum td { font-weight: 700; background: var(--label-bg); }
{% endblock %}
{% block content %}
{{ m.doc_no("cert_no", "증명서번호") }}
{{ m.title("예 금 잔 액 증 명 서", sub="Certificate of Deposit Balance") }}
{{ m.kv([["예 금 주", "holder.name"], ["고객번호(주민등록번호)", "holder.rrn"], ["기 준 일", "base_date", True]], cols=2, label_w="150px") }}
<table class="bc mt">
  <colgroup><col style="width:20%"><col style="width:24%"><col style="width:18%"><col style="width:12%"><col style="width:7%"><col></colgroup>
  <tr><th>과　목</th><th>계좌번호</th><th>예금잔액(원)</th><th>미결제타점권</th><th>질권</th><th>지급정지·압류·가압류</th></tr>
  {% for r in d.rows %}{% set i = loop.index0 %}
  <tr>
    <td class="c" style="white-space:nowrap">{{ f("rows." ~ i ~ ".kind", label="과목") }}</td>
    <td class="c">{{ f("rows." ~ i ~ ".account_no", label="계좌번호") }}</td>
    <td class="num">{{ f("rows." ~ i ~ ".balance", label="예금잔액") }}</td>
    <td class="num">{{ f("rows." ~ i ~ ".uncleared", label="미결제타점권") }}</td>
    <td class="c">{{ f("rows." ~ i ~ ".pledge", label="질권") }}</td>
    <td class="c">{{ f("rows." ~ i ~ ".restriction", label="지급정지·압류·가압류") }}</td>
  </tr>
  {% endfor %}
  {% for _ in range(5 - d.rows|length) %}<tr><td>&nbsp;</td><td></td><td></td><td></td><td></td><td></td></tr>{% endfor %}
  <tr class="sum"><th>합　계</th><td class="c">통화 : {{ f("currency", label="통화") }}</td><td class="num">{{ f("total", label="합계") }}</td><td colspan="3"></td></tr>
  <tr><th>합계(한글)</th><td colspan="5" class="bold">{{ f("total_korean", label="합계금액(한글)") }}</td></tr>
</table>
<table>
  <colgroup><col style="width:110px"><col></colgroup>
  <tr><th>용　　도</th><td>{{ f("purpose", label="용도") }}</td></tr>
</table>
<p class="center mt-l" style="font-size:calc(var(--fs) + 2px)">위와 같이 예금잔액이 있음을 증명합니다.</p>
<div class="issuer">
  <div class="date">{{ f("issue_date", label="발급일") }}</div>
  <div class="org">{{ f("issuer", label="발급점") }}{{ m.seal(val("issuer").split()[-1] ~ "인", square=True, over=True) }}</div>
</div>
<ol class="note mt-l">
  <li>이 증명서는 기준일 현재의 예금잔액을 증명하는 것으로, 기준일 이후의 입출금에 대하여는 책임지지 않습니다.</li>
  <li>이 증명서는 예금의 양도·담보 또는 그 밖의 권리를 증명하는 것이 아니며, 다른 목적으로 사용할 수 없습니다.</li>
  <li>질권설정, 지급정지, 압류·가압류 사실이 있는 경우 해당란에 "유"로 표시합니다.</li>
</ol>
{% endblock %}
