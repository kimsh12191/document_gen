{#
  공통 매크로. 템플릿 상단에서 반드시 `with context` 로 임포트한다:
    {% import "_macros.html.j2" as m with context %}
  값 출력은 항상 f('경로') 를 거친다 (GT 기록 + data-field 태깅).
#}

{# 문서 제목 #}
{% macro title(text, sub=None, boxed=False) -%}
<h1 class="title{{ ' box' if boxed }}">{{ text }}{% if sub %}<span class="sub">{{ sub }}</span>{% endif %}</h1>
{%- endmacro %}

{#
  라벨-값 표.
  rows: [[라벨, 경로], [라벨, 경로], ...]  — cols 개씩 한 줄에 배치
  [라벨, 경로, True] 로 주면 그 항목은 한 줄 전체를 차지한다 (주소 등 긴 값).
  항목 자리에 None 을 주면 빈 칸.
#}
{% macro kv(rows, cols=1, label_w=None, cls="") -%}
<table class="kv {{ cls }}">
{% if label_w %}<colgroup>{% for _ in range(cols) %}<col style="width:{{ label_w }}"><col>{% endfor %}</colgroup>{% endif %}
{% for line in kv_layout(rows, cols) %}
<tr>
{% for item in line %}
{% if item is none %}<th></th><td></td>
{% else %}<th data-label="{{ item[1] }}">{{ item[0] }}</th><td{% if item[2] > 1 %} colspan="{{ item[2] }}"{% endif %}>{{ f(item[1], label=item[0]) }}</td>
{% endif %}
{% endfor %}
</tr>
{% endfor %}
</table>
{%- endmacro %}

{#
  목록형 표.
  headers: 열 제목 리스트, list_path: d 안의 리스트 경로, keys: 각 열에 대응하는 항목 키
  num_cols: 오른쪽 정렬할 열 인덱스 리스트, min_rows: 빈 줄로 채울 최소 행 수
#}
{% macro grid(headers, list_path, keys, num_cols=[], widths=None, min_rows=0, cls="") -%}
{% set items = val(list_path) %}
<table class="grid {{ cls }}">
{% if widths %}<colgroup>{% for w in widths %}<col style="width:{{ w }}">{% endfor %}</colgroup>{% endif %}
<tr>{% for h in headers %}<th data-label="{{ list_path }}.*.{{ keys[loop.index0] }}">{{ h }}</th>{% endfor %}</tr>
{% for it in items %}
{% set i = loop.index0 %}
<tr>
{% for k in keys %}
<td class="{{ 'num' if loop.index0 in num_cols else 'c' }}">{{ f(list_path ~ '.' ~ i ~ '.' ~ k, label=headers[loop.index0]) }}</td>
{% endfor %}
</tr>
{% endfor %}
{% for _ in range(min_rows - items|length) %}<tr>{% for h in headers %}<td>&nbsp;</td>{% endfor %}</tr>{% endfor %}
</table>
{%- endmacro %}

{# 선택형 항목: 선택된 옵션만 f() 로 기록된다. 예) m.choice('loan.rate_type', ['고정금리','변동금리']) #}
{% macro choice(path, options, label=None, on="■", off="□") -%}
{% set cur = val(path) if f.has(path) else None %}
{% for o in options %}<span class="chk" data-opt="{{ path }}#{{ loop.index0 }}"><span class="cb" data-box="{{ path }}#{{ loop.index0 }}">{{ on if o == cur else off }}</span> {% if o == cur %}{{ f(path, label=label) }}{% else %}{{ o }}{% endif %}</span>{% endfor %}{{ f.opts(path, options, cur, label) }}
{%- endmacro %}

{# 동의 여부 등 예/아니오 체크 #}
{% macro agree(path, yes="동의함", no="동의하지 않음", label=None) -%}
{{ choice(path, [yes, no], label=label) }}
{%- endmacro %}

{# 인감/직인 (텍스트 기반 도장 모양) #}
{#
  도장. key 를 주면 정답에 seal.<key> 로 날인 여부가 기록된다 (주지 않으면 seal.markN).
  kind: 직인 / 인감 / 법인인감 / 사인 등, anchor: 이 도장이 확인하는 값의 경로
#}
{% macro seal(text, square=False, size="", over=False, key=None, kind=None, anchor=None, label=None, p=1.0) -%}
{% set present = p >= 1 or f.chance(p) %}
{% set k = f.mark(key or ("issuer" if over else None), "seal", present, text if present else None, label=label, kind=kind or ("직인" if square else "도장"), anchor=anchor) %}
{% if not present %}<span class="seal-missing{{ ' ' ~ size if size }}" data-mark="{{ k }}"></span>{% else %}
<span class="seal{{ ' square' if square }}{{ ' ' ~ size if size }}{{ ' over' if over }}" data-mark="{{ k }}" style="{{ seal_font(text) }}">{{ seal_lines(text)|join(BR) }}</span>{% endif %}
{%- endmacro %}

{#
  고객이 서명하거나 도장을 찍는 자리 "(서명 또는 인)".
  랜덤으로 도장 / 서명 / 빈 칸이 되며, 결과가 seal.<key>, signature.<key> 로 기록된다.
  name: 도장 글자·서명할 이름, p_seal/p_sign: 확률 (나머지는 빈 칸)
#}
{% macro sigspot(key, name, mark="(서명 또는 인)", p_seal=0.45, p_sign=0.45, label=None, anchor=None, size="sm") -%}
{% set x = f.rng.random() %}{% set has_seal = x < p_seal %}{% set has_sign = not has_seal and x < p_seal + p_sign %}
{% set ks = f.mark(key, "seal", has_seal, name if has_seal else None, label=label, kind="인감", anchor=anchor) %}
{% set kg = f.mark(key, "signature", has_sign, name if has_sign else None, label=label, anchor=anchor) %}
<span class="inmark"{% if not has_seal %} data-mark="{{ ks }}"{% endif %}{% if not has_sign %} data-mark2="{{ kg }}"{% endif %}>{{ mark }}
{%- if has_seal %}<span class="seal {{ size }} onmark" data-mark="{{ ks }}" style="{{ seal_font(name) }}">{{ seal_lines(name)|join(BR) }}</span>{% endif %}
{%- if has_sign %}<span class="scribble" data-mark="{{ kg }}">{{ scribble(name, f.rng) }}</span>{% endif %}</span>
{%- endmacro %}

{# 발급일/발급기관/직인 블록 #}
{% macro issuer(date_path, org_path=None, org_text=None, seal_text=None, square=True) -%}
<div class="issuer">
  <div class="date">{{ f(date_path, label="발급일") }}</div>
  <div class="org">{% if org_path %}{{ f(org_path, label="발급기관") }}{% else %}{{ org_text }}{% endif %}{% if seal_text %}{{ seal(seal_text, square=square, over=True) }}{% endif %}</div>
</div>
{%- endmacro %}

{# 서명란: "신청인  홍길동  (서명 또는 인)" #}
{% macro sign(label, path, mark="(서명 또는 인)", seal_text=None) -%}
<div class="right mt">{{ label }}&nbsp;&nbsp;<span class="signline">{{ f(path, label=label) }}</span>&nbsp;&nbsp;{% if seal_text %}{{ seal(seal_text, size="sm") }}{% else %}{{ mark }}{% endif %}</div>
{%- endmacro %}

{# 증명서 상단 발급번호 줄 #}
{% macro doc_no(path, label="발급번호") -%}
<div class="docno pg-repeat">{{ label }} : {{ f(path, label=label) }}</div>
{%- endmacro %}
