{#
  선언형 폼 스펙(docgen/formspec.py)으로 등록된 서식을 렌더링하는 공용 템플릿.
  수제 템플릿과 같은 f() 규약을 지키므로 GT·bbox·라벨 파이프라인은 그대로 쓰인다.
  d.sections = [{title, items:[{key,label,kind,options,value}]}]
#}
{% extends "_base.html.j2" %}
{% import "_macros.html.j2" as m with context %}
{% block style %}
.gf-head { display: flex; justify-content: space-between; align-items: flex-end;
           border-bottom: 2px solid var(--accent); padding-bottom: 3px; margin-bottom: 6px; }
.gf-org { color: var(--accent); font-weight: 800; font-size: calc(var(--fs) + 4px); letter-spacing: .04em; }
.gf-org .mk { display: inline-block; width: 14px; height: 14px; border: 3px solid var(--accent);
              border-radius: 50%; margin-right: 6px; vertical-align: -1px; }
.gf-code { font-size: calc(var(--fs) - 3px); color: #444; text-align: right; line-height: 1.3; }
h1.title { font-size: calc(var(--title) - 4px); letter-spacing: .14em; margin: 6px 0 4px; }
.gf-sec { font-weight: 700; margin: 8px 0 2px; color: var(--accent); font-size: calc(var(--fs) + .5px); }
.gf-sec::before { content: "■ "; }
table.gf { margin: 2px 0 4px; }
table.gf th, table.gf td { padding: 4px 7px; }
table.gf th { text-align: left; width: 150px; }
.gf-note { font-size: calc(var(--fs) - 2.5px); color: #333; margin: 4px 0; line-height: 1.35; }
.gf-note p { margin: 1px 0; padding-left: 1em; text-indent: -1em; }
.sig { display: flex; justify-content: flex-end; align-items: center; gap: 6px; margin-top: 6px; }
.sig .who { min-width: 90px; text-align: center; }
.gf-use { border: 1.5px dashed #777; padding: 4px 8px; margin-top: 10px; display: flex; flex-direction: column; }
.gf-use .t { font-size: calc(var(--fs) - 2px); font-weight: 700; margin-bottom: 2px; }
.gf-use table { margin: 0; }
.gf-use th, .gf-use td { font-size: calc(var(--fs) - 2.5px); padding: 2px 4px; }
.gf-use td { height: 28px; }
.corr { white-space: normal; }
{% endblock %}
{% block content %}
{{ f.set_corr_name(val("signature")) }}
<div class="gf-head">
  <div class="gf-org"><span class="mk"></span>{{ f("bank", label="은행명") }}{% if bk and bk.en %}<span class="tiny" style="margin-left:6px">{{ bk.en }}</span>{% endif %}</div>
  <div class="gf-code">{% if bk %}{{ d.form_code }} ({{ bk.rev("2025.01") }} 개정){% else %}{{ d.form_code }}{% endif %}</div>
</div>

{{ m.title(spec.name) }}
{% if d.title_note %}<div class="small muted center" style="margin:-2px 0 6px">{{ d.title_note }}</div>{% endif %}
<div style="margin:0 0 4px">{% if bk %}{{ bk.legal }}{% else %}{{ val("bank") }}{% endif %}
<b>{{ f("branch", label="취급점") }}</b> 앞</div>

{% for s in d.sections %}
<div class="gf-sec">{{ loop.index }}. {{ s.title }}</div>
<table class="gf">
<colgroup><col style="width:150px"><col></colgroup>
{% for it in s["items"] %}{# dict 의 .items 메서드와 겹치므로 키로 꺼낸다 #}
<tr><th>{{ it.label }}</th>
<td>{% if it.options %}{{ m.choice(it.key, it.options, label=it.label) }}
{%- else %}{{ f(it.key, label=it.label, fix=0.04) }}{% endif %}</td></tr>
{% endfor %}
</table>
{% endfor %}

<div class="gf-note">
<p>※ 위 기재사항은 사실과 다름이 없음을 확인합니다.</p>
<p>※ 기재사항이 사실과 다른 경우 관계 법령에 따라 불이익을 받을 수 있습니다.</p>
</div>

<div class="center" style="margin-top:6px">{{ f("date", label="작성일") }}</div>
<div class="sig">신청인&nbsp;<span class="who">{{ f("signature", label="신청인") }}</span>{{ m.sigspot("applicant", val("signature"), label="신청인", anchor="signature") }}</div>

<div class="gf-use">
  <div class="t">※ 은행 사용란 (고객은 기재하지 마십시오)</div>
  <table><tr><th>접수일자</th><th>실명확인</th><th>처리일자</th><th>담당자</th><th>책임자</th></tr>
  <tr><td></td><td></td><td></td><td><span class="muted tiny">(인)</span></td><td><span class="muted tiny">(인)</span></td></tr></table>
</div>
{% endblock %}
