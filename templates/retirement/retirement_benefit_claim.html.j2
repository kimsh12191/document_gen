{% extends "_base.html.j2" %}
{% import "_macros.html.j2" as m with context %}
{% import "bank_form/_loan_parts.html.j2" as lp with context %}
{% import "retirement/_parts.html.j2" as rp with context %}
{% block content %}
{{ rp.css() }}
{{ f.set_corr_name(val("signature")) }}
{{ lp.head(kind="db_claim") }}
{{ lp.title_row("퇴직연금 퇴직급여 지급신청서", sub="확정급여형(DB)") }}
<div style="margin:0 0 4px">{{ lp.legal_name() }} <b>{{ f("branch", label="취급점") }}</b> 앞</div>

{{ rp.sec(1, "사용자(기업)") }}
<table class="bf">
<colgroup><col style="width:120px"><col><col style="width:120px"><col></colgroup>
<tr><th>사 업 장 명</th><td>{{ f("employer.name", label="사업장명", fix=0.03) }}</td><th>사업자등록번호</th><td>{{ f("employer.biz_no", label="사업자등록번호", fix=0.06) }}</td></tr>
<tr><th>퇴직연금 계약번호</th><td colspan="3">{{ f("employer.contract_no", label="퇴직연금계약번호", fix=0.06) }}</td></tr>
</table>

{{ rp.sec(2, "가입자(퇴직자)") }}
{{ rp.participant() }}
<table class="bf">
<colgroup><col style="width:120px"><col><col style="width:120px"><col></colgroup>
<tr><th>사 번</th><td>{{ f("participant.employee_no", label="사번", fix=0.06) }}</td><th>퇴직 사유</th><td>{{ f("reason", label="퇴직사유") }}</td></tr>
<tr><th>입 사 일</th><td>{{ f("participant.hire_date", label="입사일", fix=0.05) }}</td><th>퇴 사 일</th><td>{{ f("participant.leave_date", label="퇴사일", fix=0.05) }}</td></tr>
<tr><th>계속근로기간</th><td colspan="3">{{ f("participant.service_years", label="계속근로기간") }}</td></tr>
</table>

{{ rp.sec(3, "퇴직급여") }}
<table class="bf">
<colgroup><col style="width:120px"><col><col style="width:120px"><col></colgroup>
<tr><th>평균임금(월)</th><td class="num">{{ f("benefit.avg_wage", label="평균임금") }}</td><th>퇴직급여액</th><td class="num bold">{{ f("benefit.amount", label="퇴직급여액") }}</td></tr>
<tr><th>원천징수세액</th><td class="num">{{ f("benefit.tax", label="원천징수세액") }}</td><th>실 지급액</th><td class="num">{{ f("benefit.net", label="실지급액") }}</td></tr>
</table>

{{ rp.sec(4, "지급 방법") }}
<table class="bf">
<colgroup><col style="width:120px"><col></colgroup>
<tr><th>지급 방법</th><td>{{ m.choice("way", ["IRP 계좌 이전", "일시금 지급", "연금 수령"], label="지급방법") }}{{ lp.nochk("way") }}</td></tr>
<tr><th>IRP 계좌</th><td>{{ f("irp.bank", label="IRP은행") }} / {{ f("irp.account", label="IRP계좌번호", fix=0.06) }} / 예금주 {{ f("irp.holder", label="IRP예금주", fix=0.04) }}</td></tr>
<tr><th>일시금 입금계좌</th><td>{{ f("pay_account", label="일시금입금계좌", fix=0.08) }}</td></tr>
<tr><th>지급 예정일</th><td>{{ f("pay_date", label="지급예정일", fix=0.05) }}</td></tr>
</table>

<div class="notice">
<p>※ 만 55세 미만으로 퇴직하는 경우 퇴직급여는 개인형퇴직연금(IRP) 계좌로 이전하여야 합니다 (근로자퇴직급여 보장법 제17조).</p>
<p>※ IRP 로 이전하는 경우 퇴직소득세가 과세이연되며, 이후 일시금으로 인출할 때 과세됩니다.</p>
<p>※ 퇴직급여는 지급사유 발생일부터 14일 이내에 지급합니다. 다만 당사자 간 합의로 기일을 연장할 수 있습니다.</p>
</div>

<div class="center" style="margin-top:6px">{{ f("date", label="작성일") }}</div>
<div class="sig">가입자(퇴직자)&nbsp;<span class="who">{{ f("signature", label="가입자") }}</span>{{ m.sigspot("participant", val("signature"), label="가입자", anchor="signature") }}</div>

{{ lp.bank_use(["접수일자", "본인확인", "지급처리", "담당", "책임자"]) }}
{% endblock %}
