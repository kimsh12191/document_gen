{#
  퇴직연금 서식 공통 조각. 템플릿에서:
    {% import "retirement/_parts.html.j2" as rp with context %}
  서식번호 줄·결재란·은행 사용란은 은행 서식 공통(_loan_parts.html.j2)을 그대로 쓴다.
#}
{% import "_macros.html.j2" as m with context %}
{% import "bank_form/_loan_parts.html.j2" as lp with context %}

{% macro css() -%}
{{ lp.css() }}
<style>
.rp-warn { float: right; border: 2px solid var(--seal); color: var(--seal); font-weight: 700;
           font-size: calc(var(--fs) - 2px); padding: 2px 6px; margin-left: 8px; line-height: 1.15; text-align: center; }
.num-h { font-weight: 700; margin: 7px 0 2px; color: var(--accent); }
.num-h .n { display: inline-block; background: var(--accent); color: #fff; padding: 0 6px; margin-right: 5px;
            font-size: calc(var(--fs) - 1px); }
.hand-box { border: 1px solid var(--border); padding: 5px 9px; margin: 4px 0; }
.hand-box .hand { letter-spacing: .25em; }
table.bf th, table.bf td { padding: 4px 7px; }
table.opt td, table.opt th { padding: 2px 5px; font-size: calc(var(--fs) - 2px); }
table.opt td.c { text-align: center; }
</style>
{%- endmacro %}

{# 원금손실 가능 경고 박스 (실적배당상품이 들어가는 서식) #}
{% macro warn() -%}
<div class="rp-warn">원금<br>손실가능<br>상품</div>
{%- endmacro %}

{# 번호 붙은 섹션 제목 #}
{% macro sec(n, text) -%}
<div class="num-h"><span class="n">{{ n }}</span>{{ text }}</div>
{%- endmacro %}

{# 가입자 기본정보 표 (서식마다 같은 네 칸) #}
{% macro participant(path="participant") -%}
<table class="bf">
<colgroup><col style="width:120px"><col><col style="width:120px"><col></colgroup>
<tr><th>성　　명</th><td>{{ f(path ~ ".name", label="성명", fix=0.04) }}</td><th>생년월일</th><td>{{ f(path ~ ".birth", label="생년월일", fix=0.05) }}</td></tr>
<tr><th>휴대전화</th><td>{{ f(path ~ ".phone", label="휴대전화", fix=0.06) }}</td><th>이메일주소</th><td>{{ f(path ~ ".email", label="이메일주소", fix=0.05) }}</td></tr>
<tr><th>주　　소</th><td colspan="3">{{ f(path ~ ".address", label="주소", fix=0.04) }}</td></tr>
</table>
{%- endmacro %}

{# 통지 수신 표 #}
{% macro notice(ways) -%}
<table class="bf">
<colgroup><col style="width:150px"><col></colgroup>
<tr><th>만기통지방법</th><td>{{ m.choice("notice.maturity", ways, label="만기통지방법") }}{{ lp.nochk("notice.maturity") }}</td></tr>
<tr><th>서비스 통지<br>발송제외 신청</th><td>{{ m.choice("notice.service_excluded", ["신청(미발송)", "신청안함(발송)"], label="서비스통지발송제외") }}</td></tr>
<tr><th>약관 변경 통지</th><td>{{ m.choice("notice.terms_change", ways + ["수신거부"], label="약관변경통지") }}{{ lp.nochk("notice.terms_change") }}</td></tr>
</table>
{%- endmacro %}

{# 운용상품 지정 표 (매수비율 합 100%) #}
{% macro buy_plan(path, title="상품명") -%}
{{ m.grid(["구분", title, "위험등급", "매수비율"], path, ["kind", "name", "risk", "ratio"],
          widths=["16%", "48%", "18%", "18%"], min_rows=1, cls="compact") }}
<div class="tiny muted">※ 매수비율의 합은 100% 가 되어야 합니다.</div>
{%- endmacro %}

{# 디폴트옵션 상품표 — 선택한 1개에만 ■ 가 찍힌다 #}
{% macro default_options(selected_path="default_option.name") -%}
{% set sel = val(selected_path) %}
<table class="bf opt">
<colgroup><col style="width:50px"><col><col style="width:22%"><col style="width:30%"></colgroup>
<tr><th>선택(1개)</th><th>상품명</th><th>디폴트옵션 적용 위험도</th><th>상품구성</th></tr>
{% for o in d.options %}
<tr><td class="c">{{ "■" if o.name == sel else "□" }}</td>
    <td>{% if o.name == sel %}{{ f(selected_path, label="디폴트옵션상품") }}{% else %}{{ o.name }}{% endif %}</td>
    <td class="c">{{ o.risk }}</td><td class="c">{{ o.mix }}</td></tr>
{% endfor %}
</table>
{%- endmacro %}

{# 자필기재 칸 #}
{% macro handwritten(label="가입자 자필기재") -%}
<div class="hand-box"><span class="small">[ {{ label }} : </span>
<span class="hand">{{ f("handwritten", label="자필기재") }}</span><span class="small"> ]</span></div>
{%- endmacro %}
