{% extends "_base.html.j2" %}
{% import "_macros.html.j2" as m with context %}
{% import "bank_form/_loan_parts.html.j2" as lp with context %}
{% import "retirement/_parts.html.j2" as rp with context %}
{% block content %}
{{ rp.css() }}
{{ f.set_corr_name(val("signature")) }}
{{ lp.head(kind="default_opt") }}
{{ lp.cont_head("default_opt") }}
{{ rp.warn() }}
{{ lp.title_row("퇴직연금 사전지정운용방법 지정 신청서", sub="디폴트옵션") }}
<div style="margin:0 0 4px">{{ lp.legal_name() }} <b>{{ f("branch", label="취급점") }}</b> 앞
&nbsp;&nbsp;제도구분 : {{ m.choice("plan_kind", ["DC", "개인형IRP", "기업형IRP"], label="제도구분") }}{{ lp.nochk("plan_kind") }}
&nbsp;&nbsp;신청구분 : {{ m.choice("kind", ["신규 지정", "변경 지정"], label="신청구분") }}</div>

{{ rp.sec(1, "가입자") }}
{{ rp.participant() }}
<table class="bf">
<colgroup><col style="width:120px"><col><col style="width:120px"><col></colgroup>
<tr><th>계좌번호</th><td>{{ f("account", label="계좌번호", fix=0.06) }}</td><th>사 업 장 명</th><td>{{ f("employer.name", label="사업장명", fix=0.03) }}</td></tr>
</table>

{{ rp.sec(2, "사전지정운용방법 상품 지정") }}
<div class="tiny muted">사전지정운용제도(디폴트옵션)란 DC·IRP 가입자가 적립금을 별도의 개별 상품으로 운용하지 않을 경우, 사전에 지정한 운용방법으로 적립금을 운용하는 제도입니다. 아래 상품 중 <b>1개만</b> 선정할 수 있습니다.</div>
{{ rp.default_options("selected.name") }}
<table class="bf compact">
<colgroup><col style="width:150px"><col style="width:26%"><col></colgroup>
<tr><th>선택 상품 위험도</th><td class="c">{{ f("selected.risk", label="선택상품위험도") }}</td><td class="c">{{ f("selected.mix", label="선택상품구성") }}</td></tr>
</table>

{{ rp.sec(3, "투자권유 희망 여부") }}
<table class="bf">
<colgroup><col style="width:150px"><col></colgroup>
<tr><th>투자권유</th><td>{{ m.choice("advice", ["투자권유를 희망함", "투자권유를 희망하지 않음"], label="투자권유희망여부") }}{{ lp.nochk("advice") }}</td></tr>
</table>
<div class="notice">
<p>■ 가입자가 사전지정운용방법을 지정하는 경우 투자권유 희망 의사를 확인합니다.</p>
<p>■ 투자권유를 희망하지 않는 경우 금융회사는 적합성 원칙 준수 의무를 부담하지 않으며, 지정 가능한 포트폴리오는 위험도 "초저위험"만 가능합니다.</p>
<p>■ 적립금이 입금된 후 2주간 운용지시가 없으면 통지 후 위 사전지정운용방법으로 운용되며, 이후 추가 적립금은 별도 통지 없이 같은 방법으로 운용됩니다.</p>
</div>
{{ rp.handwritten() }}

<div class="center" style="margin-top:6px">{{ f("date", label="작성일") }}</div>
<div class="sig">가입자&nbsp;<span class="who">{{ f("signature", label="가입자") }}</span>{{ m.sigspot("participant", val("signature"), label="가입자", anchor="signature") }}</div>

{{ lp.bank_use(["접수일자", "본인확인", "판매직원", "담당", "책임자"]) }}
{% endblock %}
