{% extends "_base.html.j2" %}
{% import "_macros.html.j2" as m with context %}
{% block style %}
table.ph td { font-size: calc(var(--fs) - 0.5px); }
{% endblock %}
{% block content %}
{{ m.doc_no("issue_no", "발급번호") }}
{{ m.title("가입자 가입증명", sub="(국민연금 가입내역 확인서)") }}
<h2 class="sec">가입자</h2>
{{ m.kv([["성　　명", "person.name"], ["주민등록번호", "person.rrn"], ["주　　소", "person.address", True],
         ["가입종별", "current_kind"], ["현 사업장", "current_workplace"], ["총 가입기간", "total_months"], ["용　　도", "purpose"]],
         cols=2, label_w="110px") }}
<h2 class="sec">가입이력</h2>
<table class="ph">
  <colgroup><col style="width:6%"><col style="width:30%"><col style="width:15%"><col style="width:15%"><col style="width:16%"><col></colgroup>
  <tr><th>번호</th><th>사업장명칭</th><th>취득일</th><th>상실일</th><th>가입종별</th><th>기준소득월액(원)</th></tr>
  {% for r in d.rows %}{% set i = loop.index0 %}
  <tr>
    <td class="c">{{ loop.index }}</td>
    <td class="c">{% if r.workplace is defined %}{{ f("rows." ~ i ~ ".workplace", label="사업장명칭") }}{% else %}-{% endif %}</td>
    <td class="c">{{ f("rows." ~ i ~ ".start", label="취득일") }}</td>
    <td class="c">{% if r.end is defined %}{{ f("rows." ~ i ~ ".end", label="상실일") }}{% endif %}</td>
    <td class="c">{{ f("rows." ~ i ~ ".kind", label="가입종별") }}</td>
    <td class="num">{{ f("rows." ~ i ~ ".wage", label="기준소득월액") }}</td>
  </tr>
  {% endfor %}
  {% for _ in range(6 - d.rows|length) %}<tr><td>&nbsp;</td><td></td><td></td><td></td><td></td><td></td></tr>{% endfor %}
</table>
<ul class="note">
  <li>상실일은 자격을 상실한 날(퇴사일의 다음날)이며, 상실일이 없는 경우 현재 가입 중임을 의미합니다.</li>
  <li>기준소득월액은 해당 사업장(지역) 가입 기간 중 최종 기준소득월액입니다.</li>
  <li>이 증명서는 국민연금공단 홈페이지(www.nps.or.kr) 또는 전자민원서비스에서 발급번호로 진위 여부를 확인할 수 있습니다.</li>
</ul>
<p class="center mt-l" style="font-size:calc(var(--fs) + 2px)">위와 같이 국민연금 가입 사실을 증명합니다.</p>
<div class="issuer">
  <div class="date">{{ f("issue_date", label="발급일") }}</div>
  <div class="org">{{ f("issuer", label="발급기관") }}{{ m.seal(val("issuer").split()[-1] ~ "인", square=True, over=True) }}</div>
</div>
{% endblock %}
