{% extends "_base.html.j2" %}
{% import "_macros.html.j2" as m with context %}
{% block style %}
table.ph td { font-size: calc(var(--fs) - 0.5px); }
h3.sec { margin: 16px 0 4px; }
.form-no { font-size: 10px; color: #333; margin-bottom: 8px; }
{% endblock %}
{% block content %}
<div class="form-no">■ 국민연금법 시행규칙 [별지 제11호서식]</div>
{{ m.title("국민연금가입자증명서") }}
<h3 class="sec">□ 가입자의 인적사항</h3>
<table class="kv">
  <colgroup><col style="width:120px"><col><col style="width:120px"><col></colgroup>
  <tr><th>발급번호</th><td>{{ f("issue_no", label="발급번호") }}</td><th>발급일자</th><td>{{ f("issue_date_head", label="발급일자") }}</td></tr>
  <tr><th>성　　명</th><td>{{ f("person.name", label="성명") }}</td><th>주민등록번호</th><td>{{ f("person.rrn", label="주민등록번호") }}</td></tr>
</table>
<h3 class="sec">□ 가입자의 종류 및 자격 취득일</h3>
<table class="kv">
  <colgroup><col style="width:160px"><col><col style="width:120px"><col></colgroup>
  <tr><th>최초 자격취득일</th><td>{{ f("first_acquired", label="최초자격취득일") }}</td><th>가입기간 합계</th><td>{{ f("total_months", label="가입기간합계") }}</td></tr>
</table>
<table class="ph">
  <colgroup><col style="width:6%"><col style="width:16%"><col style="width:30%"><col style="width:15%"><col style="width:15%"><col></colgroup>
  <tr><th>순번</th><th>가입자 종류</th><th>사업장 명칭</th><th>자격취득일</th><th>자격상실일</th><th>기준소득월액(원)</th></tr>
  {% for r in d.rows %}{% set i = loop.index0 %}
  <tr>
    <td class="c">{{ loop.index }}</td>
    <td class="c">{{ f("rows." ~ i ~ ".kind", label="가입자종류") }}</td>
    <td class="c">{% if r.workplace is defined %}{{ f("rows." ~ i ~ ".workplace", label="사업장명칭") }}{% else %}-{% endif %}</td>
    <td class="c">{{ f("rows." ~ i ~ ".start", label="자격취득일") }}</td>
    <td class="c">{% if r.end is defined %}{{ f("rows." ~ i ~ ".end", label="자격상실일") }}{% else %}-{% endif %}</td>
    <td class="num">{{ f("rows." ~ i ~ ".wage", label="기준소득월액") }}</td>
  </tr>
  {% endfor %}
  {% for _ in range(6 - d.rows|length) %}<tr><td>&nbsp;</td><td></td><td></td><td></td><td></td><td></td></tr>{% endfor %}
</table>
<table class="kv">
  <colgroup><col style="width:120px"><col></colgroup>
  <tr><th>용　　도</th><td>{{ f("purpose", label="용도") }}</td></tr>
</table>
<ul class="note">
  <li>자격상실일은 자격을 상실한 날(퇴사일의 다음 날)이며, 자격상실일이 없는 경우 현재 가입 중임을 의미합니다.</li>
  <li>이 증명서는 국민연금공단 홈페이지(www.nps.or.kr)에서 발급번호로 진위 여부를 확인할 수 있습니다.</li>
</ul>
<p class="center mt-l" style="font-size:calc(var(--fs) + 2px)">위의 사실을 증명합니다.</p>
<div class="issuer">
  <div class="date">{{ f("issue_date", label="발급일") }}</div>
  <div class="org">국민연금공단 이사장{{ m.seal("국민연금공단이사장", square=True, over=True) }}</div>
</div>
{% endblock %}
