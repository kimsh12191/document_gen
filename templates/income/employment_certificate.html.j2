{% extends "_base.html.j2" %}
{% import "_macros.html.j2" as m with context %}
{% block style %}
table.cert { margin-top: 10px; }
table.cert th, table.cert td { padding: 11px 10px; }
table.cert th.vsec { width: 46px; letter-spacing: .1em; line-height: 1.25; white-space: normal; }
.cert-text { font-size: calc(var(--fs) + 3px); letter-spacing: .05em; margin-top: 56px; }
.ceo { position: relative; display: inline-block; padding-right: 34px; font-size: calc(var(--fs) + 6px); font-weight: 700; letter-spacing: .12em; }
{% endblock %}
{% block content %}
{{ m.doc_no("doc_no", "문서번호") }}
{{ m.title("재 직 증 명 서") }}
<table class="cert outer">
  <colgroup><col style="width:46px"><col style="width:112px"><col><col style="width:118px"><col style="width:26%"></colgroup>
  <tr>
    <th rowspan="2" class="vsec">인<br>적<br>사<br>항</th>
    <th>성　　명</th><td>{{ f("employee.name", label="성명") }}</td>
    {% if d.employee.birth is defined %}<th>생 년 월 일</th><td>{{ f("employee.birth", label="생년월일") }}</td>
    {% else %}<th>주민등록번호</th><td>{{ f("employee.rrn", label="주민등록번호") }}</td>{% endif %}
  </tr>
  <tr><th>주　　소</th><td colspan="3">{{ f("employee.address", label="주소") }}</td></tr>
  <tr>
    <th rowspan="5" class="vsec">재<br>직<br>사<br>항</th>
    <th>회 사 명</th><td>{{ f("company.name", label="회사명") }}</td>
    <th>사업자등록번호</th><td>{{ f("company.biz_no", label="사업자등록번호") }}</td>
  </tr>
  <tr><th>소 재 지</th><td colspan="3">{{ f("company.address", label="소재지") }}</td></tr>
  <tr><th>소　　속</th><td>{{ f("employment.department", label="소속") }}</td>
      <th>직　　위</th><td>{{ f("employment.position", label="직위") }}</td></tr>
  <tr><th>재직기간</th><td colspan="3">{{ f("employment.period", label="재직기간") }}</td></tr>
  <tr><th>담당업무</th><td colspan="3">{{ f("employment.duty", label="담당업무") }}</td></tr>
  <tr>
    <th rowspan="1" class="vsec">발급</th>
    <th>용　　도</th><td>{{ f("purpose", label="용도") }}</td>
    <th>제 출 처</th><td>{{ f("submit_to", label="제출처") }}</td>
  </tr>
</table>
<p class="center cert-text">위 사람은 당사에 재직하고 있음을 증명합니다.</p>
<div class="issuer" style="margin-top:44px">
  <div class="date">{{ f("issue_date", label="발급일") }}</div>
  <div class="mt" style="font-size:calc(var(--fs) + 4px);letter-spacing:.08em">{{ f("company.name", label="회사명") }}</div>
  <div class="small muted" style="margin-top:4px">TEL {{ f("company.phone", label="전화번호") }}</div>
  <div class="ceo mt">대표이사&nbsp;&nbsp;{{ f("company.ceo", label="대표이사") }}{{ m.seal("대표이사인", square=True, over=True, key="company", kind="직인") }}</div>
</div>
{% endblock %}
