{% extends "_base.html.j2" %}
{% import "_macros.html.j2" as m with context %}
{% block content %}
{{ m.doc_no("doc_no", "문서번호") }}
{{ m.title("재 직 증 명 서") }}
<h2 class="sec">인적사항</h2>
{{ m.kv([["성　명", "employee.name"], ["주민등록번호", "employee.rrn"], ["주　소", "employee.address"]], label_w="130px") }}
<h2 class="sec">재직사항</h2>
{{ m.kv([["소　속", "employment.department"], ["직　위", "employment.position"],
         ["직　종", "employment.job"], ["재직기간", "employment.period"]], cols=2, label_w="110px") }}
<h2 class="sec">회사정보</h2>
{{ m.kv([["회사명", "company.name"], ["사업자등록번호", "company.biz_no"],
         ["소재지", "company.address", True], ["대표전화", "company.phone"], ["용　도", "purpose"]], cols=2, label_w="120px") }}
<p class="center mt-l" style="font-size:calc(var(--fs) + 2px)">위 사람은 당사에 재직하고 있음을 증명합니다.</p>
<div class="issuer">
  <div class="date">{{ f("issue_date", label="발급일") }}</div>
  <div class="org">{{ f("company.name", label="회사명") }}</div>
  <div class="mt" style="position:relative;display:inline-block;padding-right:30px">대표이사&nbsp;&nbsp;{{ f("company.ceo", label="대표자") }}{{ m.seal("대표이사인", square=True, over=True) }}</div>
</div>
{% endblock %}
