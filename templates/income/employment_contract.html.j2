{% extends "_base.html.j2" %}
{% import "_macros.html.j2" as m with context %}
{% block style %}
h1.title { margin-bottom: 12px; }
.page.a4 { line-height: 1.4; }
ol.ec { padding-left: 0; list-style: none; margin: 8px 0; }
ol.ec > li { margin: 4px 0; }
ol.ec .sub { padding-left: 1.3em; margin: 2px 0; }
.intro { line-height: 1.8; }
.signs { display: flex; gap: 24px; margin-top: 14px; }
.signs > div { flex: 1; border-top: 1px solid var(--border); padding-top: 6px; }
.signs table.plain td { padding: 2px 3px; }
.signs .who { font-weight: 700; margin-bottom: 4px; }
{% endblock %}
{% block content %}
{{ m.title("표준근로계약서", sub="(기간의 정함이 없는 경우)") }}
<p class="intro">
  <span class="u">{{ f("employer.name", label="사업주") }}</span> (이하 "사업주"라 함)과(와)
  <span class="u">{{ f("employee.name", label="근로자") }}</span> (이하 "근로자"라 함)은 다음과 같이 근로계약을 체결한다.
</p>
<ol class="ec">
  <li><b>1. 근로개시일 :</b> {{ f("start_date", label="근로개시일") }}부터</li>
  <li><b>2. 근 무 장 소 :</b> {{ f("workplace", label="근무장소") }}</li>
  <li><b>3. 업무의 내용 :</b> {{ f("job", label="업무의내용") }}</li>
  <li><b>4. 소정근로시간 :</b> {{ f("work_hours", label="소정근로시간") }} (휴게시간 : {{ f("break_time", label="휴게시간") }})</li>
  <li><b>5. 근무일/휴일 :</b> {{ f("work_days", label="근무일") }}, 주휴일 {{ f("holiday", label="주휴일") }}</li>
  <li><b>6. 임 금</b>
    <div class="sub">- 연봉 : {{ f("annual_salary", label="연봉") }} (월 {{ f("monthly_salary", label="월급") }})</div>
    <div class="sub">- 상여금 : {{ m.choice("bonus", ["있음", "없음"], label="상여금") }}</div>
    <div class="sub">- 기타급여(제수당 등) : {{ f("allowances", label="기타급여") }}</div>
    <div class="sub">- 임금지급일 : {{ f("pay_day", label="임금지급일") }} (휴일의 경우는 전일 지급)</div>
    <div class="sub">- 지급방법 : {{ m.choice("pay_method", ["근로자에게 직접지급", "근로자 명의 예금통장에 입금"], label="지급방법") }}</div>
  </li>
  <li><b>7. 연차유급휴가</b>
    <div class="sub">- 연차유급휴가는 근로기준법에서 정하는 바에 따라 부여함</div></li>
  <li><b>8. 사회보험 적용여부(해당란에 체크)</b>
    <div class="sub"><span class="chk">■ 고용보험</span><span class="chk">■ 산재보험</span><span class="chk">■ 국민연금</span><span class="chk">■ 건강보험</span></div></li>
  <li><b>9. 근로계약서 교부</b>
    <div class="sub">- 사업주는 근로계약을 체결함과 동시에 본 계약서를 사본하여 근로자의 교부요구와 관계없이 근로자에게 교부함(근로기준법 제17조 이행)</div></li>
  <li><b>10. 근로계약, 취업규칙 등의 성실한 이행의무</b>
    <div class="sub">- 사업주와 근로자는 각자가 근로계약, 취업규칙, 단체협약을 지키고 성실하게 이행하여야 함</div></li>
  <li><b>11. 기 타</b>
    <div class="sub">- 이 계약에 정함이 없는 사항은 근로기준법령에 의함</div></li>
</ol>
<p class="center mt" style="letter-spacing:.1em">{{ f("contract_date", label="계약일") }}</p>
<div class="signs">
  <div>
    <div class="who">(사업주)</div>
    <table class="plain">
      <tr><td>사업체명 :</td><td>{{ f("employer.name", label="사업체명") }}</td></tr>
      <tr><td>전　　화 :</td><td>{{ f("employer.phone", label="전화") }}</td></tr>
      <tr><td>주　　소 :</td><td>{{ f("employer.address", label="주소") }}</td></tr>
      <tr><td>대 표 자 :</td><td style="position:relative">{{ f("employer.ceo", label="대표자") }}&nbsp;&nbsp;(서명) {{ m.seal("대표이사인", square=True, size="sm") }}</td></tr>
    </table>
  </div>
  <div>
    <div class="who">(근로자)</div>
    <table class="plain">
      <tr><td>주　　소 :</td><td>{{ f("employee.address", label="주소") }}</td></tr>
      <tr><td>연 락 처 :</td><td>{{ f("employee.phone", label="연락처") }}</td></tr>
      <tr><td>주민번호 :</td><td>{{ f("employee.rrn", label="주민등록번호") }}</td></tr>
      <tr><td>성　　명 :</td><td>{{ f("employee.name", label="성명") }}&nbsp;&nbsp;(서명) {{ m.seal(val("employee.name"), size="sm") }}</td></tr>
    </table>
  </div>
</div>
{% endblock %}
