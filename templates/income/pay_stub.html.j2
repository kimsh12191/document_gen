{% extends "_base.html.j2" %}
{% import "_macros.html.j2" as m with context %}
{% block style %}
h1.title { margin: 4px 0 2px; letter-spacing: .3em; }
.ps-sub { text-align: center; margin-bottom: 10px; }
.ps-top { display: flex; justify-content: space-between; align-items: flex-end; margin-bottom: 4px; }
table.ps td.num { min-width: 96px; }
table.ps th.grp { white-space: nowrap; line-height: 1.3; font-weight: 600; font-size: calc(var(--fs) - 1.5px); padding: 2px; }
table.ps tr.sum th, table.ps tr.sum td { font-weight: 700; }
table.ps tr.net td, table.ps tr.net th { font-weight: 700; font-size: calc(var(--fs) + 2px); }
h3.sec { margin: 10px 0 2px; }
table.wk th { font-size: calc(var(--fs) - 1.5px); white-space: normal; line-height: 1.25; }
{% endblock %}
{% block content %}
<h1 class="title">{{ f("doc_title", label="서식명") }}</h1>
<div class="ps-sub">({{ f("title_month", label="귀속연월") }})</div>
<div class="ps-top"><span class="bold">{{ f("company", label="회사명") }}</span><span>지급일 : {{ f("pay_date", label="지급일") }}</span></div>
<table class="kv">
  <colgroup><col style="width:80px"><col><col style="width:80px"><col><col style="width:80px"><col></colgroup>
  <tr><th>성　명</th><td>{{ f("employee.name", label="성명") }}</td><th>생년월일</th><td>{{ f("employee.birth", label="생년월일") }}</td><th>사　번</th><td>{{ f("employee.employee_no", label="사번") }}</td></tr>
  <tr><th>부　서</th><td colspan="3">{{ f("employee.department", label="부서") }}</td><th>직　급</th><td>{{ f("employee.position", label="직급") }}</td></tr>
</table>
<h3 class="sec">세부 내역</h3>
{% set pm_ = d.payments %}{% set pi_ = d.payments_irregular if d.payments_irregular is defined else [] %}
{% set nd = d.deductions|length %}
{% set rm = [pm_|length, 6]|max %}{% set ri = [pi_|length, 2]|max %}
{% if rm + ri < nd %}{% set rm = nd - ri %}{% endif %}
<table class="ps">
  <colgroup><col style="width:84px"><col style="width:20%"><col style="width:19%"><col style="width:22%"><col></colgroup>
  <tr><th colspan="3">지　　급</th><th colspan="2">공　　제</th></tr>
  <tr><th colspan="2">임금 항목</th><th>지급 금액(원)</th><th>공제 항목</th><th>공제 금액(원)</th></tr>
  {% for r in range(rm + ri) %}
  <tr>
    {% if r == 0 %}<th rowspan="{{ rm }}" class="grp">매월<br>지급</th>{% elif r == rm %}<th rowspan="{{ ri }}" class="grp">격월 또는<br>부정기 지급</th>{% endif %}
    {% if r < rm %}{% set k = r %}{% set lst = pm_ %}{% set path = "payments" %}{% else %}{% set k = r - rm %}{% set lst = pi_ %}{% set path = "payments_irregular" %}{% endif %}
    {% if k < lst|length %}<td class="c">{{ f(path ~ "." ~ k ~ ".name", label="임금항목") }}</td><td class="num">{{ f(path ~ "." ~ k ~ ".amount", label="지급금액") }}</td>
    {% else %}<td>&nbsp;</td><td></td>{% endif %}
    {% if r < nd %}<td class="c">{{ f("deductions." ~ r ~ ".name", label="공제항목") }}</td><td class="num">{{ f("deductions." ~ r ~ ".amount", label="공제금액") }}</td>
    {% else %}<td></td><td></td>{% endif %}
  </tr>
  {% endfor %}
  <tr class="sum"><th colspan="2">지급액 계</th><td class="num">{{ f("pay_total", label="지급액계") }}</td><th>공제액 계</th><td class="num">{{ f("deduction_total", label="공제액계") }}</td></tr>
  <tr class="net"><td colspan="3" style="border-left:0;border-bottom:0"></td><th>실수령액(원)</th><td class="num">{{ f("net_pay", label="실수령액") }}</td></tr>
</table>
<table class="wk compact c">
  <tr><th>근로일수</th><th>총 근로시간수</th><th>연장근로시간수</th><th>야간근로시간수</th><th>휴일근로시간수</th><th>통상시급(원)</th><th>가족수</th></tr>
  <tr>
    <td class="c">{{ f("work.days", label="근로일수") }}</td><td class="c">{{ f("work.hours", label="총근로시간수") }}</td>
    <td class="c">{{ f("work.overtime_hours", label="연장근로시간수") }}</td><td class="c">{{ f("work.night_hours", label="야간근로시간수") }}</td>
    <td class="c">{{ f("work.holiday_hours", label="휴일근로시간수") }}</td><td class="c">{{ f("work.hourly_wage", label="통상시급(원)") }}</td>
    <td class="c">{{ f("work.family", label="가족수") }}</td>
  </tr>
</table>
<h3 class="sec">계산 방법</h3>
<table class="compact">
  <colgroup><col style="width:22%"><col><col style="width:20%"></colgroup>
  <tr><th>구분</th><th>산출식 또는 산출방법</th><th>금액(원)</th></tr>
  {% for c in d.calc_methods %}{% set i = loop.index0 %}
  <tr><td class="c">{{ f("calc_methods." ~ i ~ ".item", label="구분") }}</td><td>{{ f("calc_methods." ~ i ~ ".method", label="산출식또는산출방법") }}</td><td class="num">{{ f("calc_methods." ~ i ~ ".amount", label="금액(원)") }}</td></tr>
  {% endfor %}
</table>
<p class="note">※ 「근로기준법」 제48조제2항에 따라 임금의 구성항목·계산방법 및 공제내역을 적은 임금명세서를 교부합니다.<br>※ 식대 및 자가운전보조금은 월 20만원 이내 비과세 항목입니다.</p>
{% endblock %}
