{% extends "_base.html.j2" %}
{% import "_macros.html.j2" as m with context %}
{% block style %}
.keep { display: flex; flex-direction: column; } /* 맺음말·발급기관·직인은 한 덩어리 (쪽 나눔에서 쪼개지 않음) */
{% endblock %}
{% block content %}
{{ m.doc_no("issue_no", "발급번호") }}
{{ m.title("건강보험 자격득실 확인서") }}
{{ m.kv([["성　　명", "person.name"], ["주민등록번호", "person.rrn"]], cols=2, label_w="110px") }}
<table class="hq mt">
  <colgroup><col style="width:7%"><col style="width:19%"><col style="width:34%"><col style="width:20%"><col></colgroup>
  <tr><th>번호</th><th>가입자구분</th><th>사업장 명칭</th><th>자격취득일</th><th>자격상실일</th></tr>
  {% for r in d.rows %}{% set i = loop.index0 %}
  <tr>
    <td class="c">{{ loop.index }}</td>
    <td class="c">{{ f("rows." ~ i ~ ".kind", label="가입자구분") }}</td>
    <td class="c">{% if r.workplace is defined %}{{ f("rows." ~ i ~ ".workplace", label="사업장명칭") }}{% endif %}</td>
    <td class="c">{{ f("rows." ~ i ~ ".start", label="자격취득일") }}</td>
    <td class="c">{% if r.end is defined %}{{ f("rows." ~ i ~ ".end", label="자격상실일") }}{% endif %}</td>
  </tr>
  {% endfor %}
  {% for _ in range(7 - d.rows|length) %}<tr><td>&nbsp;</td><td></td><td></td><td></td><td></td></tr>{% endfor %}
</table>
{% if d.rows|length > 7 %}<p class="center small" style="margin:2px 0 6px">- 이하 여백 -</p>{% endif %}
<table>
  <colgroup><col style="width:110px"><col></colgroup>
  <tr><th>용　　도</th><td>{{ f("purpose", label="용도") }}</td></tr>
</table>
<ul class="note">
  <li>가입자구분은 직장가입자, 지역가입자(세대주·세대원), 피부양자로 구분하며, 자격상실일이 없는 경우 현재 자격을 유지하고 있음을 의미합니다.</li>
  <li>자격상실일은 퇴직일(또는 사유 발생일)의 다음날입니다.</li>
  <li>본 확인서는 국민건강보험공단 홈페이지(www.nhis.or.kr)에서 발급번호로 진위 여부를 확인할 수 있습니다.</li>
</ul>
<div class="keep">
<p class="center mt-l" style="font-size:calc(var(--fs) + 2px)">「국민건강보험법」 제11조에 따라 위와 같이 건강보험 자격의 취득·상실 사실을 확인합니다.</p>
<div class="issuer">
  <div class="date">{{ f("issue_date", label="발급일") }}</div>
  <div class="org">국민건강보험공단 이사장{{ m.seal("국민건강보험공단이사장인", square=True, size="lg", over=True) }}</div>
</div>
</div>
{% endblock %}
