{% extends "_base.html.j2" %}
{% import "_macros.html.j2" as m with context %}
{% block page_class %} dense{% endblock %}
{% block style %}
.page.a4.dense { font-size: calc(var(--fs) - 2.5px); line-height: 1.25; }
table.wr { margin: 0; border: 2px solid var(--border); }
table.wr + table.wr { border-top: 0; }
table.wr th, table.wr td { padding: 1.5px 4px; }
table.wr th { font-weight: 500; text-align: left; }
table.wr th.c { text-align: center; }
table.wr th.v { width: 24px; white-space: normal; line-height: 1.15; font-weight: 700; text-align: center; }
table.wr td.opt { font-size: calc(var(--fs) - 4px); white-space: nowrap; }
.wr-title { font-size: calc(var(--title) - 9px); font-weight: 700; letter-spacing: .03em; line-height: 1.4; text-align: left; display: inline-block; }
.form-no { font-size: 10px; color: #333; margin-bottom: 2px; display: flex; justify-content: space-between; }
.foot { margin-top: 0; line-height: 1.35; border: 2px solid var(--border); border-top: 0; padding: 4px 10px; }
.foot p { margin: 3px 0; }
{% endblock %}
{% block content %}
{% set iy = d.issue_date[:4] %}
{% set rev = {"2023": "2021. 3. 16.", "2024": "2023. 3. 20.", "2025": "2024. 3. 22."}.get(iy, "2025. 6. 30.") %}
<div class="form-no"><span>■ 소득세법 시행규칙 [별지 제24호서식(1)] &lt;개정 {{ rev }}&gt;</span><span>({{ "9" if iy >= "2026" else "8" }}쪽 중 제1쪽)</span></div>
<table class="wr">
  <colgroup><col style="width:7%"><col style="width:45%"><col style="width:26%"><col></colgroup>
  <tr>
    <td rowspan="9" class="c tiny">관리<br>번호</td>
    <td rowspan="9" class="c">
      <div class="wr-title">[✔]근로소득 원천징수영수증<br>[&nbsp;&nbsp;]근로소득 지급명세서</div>
      <div class="small" style="margin-top:6px">({{ m.choice("copy_type", ["소득자 보관용", "발행자 보관용", "발행자 보고용"], label="보관용구분", on="[✔]", off="[ ]") }})</div>
      <div class="small" style="margin-top:6px">귀속연도 : {{ f("year", label="귀속연도") }}년</div>
    </td>
    <th>거주구분</th><td class="opt">{{ m.choice("resident", ["거주자1", "비거주자2"], label="거주구분", on="[✔]", off="[ ]") }}</td>
  </tr>
  <tr><th>거주지국</th><td class="opt">대한민국 &nbsp; 거주지국코드 KR</td></tr>
  <tr><th>내·외국인</th><td class="opt">{{ m.choice("nationality", ["내국인1", "외국인9"], label="내·외국인", on="[✔]", off="[ ]") }}</td></tr>
  <tr><th>외국인단일세율적용</th><td class="opt">[ ]여 1 &nbsp;[✔]부 2</td></tr>
  <tr><th>외국법인소속 파견근로자 여부</th><td class="opt">[ ]여 1 &nbsp;[✔]부 2</td></tr>
  <tr><th>종교관련종사자 여부</th><td class="opt">[ ]여 1 &nbsp;[✔]부 2</td></tr>
  <tr><th>국적</th><td class="opt">대한민국 &nbsp; 국적코드 KR</td></tr>
  <tr><th>세대주 여부</th><td class="opt">{{ m.choice("household_head", ["세대주1", "세대원2"], label="세대주여부", on="[✔]", off="[ ]") }}</td></tr>
  <tr><th>연말정산 구분</th><td class="opt">{{ m.choice("settlement_type", ["계속근로1", "중도퇴사2"], label="연말정산구분", on="[✔]", off="[ ]") }}</td></tr>
</table>
<table class="wr">
  <colgroup><col style="width:24px"><col style="width:19%"><col style="width:27%"><col style="width:19%"><col></colgroup>
  <tr><th rowspan="4" class="v">징<br>수<br>의<br>무<br>자</th>
    <th>① 법인명(상　호)</th><td>{{ f("payer.name", label="법인명(상호)") }}</td><th>② 대 표 자(성 명)</th><td>{{ f("payer.ceo", label="대표자(성명)") }}</td></tr>
  <tr><th>③ 사업자등록번호</th><td>{{ f("payer.biz_no", label="사업자등록번호") }}</td><th>④ 주 민 등 록 번 호</th><td></td></tr>
  <tr><th>③-1 사업자단위과세자 여부</th><td class="opt">[ ]여 1 &nbsp;[✔]부 2</td><th>③-2 종사업장 일련번호</th><td></td></tr>
  <tr><th>⑤ 소 재 지(주소)</th><td colspan="3">{{ f("payer.address", label="소재지(주소)") }}</td></tr>
  <tr><th rowspan="2" class="v">소<br>득<br>자</th>
    <th>⑥ 성　　명</th><td>{{ f("earner.name", label="성명") }}</td><th>⑦ 주 민 등 록 번 호<br><span class="tiny">(외국인등록번호)</span></th><td>{{ f("earner.rrn", label="주민등록번호") }}</td></tr>
  <tr><th>⑧ 주　　소</th><td colspan="3">{{ f("earner.address", label="주소") }}</td></tr>
</table>
<table class="wr">
  <colgroup><col style="width:24px"><col style="width:27%"><col style="width:19%"><col style="width:11%"><col style="width:11%"><col style="width:11%"><col></colgroup>
  <tr><th rowspan="13" class="v">Ⅰ<br><br>근<br>무<br>처<br>별<br>소<br>득<br>명<br>세</th>
    <th class="c">구　　분</th><th class="c">주(현)</th><th class="c">종(전)</th><th class="c">종(전)</th><th class="c">⑯-1 납세조합</th><th class="c">합　계</th></tr>
  <tr><th>⑨ 근 무 처 명</th><td class="c">{{ f("work.company", label="근무처명") }}</td><td></td><td></td><td></td><td></td></tr>
  <tr><th>⑩ 사업자등록번호</th><td class="c">{{ f("work.biz_no", label="사업자등록번호") }}</td><td></td><td></td><td></td><td></td></tr>
  <tr><th>⑪ 근 무 기 간</th><td class="c tiny">{{ f("work.period", label="근무기간") }}</td><td class="c">~</td><td class="c">~</td><td class="c">~</td><td></td></tr>
  <tr><th>⑫ 감 면 기 간</th><td class="c">~</td><td class="c">~</td><td class="c">~</td><td class="c">~</td><td></td></tr>
  <tr><th>⑬ 급　　여</th><td class="num">{{ f("work.salary", label="급여") }}</td><td></td><td></td><td></td><td class="num">{{ val("work.salary") }}</td></tr>
  <tr><th>⑭ 상　　여</th><td class="num">{{ f("work.bonus", label="상여") }}</td><td></td><td></td><td></td><td class="num">{{ val("work.bonus") }}</td></tr>
  <tr><th>⑮ 인 정 상 여</th><td></td><td></td><td></td><td></td><td></td></tr>
  <tr><th>⑮-1 주식매수선택권 행사이익</th><td></td><td></td><td></td><td></td><td></td></tr>
  <tr><th>⑮-2 우리사주조합인출금</th><td></td><td></td><td></td><td></td><td></td></tr>
  <tr><th>⑮-3 임원 퇴직소득금액 한도초과액</th><td></td><td></td><td></td><td></td><td></td></tr>
  <tr><th>⑮-4 직무발명보상금</th><td></td><td></td><td></td><td></td><td></td></tr>
  <tr><th>⑯ 계</th><td class="num bold">{{ f("work.total", label="계") }}</td><td></td><td></td><td></td><td class="num bold">{{ val("work.total") }}</td></tr>
  <tr><th rowspan="8" class="v">Ⅱ<br><br>비<br>과<br>세<br>및<br>감<br>면<br>소<br>득<br>명<br>세</th>
    <th>⑱ 국외근로　　　　M0X</th><td></td><td></td><td></td><td></td><td></td></tr>
  <tr><th>⑱-1 야간근로수당　O0X</th><td></td><td></td><td></td><td></td><td></td></tr>
  <tr><th>⑱-2 출산·보육수당　Q0X</th><td></td><td></td><td></td><td></td><td></td></tr>
  <tr><th>⑱-4 연구보조비　　H0X</th><td></td><td></td><td></td><td></td><td></td></tr>
  <tr><th>식사대 등　　　　P01</th><td class="num">{{ f("nontax.meal", label="식사대") }}</td><td></td><td></td><td></td><td class="num">{{ val("nontax.meal") }}</td></tr>
  <tr><th>⑲ 수련보조수당　　Y22</th><td></td><td></td><td></td><td></td><td></td></tr>
  <tr><th>⑳ 비과세소득 계</th><td class="num">{{ f("nontax.total", label="비과세소득계") }}</td><td></td><td></td><td></td><td class="num">{{ val("nontax.total") }}</td></tr>
  <tr><th>⑳-1 감면소득 계</th><td></td><td></td><td></td><td></td><td></td></tr>
</table>
<table class="wr">
  <colgroup><col style="width:24px"><col style="width:13%"><col style="width:20%"><col style="width:17%"><col style="width:20%"><col style="width:13%"><col></colgroup>
  <tr><th rowspan="7" class="v">Ⅲ<br><br>세<br>액<br>명<br>세</th>
    <th colspan="3" class="c">구　　　분</th><th class="c">소 득 세</th><th class="c">지방소득세</th><th class="c">농어촌특별세</th></tr>
  <tr><th colspan="3">(72) 결　정　세　액</th><td class="num">{{ f("tax.final_income", label="결정세액") }}</td><td class="num">{{ f("tax.final_local", label="결정세액") }}</td><td class="num">0</td></tr>
  <tr><th rowspan="2" class="c">기납부<br>세　액</th><th>(73) 종(전)근무지<br><span class="tiny">(결정세액란의 세액을 적습니다)</span></th><th class="tiny">사업자<br>등록번호</th><td></td><td></td><td></td></tr>
  <tr><th colspan="2">(74) 주(현)근무지</th><td class="num">{{ f("tax.prepaid_income", label="주(현)근무지") }}</td><td class="num">{{ f("tax.prepaid_local", label="주(현)근무지") }}</td><td class="num">0</td></tr>
  <tr><th colspan="3">(75) 납부특례세액</th><td class="num">0</td><td class="num">0</td><td class="num">0</td></tr>
  <tr><th colspan="3" class="bold">(76) 차 감 징 수 세 액((72)-(73)-(74)-(75))</th><td class="num bold">{{ f("tax.diff_income", label="차감징수세액") }}</td><td class="num bold">{{ f("tax.diff_local", label="차감징수세액") }}</td><td class="num">0</td></tr>
  <tr><th colspan="3">실효세율(%) ((72)/㉑)×100</th><td class="num" colspan="3">{{ f("tax.effective_rate", label="실효세율(%)") }}%</td></tr>
</table>
<div class="foot">
  <p>위의 원천징수액(근로소득)을 정히 영수(지급)합니다.</p>
  <p class="right">{{ f("issue_date", label="발급일") }}</p>
  <p class="right" style="position:relative">징수(보고)의무자&nbsp;&nbsp;<b>{{ val("payer.name") }}</b>&nbsp;&nbsp;(서명 또는 인) {{ m.seal("대표이사인", square=True, size="sm", key="payer", kind="직인") }}</p>
  <p class="bold" style="font-size:calc(var(--fs) + 2px)">{{ f("tax_office", label="세무서장") }} 귀하</p>
</div>
{% endblock %}
